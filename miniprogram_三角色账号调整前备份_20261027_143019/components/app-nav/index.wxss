.nav{padding:24rpx 30rpx 18rpx;border-bottom:1rpx solid #e2ebe4;background:#f3f8f6}.nav-row{display:flex;align-items:center;justify-content:space-between}.brand{font-size:28rpx;font-weight:650;letter-spacing:2rpx;color:#254e40}.role{font-weight:400;font-size:22rpx;letter-spacing:0;margin-left:12rpx;color:#789183}.nav-link{font-size:23rpx;color:#32846a;padding:6rpx}.demo{font-size:21rpx;color:#9b8350;margin-top:8rpx}.nav-panel{padding-top:24rpx}.nav-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.nav-items view{padding:17rpx 10rpx;text-align:center;background:white;border-radius:12rpx;color:#416e59;font-size:24rpx}.account{padding:22rpx 0 4rpx;font-size:24rpx;color:#728c7c;text-align:right}
