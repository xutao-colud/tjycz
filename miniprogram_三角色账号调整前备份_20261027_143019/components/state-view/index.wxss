.state{padding:60rpx 25rpx;text-align:center;color:#7d9386;font-size:26rpx}.error{color:#ad624d;word-break:break-all}.error button{background:#e4f1e8;color:#39795c;font-size:25rpx;margin-top:25rpx;width:240rpx;border:0;border-radius:14rpx}.error button::after{border:0}.indicator{height:8rpx;width:70rpx;background:#8abfa8;border-radius:6rpx;margin:0 auto 22rpx;animation:pulse 1s infinite alternate}.empty-mark{font-size:45rpx;color:#a5b9ad;margin-bottom:10rpx}@keyframes pulse{from{opacity:.35}to{opacity:1}}
