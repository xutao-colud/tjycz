<view class="media"><button wx:if="{{files.length < 6}}" disabled="{{disabled || busy}}" loading="{{busy}}" bindtap="choose">{{busy ? '正在上传' : '拍照 / 相册 / 视频上传'}}</button><button wx:if="{{audioEnabled && !recording && files.length < 6}}" class="audio" bindtap="record" disabled="{{disabled || busy}}">录制口头作业（MP3，最多60秒）</button><button wx:if="{{recording}}" class="stop" bindtap="stopRecord">录音中 {{seconds}} / 60 秒 · 停止并上传</button><button wx:if="{{recordDenied}}" bindtap="settings">前往设置开启麦克风</button><view class="hint">单个文件 ≤20MB，最多 6 个；上传成功后提交关联到本条记录。离开页面会停止并取消未完成的录音。</view><view wx:for="{{files}}" wx:key="id" class="file"><text>{{item.name}}</text><text class="remove" data-id="{{item.id}}" bindtap="remove">移除</text></view><view wx:if="{{error}}" class="error">{{error}}</view></view>
