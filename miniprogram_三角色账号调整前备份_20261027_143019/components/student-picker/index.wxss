.picker{background:#fff;border:1rpx solid #dfe9e1;border-radius:18rpx;padding:22rpx;margin-bottom:22rpx}.head{display:flex;align-items:center;justify-content:space-between;font-size:27rpx;color:#375b46}.count{font-size:22rpx;color:#8b9d91;margin-left:20rpx}.arrow,.all{color:#2d8866;font-size:23rpx}.chosen{font-size:23rpx;color:#6a8d77;margin-top:9rpx;word-break:break-all}.panel{padding-top:18rpx}.all{text-align:right;padding-bottom:14rpx}.student{display:flex;align-items:center;justify-content:space-between;padding:18rpx 16rpx;border-radius:12rpx;margin-top:8rpx;background:#f6f8f5}.student.selected{background:#e5f3e9}.name{font-size:27rpx;color:#354f3d}.class{display:block;color:#879b8b;font-size:22rpx}.tick{font-size:22rpx;color:#3a8660}.empty{font-size:24rpx;color:#899a8c;padding:15rpx}
