<view class="picker"><view class="head" bindtap="togglePanel"><view>{{title}}<text class="count">已选 {{count}} 人</text></view><text class="arrow">{{expanded ? '收起' : '展开'}}</text></view><view wx:if="{{chosen}}" class="chosen">{{chosen}}</view>
  <view wx:if="{{expanded}}" class="panel"><view wx:if="{{multiple && students.length}}" class="all" bindtap="all">{{count === students.length ? '清空选择' : '全选当前授权学生'}}</view><view wx:if="{{!students.length}}" class="empty">暂无可选学生，请联系机构核实授权</view><view wx:for="{{rows}}" wx:key="id" class="student {{item.checked ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose"><view><text class="name">{{item.name}}</text><text class="class">{{item.className}} · {{item.grade}}</text></view><text class="tick">{{item.checked ? '已选' : '选择'}}</text></view></view>
</view>
