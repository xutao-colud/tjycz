page{background:#f3f8f6;color:#1d3530;font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{font-size:27rpx;margin:0;border-radius:16rpx;font-weight:500;line-height:1.5;padding:21rpx 26rpx}button::after{border:none}button[disabled]{opacity:.48}input,textarea{width:100%;background:#f4f8f6;border:1rpx solid #dce7e1;border-radius:14rpx;padding:21rpx;color:#1d3530;font-size:28rpx}input{height:88rpx}textarea{min-height:160rpx}picker{padding:22rpx;background:#f4f8f6;border:1rpx solid #dce7e1;border-radius:14rpx}.page{max-width:1060rpx;margin:0 auto;padding:26rpx 28rpx calc(50rpx + env(safe-area-inset-bottom))}.hero{padding:25rpx 4rpx 34rpx}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#55877a;margin-bottom:10rpx}.title{font-size:44rpx;line-height:1.3;font-weight:650;letter-spacing:1rpx}.subtitle,.muted{color:#70867e;font-size:25rpx}.subtitle{margin-top:12rpx}.card{background:#fff;border:1rpx solid #e1ebe5;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 7rpx 24rpx rgba(30,75,58,.025)}.card-title{font-size:31rpx;font-weight:600}.card-head,.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.card-head{margin-bottom:20rpx}.row.wrap,.actions{flex-wrap:wrap}.col{flex:1;min-width:0}.gap{margin-top:22rpx}.small-gap{margin-top:12rpx}.label{display:block;font-size:25rpx;color:#55756a;margin-bottom:10rpx}.field{margin-bottom:24rpx}.primary{background:#19836d;color:#fff}.secondary{background:#eaf5ef;color:#247760}.danger{background:#fff0ed;color:#ae5745}.text-button{background:transparent;color:#257a65;padding:10rpx 0;font-size:25rpx}.actions{display:flex;gap:14rpx;margin-top:22rpx}.actions button{flex:1;min-width:180rpx}.badge{display:inline-block;font-size:22rpx;padding:5rpx 15rpx;border-radius:10rpx;color:#36765f;background:#edf6ef;white-space:nowrap}.badge.warn{color:#9b7136;background:#fff5df}.badge.dim{color:#75857d;background:#f1f4f2}.notice{padding:20rpx 24rpx;border-radius:16rpx;background:#e6f2ec;color:#477463;font-size:24rpx;margin-bottom:22rpx}.error{color:#a44e3c;background:#fff1eb;padding:22rpx;border-radius:16rpx;margin:18rpx 0;font-size:25rpx;word-break:break-all}.metric-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-bottom:24rpx}.metric{background:#fff;border:1rpx solid #e1ebe5;padding:24rpx;border-radius:22rpx}.metric-value{font-size:48rpx;font-weight:600;line-height:1.3;color:#1b735d}.metric-label{color:#70867e;font-size:24rpx;margin-top:7rpx}.menu-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.menu-item{background:#f3f8f5;border:1rpx solid #e0eae3;border-radius:18rpx;padding:24rpx 20rpx;min-height:126rpx}.menu-name{font-weight:600;font-size:29rpx}.menu-desc{color:#7b9086;font-size:22rpx;margin-top:6rpx}.list-row{padding:22rpx 0;border-bottom:1rpx solid #eaf0ec}.list-row:first-child{padding-top:0}.list-row:last-child{border-bottom:0;padding-bottom:0}.body-text{white-space:pre-wrap;word-break:break-word;font-size:27rpx}.divider{height:1rpx;background:#e5eee8;margin:24rpx 0}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0}.chip{font-size:24rpx;padding:10rpx 22rpx;border:1rpx solid #dce7df;border-radius:12rpx;background:#fff;color:#6f8478}.chip.active{background:#e0f1e8;border-color:#86bba3;color:#166d54}.empty-inline{font-size:25rpx;color:#82948b;padding:28rpx 0;text-align:center}.number-positive{color:#18816c;font-weight:650}.number-negative{color:#ae634a;font-weight:650}.mini{font-size:22rpx}.progress{background:#e9f1ec;height:10rpx;border-radius:8rpx;overflow:hidden;margin-top:12rpx}.progress-inner{height:100%;background:#67b49a;border-radius:8rpx}.student-summary{padding:18rpx 0}.selected-line{font-size:24rpx;color:#567e6b;margin:14rpx 0}.login-brand{font-size:54rpx;letter-spacing:5rpx;font-weight:600}.login-top{padding:70rpx 6rpx 40rpx}.brand-mark{width:72rpx;height:8rpx;background:#38997a;margin-bottom:30rpx;border-radius:8rpx}.stat-inline{display:flex;gap:24rpx;flex-wrap:wrap;margin-top:12rpx;color:#668273;font-size:24rpx}.link{color:#1d8268}.hint{font-size:23rpx;color:#819589;margin-top:10rpx}.date-label{color:#698477;font-size:23rpx;margin-bottom:6rpx}.rating{display:flex;gap:14rpx;margin:12rpx 0}.rating-item{padding:12rpx 20rpx;background:#f0f5f1;border-radius:12rpx;color:#667d6e}.rating-item.active{background:#dcf0e5;color:#1e755b}.result-ok{color:#237c61}.result-fail{color:#b65e46}
