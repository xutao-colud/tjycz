<app-nav/><view class="page"><view class="hero"><view class="eyebrow">任务详情</view><view class="title">作业与批改</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/>
<view wx:if="{{item}}" hidden="{{loading || error}}"><view class="card"><view class="card-head"><text class="badge">{{item.subject}} · {{item.typeText}}</text><text class="badge {{item.status === 'CORRECTION' ? 'warn' : ''}}">{{item.statusText}}</text></view><view class="card-title">{{item.title}}</view><view class="muted small-gap">{{item.studentName}} · {{item.className}} · {{item.date}}</view><view class="body-text gap">{{item.description || '暂无补充说明'}}</view><file-list files="{{item.attachments}}"/></view>
<view wx:if="{{item.comment || item.accuracy === 0 || item.accuracy}}" class="card"><view class="card-title">老师的反馈</view><view wx:if="{{item.accuracy === 0 || item.accuracy}}" class="stat-inline">正确率 {{item.accuracy}}%</view><view class="body-text small-gap">{{item.comment || '暂无评语'}}</view></view>
<view wx:if="{{(!teacher && (item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS')) || item.status === 'CORRECTION'}}" class="card"><view class="card-title">{{item.status === 'CORRECTION' ? '提交订正材料' : '提交作业材料'}}</view><view class="muted small-gap">可上传书写照片或口头作业视频，保存后老师可查看。</view><view class="gap"><media-field audio-enabled="{{item.type === 'ORAL'}}" bindchange="media" binduploading="uploadState" reset-key="{{mediaReset}}" disabled="{{busy}}"/></view><view class="actions"><button class="secondary" bindtap="saveAttachments" disabled="{{busy || uploading || !attachmentIds.length}}">保存附件</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploading}}">{{item.status === 'CORRECTION' ? '提交订正复核' : '提交老师批改'}}</button></view></view>
<view wx:if="{{teacher}}" class="card"><view class="card-title">教师批改</view><view class="actions"><button wx:if="{{item.status === 'NOT_STARTED'}}" class="secondary" bindtap="progress" data-status="IN_PROGRESS" disabled="{{busy}}">标记进行中</button><button wx:if="{{item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS'}}" class="secondary" bindtap="progress" data-status="PENDING_REVIEW" disabled="{{busy}}">进入待批改</button></view><view wx:if="{{item.status !== 'COMPLETED'}}" class="gap"><view class="field"><text class="label">正确率（0–100）*</text><input type="digit" value="{{accuracy}}" data-field="accuracy" bindinput="field" placeholder="例如 90"/></view><view class="field"><text class="label">批改说明 / 订正要求</text><textarea value="{{comment}}" data-field="comment" bindinput="field" maxlength="2000" placeholder="说明亮点与需要订正的地方"/></view><view class="actions"><button class="secondary" data-status="CORRECTION" bindtap="review" loading="{{busy}}" disabled="{{busy}}">需订正</button><button class="primary" data-status="COMPLETED" bindtap="review" loading="{{busy}}" disabled="{{busy}}">批改完成</button></view></view><view wx:else class="notice gap">本份作业已完成，奖励是否入账请查看积分流水。</view></view>
<view wx:if="{{actionError}}" class="error">{{actionError}}</view></view></view>
