<app-nav/><view class="page"><view class="hero"><view class="eyebrow">积累与掌握</view><view class="title">错题成长本</view><view class="subtitle">拍照或文字录入，订正、复核，再按计划复习。</view></view><view class="card row"><picker class="col" range="{{subjects}}" value="{{subjectIndex}}" data-field="subjectIndex" bindchange="filter">{{subjects[subjectIndex]}}</picker><picker class="col" range="{{statusNames}}" value="{{statusIndex}}" data-field="statusIndex" bindchange="filter">{{statusNames[statusIndex]}}</picker></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><view hidden="{{loading || error}}"><student-picker students="{{students}}" selected="{{studentIds}}" bindchange="pickStudents"/><button class="primary" bindtap="toggleCreate">{{showCreate ? '收起录入表单' : '拍照 / 文字录入错题'}}</button>
<view wx:if="{{showCreate}}" class="card gap"><view class="card-title">为已选学生记录一道错题</view><view class="field gap"><text class="label">学科</text><picker range="{{taskSubjects}}" value="{{taskSubjectIndex}}" bindchange="selectSubject">{{taskSubjects[taskSubjectIndex]}}</picker></view><view class="field"><text class="label">题目或简要描述 *</text><textarea value="{{title}}" data-field="title" bindinput="field" maxlength="300" placeholder="输入题目，或为拍照题目填写简短标题"/></view><view class="field"><text class="label">知识点</text><input value="{{knowledgePoint}}" data-field="knowledgePoint" bindinput="field" placeholder="例如：分数加减法" maxlength="200"/></view><view class="field"><text class="label">错误原因</text><textarea value="{{errorReason}}" data-field="errorReason" bindinput="field" maxlength="1000" placeholder="记录概念、方法或审题问题"/></view><view class="field"><text class="label">关联作业编号（可选）</text><input type="number" value="{{homeworkId}}" data-field="homeworkId" bindinput="field" placeholder="填写后端作业编号"/></view><media-field bindchange="media" binduploading="uploadState" reset-key="{{mediaReset}}" disabled="{{busy}}"/><view class="hint">拍照仅上传原题，不进行未配置的智能识别。</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button class="primary gap" bindtap="create" loading="{{busy}}" disabled="{{busy || uploading || !studentIds.length}}">保存错题</button></view>
<view class="gap"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="card-head"><text class="badge">{{item.subject}}</text><text class="badge {{item.status === 'UNCORRECTED' ? 'warn' : ''}}">{{item.statusText}}</text></view><view class="card-title body-text">{{item.title}}</view><view class="muted small-gap">{{item.studentName}} · {{item.knowledgePoint || '待补充知识点'}}</view><view class="row small-gap"><text class="hint">{{item.createdText}}</text><text class="link mini">待复习 {{item.pendingReviews}} 次 ›</text></view></view><state-view empty="{{!items.length}}" empty-text="当前条件下暂无错题，继续保持学习好习惯"/></view></view></view>
