<app-nav/><view class="page"><view class="hero"><view class="eyebrow">每天动一动</view><view class="title">体能记录</view><view class="subtitle">{{teacher ? '批量记录运动，认真对待每一次坚持。' : '看看孩子的运动与坚持。'}}</view></view><view class="card"><text class="label">记录日期</text><picker mode="date" value="{{date}}" bindchange="changeDate">{{date}}</picker></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" multiple="{{teacher}}" bindchange="pickStudents"/><view wx:if="{{teacher}}" class="card"><view class="card-title">为已选 {{studentIds.length}} 人打卡</view><view class="field gap"><text class="label">运动项目 *</text><input value="{{project}}" data-field="project" bindinput="field" maxlength="80" placeholder="例如：跳绳、跑步"/></view><view class="row"><view class="field col"><text class="label">次数（不适用填 0）</text><input type="number" value="{{count}}" data-field="count" bindinput="field" placeholder="例如 100"/></view><view class="field col"><text class="label">时长（秒）</text><input type="number" value="{{duration}}" data-field="duration" bindinput="field" placeholder="例如 60"/></view></view><view class="hint">同一学生同一天同项目仅记录一次，并由后端按机构规则奖励积分。</view><button class="primary gap" bindtap="submit" disabled="{{busy || !studentIds.length}}" loading="{{busy}}">提交批量体能打卡</button></view><view wx:if="{{result}}" class="notice">{{result}}</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><view wx:for="{{records}}" wx:key="id" class="card"><view class="card-head"><view class="card-title">{{item.project}}</view><text class="badge">{{item.confirmation}}</text></view><view class="muted">{{item.studentName}} · {{item.date}}</view><view class="stat-inline"><text>{{item.count}} 次</text><text>{{item.duration}} 秒</text></view></view><state-view empty="{{!records.length}}" empty-text="当日暂无体能记录"/></block></view>
