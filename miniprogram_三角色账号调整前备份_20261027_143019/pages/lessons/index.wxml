<app-nav/><view class="page"><view class="hero"><view class="eyebrow">每一节课都清楚</view><view class="title">课程与课时</view><view class="subtitle">各课程独立账户，购课、赠课与消课均可追溯。</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" bindchange="pickStudents"/>
<view wx:for="{{accounts}}" wx:key="id" class="card"><view class="card-head"><view class="card-title">{{item.courseName}}</view><text class="badge {{item.low ? 'warn' : ''}}">{{item.low ? '余额提醒' : '正常'}}</text></view><view class="metric-value">{{item.balance}} <text class="muted">{{item.unit || '课时'}}</text></view><view class="stat-inline"><text>累计购买 {{item.purchased}}</text><text>累计赠送 {{item.gifted}}</text><text>累计消耗 {{item.consumed}}</text></view><view class="hint">预警线：{{item.warningThreshold}} {{item.unit || '课时'}}</view></view><state-view empty="{{!accounts.length}}" empty-text="暂无课程账户，请联系机构确认报名"/>
<view wx:if="{{settlements.length}}" class="card"><view class="card-title">待处理消课</view><view wx:for="{{settlements}}" wx:key="id" class="list-row"><view>{{item.courseName}} · {{item.date}}</view><view class="muted">{{item.reason || '请核对账户余额与排课'}}</view><button class="secondary small-gap" data-id="{{item.id}}" bindtap="retrySettlement" disabled="{{busy}}" loading="{{busy}}">重试结算</button></view></view>
<view class="card"><view class="label">按课程查看流水</view><picker range="{{accountNames}}" value="{{accountIndex}}" bindchange="account">{{accountNames[accountIndex]}}</picker></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view>
<view class="card"><view class="card-title">课时流水</view><view wx:for="{{ledger}}" wx:key="id" class="list-row"><view class="row"><view class="col"><view>{{item.courseName}} · {{item.typeText}}</view><view class="hint">{{item.reason || '系统记账'}}</view></view><text class="{{item.amount > 0 ? 'number-positive' : 'number-negative'}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></view><view class="stat-inline"><text>变动前 {{item.balanceBefore}}</text><text>变动后 {{item.balanceAfter}}</text><text wx:if="{{item.reversed}}" class="badge dim">已冲正</text></view><view class="hint">{{item.createdText}}</view></view><view wx:if="{{!ledger.length}}" class="empty-inline">当前课程暂无课时流水</view></view>
<view class="card"><view class="card-title">续费记录</view><view wx:for="{{renewals}}" wx:key="id" class="list-row"><view class="row"><text>{{item.courseName}}</text><text class="badge">{{item.statusText}}</text></view><view class="stat-inline"><text>实收 ¥{{item.money}}</text><text>购买 {{item.lessons}} 课时</text><text>赠送 {{item.giftLessons}} 课时</text></view><view class="hint">{{item.createdText}}</view><view wx:if="{{item.note}}" class="muted">{{item.note}}</view></view><view wx:if="{{!renewals.length}}" class="empty-inline">暂无续费记录</view></view><view class="notice">续费与冲正由机构管理员办理，小程序展示服务端入账结果。</view></block></view>
