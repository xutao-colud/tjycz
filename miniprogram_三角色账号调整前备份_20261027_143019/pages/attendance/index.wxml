<app-nav/><view class="page"><view class="hero"><view class="eyebrow">教师人工考勤</view><view class="title">照顾每一次抵达</view><view class="subtitle">批量签到、签退，逐人查看处理结果。</view></view><view class="card"><view class="field"><text class="label">考勤日期</text><picker mode="date" value="{{date}}" bindchange="changeDate">{{date}}</picker></view><picker range="{{classNames}}" value="{{classIndex}}" bindchange="changeClass">{{classNames[classIndex]}}</picker></view>
<state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" multiple title="批量考勤对象" bindchange="pickStudents"/><view class="notice">签退按当日启用排课及报名结算课时。重复请求不会重复扣减；缺少签到会失败，余额不足时离校成功并由后端保留待处理消课。</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><view class="actions"><button class="primary" data-action="in" bindtap="batch" loading="{{busy}}" disabled="{{busy || !studentIds.length}}">人工签到</button><button class="secondary" data-action="out" bindtap="batch" loading="{{busy}}" disabled="{{busy || !studentIds.length}}">人工签退</button></view>
<view wx:if="{{results.length}}" class="card gap"><view class="card-title">本次操作结果</view><view wx:for="{{results}}" wx:key="studentId" class="list-row"><view class="row"><text>{{item.name}}</text><text class="{{item.success ? 'result-ok' : 'result-fail'}}">{{item.outcome}}</text></view><view class="muted">{{item.message}}</view></view></view>
<view class="card gap"><view class="card-title">当日考勤记录</view><view wx:for="{{records}}" wx:key="id" class="list-row"><view class="row"><text>{{item.studentName}}</text><text class="badge">{{item.statusText}}</text></view><view class="muted">{{item.className}} · {{item.sourceText}}</view><view class="hint">签到 {{item.checkInText}}</view><view class="hint">签退 {{item.checkOutText}}</view></view><view wx:if="{{!records.length}}" class="empty-inline">当日暂无考勤记录</view></view></block></view>
