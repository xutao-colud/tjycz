<app-nav/><view class="page"><view class="hero"><view class="eyebrow">一天的成长，温柔记录</view><view class="title">每日小结</view><view class="subtitle">{{teacher ? '汇总真实学习记录，写下评语再发布。' : '阅读老师的小结，留下评分与反馈。'}}</view></view><view class="card"><view class="label">小结日期</view><picker mode="date" value="{{date}}" bindchange="changeDate">{{date}}</picker></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" multiple="{{teacher}}" title="查看范围 / 生成对象" bindchange="pickStudents"/><button wx:if="{{teacher}}" class="primary" bindtap="generate" loading="{{busy}}" disabled="{{busy || !studentIds.length}}">生成已选 {{studentIds.length}} 人的小结草稿</button><view wx:if="{{generated}}" class="notice gap">{{generated}}</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view>
<view class="gap"><view wx:for="{{items}}" wx:key="id" class="card"><view class="card-head"><view class="card-title">{{item.studentName}}的学习日报</view><text class="badge">{{item.statusText}}</text></view><view class="muted">{{item.date}} <text wx:if="{{item.status === 'PUBLISHED'}}">· 第 {{item.version}} 版</text></view><view class="body-text gap">{{item.contentText}}</view><view wx:if="{{item.teacherComment}}" class="notice gap">老师的话：{{item.teacherComment}}</view>
<block wx:if="{{teacher && item.status === 'DRAFT'}}"><view wx:if="{{editingId === item.id}}" class="gap"><view class="label">教师评语</view><textarea value="{{teacherComment}}" data-field="teacherComment" bindinput="field" maxlength="2000" placeholder="写下孩子今天的亮点与建议"/><button class="secondary gap" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存评语</button></view><view wx:else class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">编辑评语</button><button class="primary" data-id="{{item.id}}" bindtap="publish" loading="{{busy}}" disabled="{{busy}}">发布小结</button></view></block>
<view wx:if="{{item.status === 'PUBLISHED'}}" class="gap"><view class="hint">发布于 {{item.publishedText}}</view><view wx:if="{{teacher}}" class="hint">通知：{{item.notificationText}}</view><view wx:if="{{item.feedbackRating}}" class="divider"></view><view wx:if="{{item.feedbackRating}}" class="body-text">家长评分：{{item.feedbackRating}} / 5<view class="muted">{{item.feedbackText || '暂无文字反馈'}}</view></view><block wx:if="{{!teacher}}"><view wx:if="{{feedbackId === item.id}}" class="gap"><view class="label">您的评分（1–5 分）</view><view class="rating"><view wx:for="{{ratings}}" wx:for-item="score" wx:key="*this" class="rating-item {{rating === score ? 'active' : ''}}" data-rating="{{score}}" bindtap="rate">{{score}}</view></view><textarea value="{{feedbackText}}" data-field="feedbackText" bindinput="field" maxlength="1000" placeholder="留下鼓励、建议或希望老师关注的事（可选）"/><button class="primary gap" bindtap="sendFeedback" loading="{{busy}}" disabled="{{busy}}">提交评分反馈</button></view><button wx:else class="secondary gap" data-id="{{item.id}}" bindtap="feedback" disabled="{{busy}}">{{item.feedbackRating ? '更新我的反馈' : '评分与反馈'}}</button></block></view></view><state-view empty="{{!items.length}}" empty-text="{{teacher ? '当日暂无小结，可选择学生生成草稿' : '老师暂未发布当日小结，请稍后查看'}}"/></view></block></view>
