<app-nav/><view class="page"><view class="hero"><view class="eyebrow">学习任务</view><view class="title">今日作业</view><view class="subtitle">{{teacher ? '布置、跟进、批改，让每一步学习有回应。' : '查看孩子的学习任务，提交作业与订正。'}}</view></view><view class="card"><view class="field"><text class="label">任务日期</text><picker mode="date" value="{{date}}" bindchange="changeDate">{{date}}</picker></view><view class="row"><picker class="col" range="{{subjects}}" value="{{subjectIndex}}" data-field="subjectIndex" bindchange="filter">{{subjects[subjectIndex]}}</picker><picker class="col" range="{{statusNames}}" value="{{statusIndex}}" data-field="statusIndex" bindchange="filter">{{statusNames[statusIndex]}}</picker></view></view>
<state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><view hidden="{{loading || error}}"><student-picker students="{{students}}" selected="{{studentIds}}" multiple="{{teacher}}" title="学生范围 / 创建对象" bindchange="pickStudents"/><view wx:if="{{created}}" class="notice">{{created}}</view><button wx:if="{{teacher}}" class="primary" bindtap="toggleCreate">{{showCreate ? '收起创建表单' : '创建作业任务'}}</button>
<view wx:if="{{teacher && showCreate}}" class="card gap"><view class="card-title">布置给已选 {{studentIds.length}} 位学生</view><view class="row gap"><picker class="col" range="{{taskSubjects}}" value="{{taskSubjectIndex}}" data-field="taskSubjectIndex" bindchange="selectForm">{{taskSubjects[taskSubjectIndex]}}</picker><picker class="col" range="{{types}}" value="{{typeIndex}}" data-field="typeIndex" bindchange="selectForm">{{types[typeIndex]}}</picker></view><view class="field gap"><text class="label">作业标题 *</text><input value="{{title}}" data-field="title" bindinput="field" maxlength="160" placeholder="例如：数学练习册第 12 页"/></view><view class="field"><text class="label">任务说明</text><textarea value="{{description}}" data-field="description" bindinput="field" maxlength="2000" placeholder="填写作业要求、注意事项"/></view><media-field audio-enabled="{{typeIndex === 1}}" bindchange="media" binduploading="uploadState" reset-key="{{mediaReset}}" disabled="{{busy}}"/><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button class="primary gap" bindtap="create" loading="{{busy}}" disabled="{{busy || uploading || !studentIds.length}}">创建并分配</button></view>
<view class="gap"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="card-head"><text class="badge">{{item.subject}} · {{item.typeText}}</text><text class="badge {{item.status === 'CORRECTION' ? 'warn' : ''}}">{{item.statusText}}</text></view><view class="card-title">{{item.title}}</view><view class="muted small-gap">{{item.studentName}} · {{item.className}}</view><view wx:if="{{item.description}}" class="body-text small-gap">{{item.description}}</view><view class="row small-gap"><text class="hint">{{item.date}}</text><text class="link mini">查看与处理 ›</text></view></view><state-view empty="{{!items.length}}" empty-text="当前筛选条件下暂无作业"/></view></view></view>
