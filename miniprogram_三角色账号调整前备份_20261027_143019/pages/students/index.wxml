<app-nav/><view class="page"><view class="hero"><view class="eyebrow">学生与班级</view><view class="title">{{teacher ? '学生名册' : '我的孩子'}}</view><view class="subtitle">仅展示后端授予当前账号访问权限的学生。</view></view><view class="card"><view class="field"><text class="label">搜索姓名 / 关键词</text><input value="{{keyword}}" data-field="keyword" bindinput="field" bindconfirm="search" confirm-type="search" placeholder="输入关键词"/></view><picker wx:if="{{teacher}}" range="{{classNames}}" value="{{classIndex}}" bindchange="changeClass">{{classNames[classIndex]}}</picker><button class="secondary gap" bindtap="search" disabled="{{loading}}">查询学生</button></view>
<state-view loading="{{loading}}" error="{{error}}" empty="{{!students.length}}" empty-text="暂无符合条件的授权学生" bindretry="retry"/>
<block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" multiple="{{teacher}}" title="选择后续操作对象" bindchange="pickStudents"/><view wx:if="{{studentIds.length}}" class="card"><view class="muted">已选 {{studentIds.length}} 位，下一页会重新校验授权范围。</view><view class="actions"><button wx:if="{{teacher}}" class="primary" data-page="attendance" bindtap="useSelection">去考勤</button><button class="secondary" data-page="homework" bindtap="useSelection">去作业</button><button class="secondary" data-page="summaries" bindtap="useSelection">去小结</button></view></view>
<view wx:for="{{students}}" wx:key="id" class="card"><view class="card-head"><view class="card-title">{{item.name}} <text class="muted">{{item.grade}}</text></view><text class="badge">{{item.attendanceText}}</text></view><view class="muted">{{item.className}}</view><view class="stat-inline"><text>作业 {{item.homeworkCompleted}} / {{item.homeworkTotal}}</text><text>成长积分 {{item.points}}</text></view><view class="stat-inline"><text>晚辅余额 {{item.lessonBalance}} 课时</text><text>家长 {{item.parentName || '未登记'}}</text></view><view class="hint">签到 {{item.checkInText}} · 签退 {{item.checkOutText}}</view></view></block></view>
