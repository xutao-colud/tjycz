<app-nav current="dashboard"/><view class="page"><view class="hero"><view class="eyebrow">{{settings.institutionName || '晚辅智管'}} · {{settings.campusName || '成长记录'}}</view><view class="title">{{user.name}}，你好</view><view class="subtitle">{{teacher ? '把课堂日常，照顾得井井有条。' : '一起见证孩子今天的小小进步。'}}</view></view>
  <view class="card row"><view class="col"><view class="date-label">工作日期</view><picker mode="date" value="{{date}}" bindchange="changeDate">{{date}}</picker></view><text class="badge">{{teacher ? '教师工作台' : '家长工作台'}}</text></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/>
  <block wx:if="{{!loading && !error && dashboard}}"><view class="metric-grid"><view wx:for="{{metrics}}" wx:key="name" class="metric"><view class="metric-value">{{item.value}}</view><view class="metric-label">{{item.name}}</view></view></view>
  <view class="card"><view class="card-head"><view class="card-title">{{teacher ? '今日工作' : '家校同行'}}</view><text class="muted mini">常用功能</text></view><view class="menu-grid">
    <view wx:if="{{teacher}}" class="menu-item" data-url="/pages/attendance/index" bindtap="go"><view class="menu-name">人工考勤</view><view class="menu-desc">批量签到 · 签退结果</view></view>
    <view class="menu-item" data-url="/pages/homework/index" bindtap="go"><view class="menu-name">学习作业</view><view class="menu-desc">{{teacher ? '创建任务 · 批改复核' : '查看任务 · 提交订正'}}</view></view>
    <view class="menu-item" data-url="/pages/mistakes/index" bindtap="go"><view class="menu-name">错题复习</view><view class="menu-desc">拍照录题 · 订正掌握</view></view>
    <view class="menu-item" data-url="/pages/summaries/index" bindtap="go"><view class="menu-name">每日小结</view><view class="menu-desc">{{teacher ? '生成草稿 · 编辑发布' : '阅读成长 · 评分反馈'}}</view></view>
    <view class="menu-item" data-url="/pages/fitness/index" bindtap="go"><view class="menu-name">体能打卡</view><view class="menu-desc">{{teacher ? '批量记录运动表现' : '查看每日运动记录'}}</view></view>
    <view class="menu-item" data-url="/pages/points/index" bindtap="go"><view class="menu-name">成长积分</view><view class="menu-desc">每一次努力都有记录</view></view>
    <view class="menu-item" data-url="/pages/lessons/index" bindtap="go"><view class="menu-name">课程课时</view><view class="menu-desc">独立账户 · 消课流水</view></view>
    <view class="menu-item" data-url="/pages/students/index" bindtap="go"><view class="menu-name">{{teacher ? '学生名册' : '我的孩子'}}</view><view class="menu-desc">{{teacher ? '查找学生 · 选择操作对象' : '绑定孩子 · 学习概况'}}</view></view>
  </view></view>
  <view wx:if="{{!teacher}}" class="card"><view class="card-title">孩子的今天</view><view wx:for="{{children}}" wx:key="id" class="student-summary"><view class="row"><text>{{item.name}} <text class="muted">{{item.className}}</text></text><text class="badge">{{item.attendanceText}}</text></view><view class="stat-inline"><text>作业 {{item.homeworkCompleted}} / {{item.homeworkTotal}}</text><text>积分 {{item.points}}</text><text>晚辅余额 {{item.lessonBalance}} 课时</text></view></view><view wx:if="{{!children.length}}" class="empty-inline">暂无绑定孩子，请联系机构核实</view></view>
  <view class="card"><view class="card-title">各科学习进度</view><view wx:for="{{progress}}" wx:key="subject" class="list-row"><view class="row"><text>{{item.subject}}</text><text class="muted">{{item.completed}} / {{item.total}}</text></view><view class="progress"><view class="progress-inner" style="width:{{item.percent}}%"></view></view></view><view wx:if="{{!progress.length}}" class="empty-inline">当日暂无作业统计</view></view>
  <view wx:if="{{teacher && weekly.length}}" class="card"><view class="card-title">近七日出勤</view><view wx:for="{{weekly}}" wx:key="date" class="row list-row"><text>{{item.label}} <text class="muted mini">{{item.date}}</text></text><text>{{item.present}} / {{item.total}} 人</text></view></view>
  <view class="card"><view class="card-title">最近动态</view><view wx:for="{{activities}}" wx:key="id" class="list-row"><view>{{item.title}}</view><view class="muted small-gap">{{item.detail}}</view><view class="hint">{{item.timeText}}</view></view><view wx:if="{{!activities.length}}" class="empty-inline">当日暂无动态</view></view>
  <view wx:if="{{!settings.wechatConfigured}}" class="notice">微信身份与订阅消息尚未配置；小结发布后可在小程序内阅读，发送结果以服务端通知状态为准。</view></block>
</view>
