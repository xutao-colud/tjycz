<app-nav/><view class="page"><view class="hero"><view class="eyebrow">一道题，一次进步</view><view class="title">订正与复习</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/><view wx:if="{{item}}" hidden="{{loading || error}}"><view class="card"><view class="card-head"><text class="badge">{{item.subject}} · {{item.studentName}}</text><text class="badge">{{item.statusText}}</text></view><view class="card-title body-text">{{item.title}}</view><view class="divider"></view><view class="label">知识点</view><view class="body-text">{{item.knowledgePoint || '未填写'}}</view><view class="label gap">错误原因</view><view class="body-text">{{item.errorReason || '未填写'}}</view><file-list files="{{item.attachments}}"/><view class="hint">录入时间 {{item.createdText}}</view></view>
<view class="card"><view class="card-title">订正记录</view><view wx:for="{{item.corrections}}" wx:key="id" class="list-row"><view class="body-text">{{item.text || '照片订正，见附件'}}</view><file-list files="{{item.attachments}}"/><view class="hint">{{item.createdText}}</view></view><view wx:if="{{!item.corrections.length}}" class="empty-inline">暂无订正记录</view><view wx:if="{{item.teacherComment}}" class="notice gap">老师反馈：{{item.teacherComment}}</view></view>
<view wx:if="{{item.status === 'UNCORRECTED'}}" class="card"><view class="card-title">提交本次订正</view><view class="field gap"><text class="label">订正过程 *</text><textarea value="{{correctionText}}" data-field="correctionText" bindinput="field" maxlength="2000" placeholder="简述正确的解题步骤与思考，可同时上传照片"/></view><media-field bindchange="media" binduploading="uploadState" reset-key="{{mediaReset}}" disabled="{{busy}}"/><button class="primary gap" bindtap="correct" loading="{{busy}}" disabled="{{busy || uploading}}">提交订正，等待复核</button></view>
<view wx:if="{{teacher && item.status === 'PENDING_REVIEW'}}" class="card"><view class="card-title">教师复核</view><view class="field gap"><text class="label">复核说明</text><textarea value="{{teacherComment}}" data-field="teacherComment" bindinput="field" maxlength="2000" placeholder="记录掌握情况或继续订正要求"/></view><view class="actions"><button class="secondary" data-approved="no" bindtap="review" disabled="{{busy}}">继续订正</button><button class="primary" data-approved="yes" bindtap="review" loading="{{busy}}" disabled="{{busy}}">通过，已掌握</button></view></view>
<view wx:if="{{!teacher && item.status === 'PENDING_REVIEW'}}" class="notice">订正已提交，等待老师复核。</view><view class="card"><view class="card-title">间隔复习计划</view><view class="hint">通过复核后由后端生成第 1、3、7 天复习计划，到期可确认完成。</view><view wx:for="{{item.reviews}}" wx:key="id" class="list-row"><view class="row"><text>{{item.dueDate}}</text><text class="badge">{{item.statusText}}</text></view><button wx:if="{{teacher && item.canComplete}}" class="secondary gap" data-id="{{item.id}}" bindtap="complete" disabled="{{busy}}">我已完成本次复习</button><view wx:elif="{{item.status === 'PENDING'}}" class="hint">{{item.canComplete ? '已到复习日，完成后由老师确认' : '尚未到复习日期'}}</view><view wx:else class="hint">完成于 {{item.completedText}}</view></view><view wx:if="{{!item.reviews.length}}" class="empty-inline">通过复核后展示复习计划</view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view></view></view>
