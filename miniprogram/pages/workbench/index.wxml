<app-nav />
<view class="page workbench-page role-home"><view class="hero"><view class="title">今日班级</view><view class="subtitle">看作业，记到离校，及时回复家长</view></view>
  <view class="filter-bar"><select-picker class="filter-item" range="{{classNames}}" value="{{classIndex}}" bindchange="classroom" label="选择班级" plain="{{true}}"><view class="filter-value">{{classNames[classIndex] || '暂无授权班级'}} ⌄</view></select-picker><date-picker value="{{date}}" bindchange="changeDate"><view class="filter-value">{{date}} ⌄</view></date-picker></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view hidden="{{loading || error}}">
    <view wx:if="{{readOnly}}" class="notice">未来日期仅查看安排，不能登记已发生的记录。</view>
    <button wx:if="{{pickupAlerts.length}}" class="work-pickup-banner" bindtap="openPickupAlert"><image src="/assets/icons/summaries.svg" /><view class="col"><view>{{pickupAlerts.length}} 项接送异常需要核对</view><text>异常处理前暂不离校</text></view><text>›</text></button>
    <view class="workbench-summary">
      <view class="workbench-metrics"><view><view class="metric-label">到校 / 在册</view><view class="metric-value">{{counts.arrived || 0}}<text> / {{counts.total || 0}}</text></view></view><view><view class="metric-label">当前在校</view><view class="metric-value">{{counts.present || 0}}</view></view><view><view class="metric-label">待批改 / 复核</view><view class="metric-value">{{counts.review || 0}}</view></view></view>
      <view wx:if="{{counts.summaries}}" class="workbench-note">{{counts.summaries}} 位学生的小结待处理，可在下方筛选查看</view>
    </view>
    <block>
      <view class="selection-bar"><button id="work-status-all" class="text-button {{filterIndex === 0 ? 'status-all-active' : ''}}" data-index="0" bindtap="chooseStatus" disabled="{{busy || uploading}}">全部学生 {{roster.length}}</button><button class="text-button" bindtap="toggleBatch" disabled="{{busy || uploading}}">{{batchMode ? '退出批量' : '批量处理'}}</button></view>
      <view class="status-navigator">
        <view class="status-tabs"><button wx:for="{{statusGroups}}" wx:key="name" id="work-status-group-{{index}}" class="status-tab {{statusGroup === index ? 'status-tab-active' : ''}}" data-index="{{index}}" bindtap="chooseStatusGroup" disabled="{{busy || uploading}}" aria-pressed="{{statusGroup === index}}">{{item.name}}</button></view>
        <view class="status-tiles status-tiles-{{statusTiles.length}}"><button wx:for="{{statusTiles}}" wx:key="index" id="work-status-filter-{{item.index}}" class="status-tile {{filterIndex === item.index ? 'status-tile-active' : ''}} {{item.index === 5 && item.count ? 'status-attention' : ''}}" data-index="{{item.index}}" bindtap="chooseStatus" disabled="{{busy || uploading}}" aria-label="{{item.label}}，{{item.count}}位学生" aria-pressed="{{filterIndex === item.index}}"><view class="status-tile-number"><image src="/assets/icons/{{item.icon}}.svg"/><text>{{item.count}}</text></view><view class="status-tile-label">{{item.label}}</view></button></view>
        <view class="status-caption">{{filterIndex ? filters[filterIndex] : '全部学生'}} · {{students.length}} 人<text wx:if="{{statusGroup === 0}}"> · 同一孩子可有多项待办</text></view>
      </view>
      <view wx:if="{{batchMode}}" class="selection-bar"><text class="muted">已选 {{selectedCount}} 人</text><button class="text-button" bindtap="selectVisible" disabled="{{busy || uploading}}">选择当前列表</button><button class="text-button" bindtap="clearSelection">清空</button></view>
      <view class="student-roster card"><view wx:for="{{students}}" wx:key="id" class="roster-row {{item.selected && batchMode ? 'row-selected' : ''}}">
        <view class="roster-identity">
          <button wx:if="{{batchMode}}" class="selection-toggle" data-id="{{item.id}}" bindtap="select" role="checkbox" aria-checked="{{item.selected}}" aria-label="选择{{item.name}}"><checkbox checked="{{item.selected}}" color="#1677ff" disabled="{{busy || uploading}}" /></button>
          <image wx:if="{{item.avatarUrl}}" class="roster-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="roster-avatar avatar-letter">{{item.name[0]}}</view>
          <view class="col"><view class="student-link">{{item.name}} <text class="roster-state">{{item.attendanceText}}</text></view><view class="muted">{{item.tasks ? '已完成 ' + item.done + '/' + item.tasks + ' 项作业' : '当日暂无作业'}}{{item.needsReply ? ' · 家长留言待回复' : ''}}</view><view wx:if="{{item.tasks}}" class="roster-progress" role="progressbar" aria-label="{{item.name}}作业完成进度" aria-valuemin="0" aria-valuemax="{{item.tasks}}" aria-valuenow="{{item.done}}"><view class="roster-progress-fill" style="width:{{item.homeworkPercent}}%"></view></view><view wx:if="{{item.tasks}}" class="roster-progress-note">{{item.primary}}</view></view>
          <view wx:if="{{!batchMode}}" class="roster-quick-actions"><button class="row-primary text-button" data-id="{{item.id}}" bindtap="primaryStudent" disabled="{{busy || uploading}}">{{filterIndex === 2 ? '批改' : filterIndex === 4 ? '复核' : filterIndex === 8 ? '回复' : filterIndex === 9 ? '处理小结' : item.action}}</button>
          <button class="text-button row-more" data-id="{{item.id}}" bindtap="moreStudent">{{expandedId === item.id ? '收起' : '更多'}}</button></view>
        </view>
        <view wx:if="{{expandedId === item.id && !batchMode}}" class="row-detail">
          <view class="muted">{{item.taskSummary || '当日未布置作业'}}</view><view class="muted">签到 {{item.checkIn}} · 签退 {{item.checkOut}}</view>
          <button wx:if="{{item.attendanceStatus === 'NOT_ARRIVED' || item.attendanceStatus === 'PRESENT'}}" class="text-button" data-id="{{item.id}}" bindtap="photoMark" disabled="{{busy || uploading || date !== today}}">{{item.attendanceStatus === 'PRESENT' ? '拍照签退' : '拍照签到'}}</button>
          <button class="text-button" data-url="/pages/lessons/index?studentId={{item.id}}&date={{date}}" bindtap="go">课程与扣课 ›</button>
          <button class="text-button" data-id="{{item.id}}" bindtap="growth">成长档案 ›</button>
          <button class="text-button" data-id="{{item.id}}" bindtap="homework">学习作业 ›</button>
          <button class="text-button" data-url="/pages/scan/index?studentId={{item.id}}" bindtap="go">拍照识题 ›</button>
          <button class="text-button" data-id="{{item.id}}" bindtap="follow">关注事项{{item.concernCount ? ' · ' + item.concernCount : ''}} ›</button>
          <button class="text-button" data-id="{{item.id}}" data-kind="MESSAGE" bindtap="follow">家校消息 ›</button>
          <button class="text-button" data-id="{{item.id}}" bindtap="quickSummary">每日小结 ›</button>
        </view>
      </view><view wx:if="{{!students.length}}" class="empty-inline">当前班级或筛选条件下暂无学生</view></view>
    </block>
    <view wx:if="{{batchMode}}" class="batch-panel"><view class="row"><view class="card-title">批量操作</view><text class="muted">已选 {{selectedCount}} 人</text></view><view wx:if="{{admin}}" class="field gap"><text class="label">历史离校核对原因（补录历史时必填）</text><textarea value="{{historicalReason}}" data-field="historicalReason" bindinput="field" maxlength="1000" aria-label="历史离校核对原因" /></view><button class="text-button" data-url="/pages/safety/index?date={{date}}" bindtap="go">接送管理与异常提醒 ›</button><view class="action-grid"><button class="secondary" bindtap="attendance" data-out="0" disabled="{{busy || uploading || readOnly}}">到校签到</button><button wx:if="{{admin && date < today}}" class="secondary" bindtap="attendance" data-out="1" disabled="{{busy || uploading || readOnly}}">离校签退</button><button class="secondary {{panel === 'record' ? 'active-action' : ''}}" data-panel="record" bindtap="panel">成长记录</button><button class="secondary {{panel === 'review' ? 'active-action' : ''}}" data-panel="review" bindtap="panel">批量批改</button><button class="secondary {{panel === 'summary' ? 'active-action' : ''}}" data-panel="summary" bindtap="panel">生成日小结</button></view>
      <view wx:if="{{panel === 'record'}}" class="gap"><select-picker range="{{noteTypes}}" value="{{noteType}}" data-field="noteType" bindchange="pick" label="选择记录类型"><view class="form-pick">{{noteTypes[noteType]}}</view></select-picker><textarea aria-label="成长记录内容" wx:if="{{noteType < 3}}" class="gap" value="{{text}}" data-field="text" bindinput="field" maxlength="2000" placeholder="填写真实表现或点评，保存后同步展示在成长时间轴" /><block wx:if="{{noteType === 3}}"><input aria-label="运动项目" class="gap" value="{{project}}" data-field="project" bindinput="field" placeholder="运动项目" /><view class="form-grid gap"><input aria-label="运动次数" class="col" type="number" value="{{count}}" data-field="count" bindinput="field" placeholder="次数" /><input aria-label="运动时长秒数" class="col" type="number" value="{{duration}}" data-field="duration" bindinput="field" placeholder="时长（秒）" /></view></block><block wx:if="{{noteType === 4}}"><textarea aria-label="具体情况或暂停原因" class="gap" value="{{reason}}" data-field="reason" bindinput="field" maxlength="2000" placeholder="因故暂停的原因 *" /><textarea aria-label="已采取措施" class="gap" value="{{measures}}" data-field="measures" bindinput="field" maxlength="2000" placeholder="已采取措施 *" /><view class="hint">暂停本身不扣分，也不会自动生成关注事项。</view></block><block wx:if="{{noteType < 3}}"><media-field campus-id="{{classes[classIndex].campusId}}" reset-key="{{mediaReset}}" disabled="{{busy || readOnly}}" bindchange="media" binduploading="uploadState" /><view wx:if="{{attachmentIds.length}}" class="row hint"><text>待提交 {{attachmentIds.length}} 个附件</text><button class="text-button" bindtap="clearFiles">清空附件</button></view></block><button class="primary gap" bindtap="record" loading="{{busy}}" disabled="{{busy || uploading || readOnly}}">为所选学生保存记录</button></view>
      <view wx:if="{{panel === 'review'}}" class="gap"><text class="label">先选择一项共同作业，再勾选学生</text><select-picker range="{{taskNames}}" value="{{taskIndex}}" bindchange="task" label="选择作业任务"><view class="form-pick">{{taskNames[taskIndex] || '当日暂无作业任务'}}</view></select-picker><view class="hint">切换任务会清空选择；每批仅处理同一项任务。</view><select-picker class="gap" range="{{reviewStatuses}}" value="{{reviewStatus}}" data-field="reviewStatus" bindchange="pick" label="选择批改结果"><view class="form-pick">{{reviewStatuses[reviewStatus]}}</view></select-picker><input aria-label="正确率" class="gap" type="number" value="{{accuracy}}" data-field="accuracy" bindinput="field" placeholder="共同正确率（0–100，不默认满分）" /><textarea aria-label="批改说明" class="gap" value="{{comment}}" data-field="comment" bindinput="field" maxlength="2000" placeholder="共同批改说明；退回订正时必填" /><view wx:for="{{reviewEntries}}" wx:key="id" class="override-row"><view class="row"><text>{{item.studentName}}</text><text class="status {{item.tone}}">{{item.statusText}}</text></view><view class="form-grid small-gap"><input aria-label="正确率" class="col" type="number" value="{{item.inputAccuracy}}" data-id="{{item.id}}" data-field="accuracy" bindinput="override" placeholder="单独正确率（可选）" /><input aria-label="批改说明" class="col" value="{{item.inputComment}}" data-id="{{item.id}}" data-field="comment" bindinput="override" maxlength="2000" placeholder="单独说明（可选）" /></view></view><view class="section-note">已选 {{selectedCount}} 人，此任务下可批改 {{reviewEntries.length}} 份。已完成或未布置该任务的学生不参与。</view><button class="primary" bindtap="review" loading="{{busy}}" disabled="{{busy || readOnly || !reviewEntries.length}}">核对并提交批改</button></view>
      <view wx:if="{{panel === 'summary'}}" class="gap"><button class="secondary" bindtap="generate" disabled="{{busy || readOnly}}">生成 / 刷新所选学生草稿</button><view wx:for="{{summaryPreviews}}" wx:key="id" class="summary-preview"><view class="row"><view class="card-title">{{item.studentName}}</view><text class="status {{item.status === 'PUBLISHED' ? 'green' : 'blue'}}">{{item.statusText}}</text></view><view class="body-text pre-line gap">{{item.contentText}}</view><view wx:for="{{item.openConcerns}}" wx:for-item="concern" wx:key="id" class="reason-box"><view>{{concern.title}} · {{concern.reason}}</view><view>措施：{{concern.measures}}</view></view><button wx:if="{{item.openConcerns.length && item.status !== 'PUBLISHED'}}" class="confirm-concern" data-id="{{item.studentId}}" bindtap="confirmConcern" aria-checked="{{item.confirmed}}" role="checkbox"><checkbox checked="{{item.confirmed}}" color="#1677ff" /><text>已核对该学生关注事项的原因和措施</text></button></view><view wx:if="{{!summaryPreviews.length}}" class="empty-inline">选择学生并生成草稿后，可在此逐份预览</view><button class="primary" bindtap="publish" loading="{{busy}}" disabled="{{busy || readOnly || !summaryPreviews.length}}">发布已审核小结 / 前往审核</button><view class="hint">草稿请前往每日小结编辑并提交审核，由另一位校长或老板审核后发布。</view></view>
    </view>
    <button wx:if="{{batchMode && classId}}" class="text-button gap" bindtap="openClassReport">班级日报 ›</button>
    <view wx:if="{{results.length}}" class="card gap"><view class="card-title">逐项处理结果</view><view wx:for="{{results}}" wx:key="studentId" class="detail-row"><text>{{item.name}}</text><text class="{{item.success ? 'result-ok' : 'result-fail'}}">{{item.message}}</text></view><view class="hint">成功项已取消选择，未完成项保留供核对重试。</view></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  </view>
</view>

<view wx:if="{{pickupAlertPreview}}" class="pickup-warning-scrim"><view class="pickup-warning" role="dialog" aria-label="异常接送提醒"><button class="warning-close" bindtap="dismissPickupAlert" aria-label="关闭异常提醒">关闭</button><image class="warning-icon" src="/assets/icons/summaries.svg" /><view class="warning-title">异常接送提醒</view><view class="warning-student">{{pickupAlertPreview.studentName}}</view><view class="warning-person">来接人：{{pickupAlertPreview.pickupName}}</view><view class="warning-reason">{{pickupAlertPreview.reason}}</view><view class="warning-note">请先联系监护人核对。异常处理完毕后，由老师现场拍照签退。</view><view class="actions"><button class="primary" bindtap="contactPickupGuardian">联系家长</button><button class="warning-hold" bindtap="holdPickup" disabled="{{busy}}" loading="{{busy}}">暂不离校</button></view><button class="text-button gap" data-id="{{pickupAlertPreview.studentId}}" bindtap="openPickupAlert">查看并处理接送异常 ›</button></view></view>
