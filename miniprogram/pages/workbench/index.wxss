@import "../../styles/growth.wxss";
.home-tabs { display:flex; gap:8rpx; padding:8rpx; margin:8rpx 0 24rpx; background:var(--subtle, #eef1ef); border-radius:24rpx; }
.home-tabs button { flex:1; min-width:0; width:auto; padding:16rpx 8rpx; margin:0; background:transparent; color:var(--secondary, #536168); font-size:28rpx; }.home-tabs button.active { color:var(--ink, #263238); background:var(--surface, #ffffff); box-shadow:none; }
.selection-bar { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:16rpx 0; }.selection-bar .text-button { width:auto; margin:0; font-size:24rpx; }
.roster-row { padding:24rpx; margin-bottom:16rpx; background:var(--surface, #ffffff); border-radius:32rpx; border:1rpx solid var(--line, #dce2df); }.row-selected { border-color:var(--line, #dce2df); background:var(--subtle, #eef1ef); }
.roster-identity { display:flex; align-items:center; gap:16rpx; }.roster-avatar { width:64rpx; height:64rpx; border-radius:24rpx; flex-shrink:0; }.avatar-letter { display:flex; align-items:center; justify-content:center; background:var(--subtle, #eef1ef); color:var(--muted, #68767c); font-size:28rpx; font-weight:600; }
.selection-toggle { width:auto; margin:0; background:transparent; padding:8rpx 0; }.selection-toggle checkbox { transform:scale(.8); }.student-link { color:var(--ink, #263238); font-weight:600; font-size:32rpx; background:transparent; padding:0; text-align:left; width:auto; margin:0; }
.homework-link { display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; margin:24rpx 0 0; padding:16rpx 0; background:transparent; text-align:left; font-size:24rpx; color:var(--accent, #176b91); }.homework-count { color:var(--ink, #263238); font-size:28rpx; margin-right:16rpx; }
.subject-summary { color:var(--secondary, #536168); font-size:24rpx; line-height:1.7; margin:0rpx 0 16rpx; word-break:break-word; }.roster-times { display:flex; flex-wrap:wrap; gap:32rpx; color:var(--secondary, #536168); font-size:24rpx; padding-bottom:24rpx; }.roster-actions { display:flex; gap:16rpx; }.roster-actions button { flex:1; min-width:0; width:auto; margin:0; padding:16rpx 8rpx; font-size:24rpx; }.concern-link { width:auto; margin:0 0 16rpx; padding:0; color:var(--danger, #b33740); background:transparent; text-align:left; font-size:24rpx; }.inbox-row { width:100%; margin:0; padding:16rpx 0; text-align:left; background:transparent; border-bottom:1rpx solid var(--line, #dce2df); }
.batch-panel { margin-top:24rpx; padding:24rpx; border-radius: 32rpx; background:var(--surface, #ffffff); }.action-grid { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:24rpx; }.action-grid button { flex:1 1 28%; min-width:0; padding:16rpx 8rpx; font-size:24rpx; }.active-action { color:var(--surface, #ffffff); background: var(--accent, #176b91); }.override-row { margin:16rpx 0; padding:16rpx; border-radius:24rpx; background:var(--subtle, #eef1ef); font-size:24rpx; }.override-row input { font-size:24rpx; min-width:0; }.summary-preview { margin:24rpx 0; padding:24rpx; border:1rpx solid var(--line, #dce2df); border-radius:24rpx; }.summary-preview .body-text { font-size:24rpx; }.confirm-concern { display:flex; align-items:center; gap:16rpx; color:var(--danger, #b33740); background:var(--subtle, #eef1ef); text-align:left; font-size:24rpx; padding:16rpx; margin-top:16rpx; line-height:1.7; }.workbench-page textarea { min-height:150rpx; }.workbench-page .detail-row { align-items:flex-start; }

.work-pickup-banner { display:flex;align-items:center;gap:16rpx;background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df);border-radius:24rpx;padding:24rpx;width:100%;text-align:left;color:var(--danger, #b33740);margin:16rpx 0;font-size:28rpx; }.work-pickup-banner image { width:46rpx;height:46rpx; }.work-pickup-banner text { display:block;font-size:24rpx;line-height:1.7;margin-top:8rpx; }
.pickup-warning-scrim { position:fixed;inset:0;z-index:90;background:rgba(25,36,57,.38);display:flex;align-items:center;justify-content:center;padding:40rpx; }.pickup-warning { position:relative;width:100%;max-width:660rpx;max-height:85vh;overflow-y:auto;background:var(--surface, #ffffff);border:2rpx solid var(--line, #dce2df);border-radius:32rpx;padding:48rpx 32rpx 32rpx;text-align:center;box-shadow:none; }.warning-close { position:absolute;top:12rpx;right:16rpx;background:transparent;color:var(--muted, #68767c);font-size:24rpx;padding:8rpx; }.warning-icon { width:86rpx;height:86rpx; }.warning-title { color:var(--danger, #b33740);font-size:36rpx;font-weight:600;margin:16rpx 0 24rpx; }.warning-student { background:var(--subtle, #eef1ef);color:var(--ink, #263238);border-radius:24rpx;padding:24rpx;font-size:32rpx;font-weight:600; }.warning-person { font-size:28rpx;margin:24rpx 0;color:var(--ink, #263238); }.warning-reason { text-align:left;background:var(--subtle, #eef1ef);color:var(--danger, #b33740);padding:24rpx;border-radius:24rpx;font-size:24rpx;line-height:1.8; }.warning-note { color:var(--muted, #68767c);font-size:24rpx;line-height:1.8;margin:24rpx 0 32rpx; }.warning-hold { background:var(--surface, #ffffff);color:var(--danger, #b33740);border:1rpx solid var(--line, #dce2df); }

.workbench-page .class-report-entry button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:24rpx;padding:16rpx 24rpx}

.workbench-summary { padding: 16rpx 0; color: var(--secondary, #536168); font-size: 28rpx; }
.student-roster .roster-row { margin: 0; padding: 16rpx 0 8rpx; border: 0; border-radius: 0; border-bottom: 1rpx solid var(--line, #dce2df); }
.student-roster .roster-row:last-child { border-bottom: 0; }
.student-roster .col { min-width: 0; overflow-wrap: anywhere; }
.roster-state { margin-left: 8rpx; font-size: 24rpx; font-weight: 400; color: var(--secondary, #536168); }
.roster-row .row-primary, .roster-row .row-more, .row-detail button { width: auto; margin: 0; min-height: 80rpx; flex-shrink: 0; }
.row-detail { padding: 8rpx 0; }
.row-detail button { display: inline-block; }


@import "../../styles/home.wxss";

.status-navigator { margin-bottom:16px; }
.status-tabs { display:flex; gap:16px; border-bottom:1px solid var(--line); margin-bottom:8px; }
.status-tab { min-height:44px; padding:10px 4px; margin:0; background:transparent; border-radius:0; color:var(--secondary); font-size:15px; border-bottom:2px solid transparent; }
.status-tab-active { color:var(--accent); border-bottom-color:var(--accent); font-weight:600; }
.status-tiles { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:6px; }
.status-tile { padding:10px 2px; min-height:64px; min-width:0; margin:0; border:1px solid transparent; border-radius:10px; background:transparent; color:var(--secondary); }
.status-tile-number { display:flex; align-items:center; justify-content:center; gap:4px; font-size:22px; font-weight:600; color:var(--ink); }
.status-tile-number image { width:17px; height:17px; flex-shrink:0; }
.status-tile-label { margin-top:4px; font-size:13px; line-height:1.5; overflow-wrap:anywhere; }
.status-tile-active { border-color:var(--accent); background:var(--accent-soft); color:var(--accent); }
.status-attention .status-tile-number { color:var(--danger); }
.status-caption { font-size:13px; line-height:1.6; color:var(--secondary); padding:8px 0; }
.role-home .selection-bar .status-all-active { font-weight:600; color:var(--accent); }
.roster-progress { height:5px; max-width:160px; background:var(--line); border-radius:3px; overflow:hidden; margin-top:6px; }
.roster-progress-fill { height:100%; background:var(--success); border-radius:3px; }
.roster-progress-note { margin-top:4px; font-size:13px; line-height:1.5; color:var(--secondary); }

.status-tiles-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }
.status-tiles-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
