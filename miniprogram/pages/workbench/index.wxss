@import "../../styles/growth.wxss";
.home-tabs { display:flex; gap:8rpx; padding:6rpx; margin:8rpx 0 22rpx; background:#eaeaf0; border-radius:24rpx; }
.home-tabs button { flex:1; min-width:0; width:auto; padding:16rpx 8rpx; margin:0; background:transparent; color:#737783; font-size:26rpx; }.home-tabs button.active { color:#1d1d1f; background:#fff; box-shadow:0 3rpx 12rpx rgba(29,29,31,.04); }
.selection-bar { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin:12rpx 0; }.selection-bar .text-button { width:auto; margin:0; font-size:24rpx; }
.roster-row { padding:24rpx; margin-bottom:18rpx; background:#fff; border-radius:28rpx; border:1rpx solid #eeeef3; }.row-selected { border-color:#b7d5f3; background:#f4f8ff; }
.roster-identity { display:flex; align-items:center; gap:16rpx; }.roster-avatar { width:64rpx; height:64rpx; border-radius:22rpx; flex-shrink:0; }.avatar-letter { display:flex; align-items:center; justify-content:center; background:#edf3fb; color:#5682b4; font-size:27rpx; font-weight:600; }
.selection-toggle { width:auto; margin:0; background:transparent; padding:8rpx 0; }.selection-toggle checkbox { transform:scale(.8); }.student-link { color:#1d1d1f; font-weight:600; font-size:30rpx; background:transparent; padding:0; text-align:left; width:auto; margin:0; }
.homework-link { display:flex; align-items:center; justify-content:space-between; gap:14rpx; width:100%; margin:20rpx 0 0; padding:18rpx 0; background:transparent; text-align:left; font-size:24rpx; color:#0071e3; }.homework-count { color:#333842; font-size:27rpx; margin-right:16rpx; }
.subject-summary { color:#737783; font-size:23rpx; line-height:1.7; margin:-4rpx 0 16rpx; word-break:break-word; }.roster-times { display:flex; flex-wrap:wrap; gap:28rpx; color:#737783; font-size:23rpx; padding-bottom:20rpx; }.roster-actions { display:flex; gap:14rpx; }.roster-actions button { flex:1; min-width:0; width:auto; margin:0; padding:17rpx 8rpx; font-size:25rpx; }.concern-link { width:auto; margin:0 0 14rpx; padding:0; color:#c74455; background:transparent; text-align:left; font-size:24rpx; }.inbox-row { width:100%; margin:0; padding:18rpx 0; text-align:left; background:transparent; border-bottom:1rpx solid #eeeef3; }
.batch-panel { margin-top:24rpx; padding:24rpx; border-radius: 30rpx; background:#fff; }.action-grid { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.action-grid button { flex:1 1 28%; min-width:0; padding:18rpx 8rpx; font-size:24rpx; }.active-action { color:#fff; background: #0071e3; }.override-row { margin:18rpx 0; padding:18rpx; border-radius:22rpx; background:#fafafd; font-size:25rpx; }.override-row input { font-size:22rpx; min-width:0; }.summary-preview { margin:22rpx 0; padding:22rpx; border:1rpx solid #e7e8ee; border-radius:26rpx; }.summary-preview .body-text { font-size:23rpx; }.confirm-concern { display:flex; align-items:center; gap:14rpx; color:#864456; background:#fff0f1; text-align:left; font-size:23rpx; padding:18rpx; margin-top:18rpx; line-height:1.7; }.workbench-page textarea { min-height:150rpx; }.workbench-page .detail-row { align-items:flex-start; }

.work-pickup-banner { display:flex;align-items:center;gap:16rpx;background:#fff0f1;border:1rpx solid #ffd9df;border-radius:24rpx;padding:20rpx;width:100%;text-align:left;color:#c42c45;margin:18rpx 0;font-size:26rpx; }.work-pickup-banner image { width:46rpx;height:46rpx; }.work-pickup-banner text { display:block;font-size:22rpx;line-height:1.7;margin-top:4rpx; }
.pickup-warning-scrim { position:fixed;inset:0;z-index:90;background:rgba(25,36,57,.38);display:flex;align-items:center;justify-content:center;padding:40rpx; }.pickup-warning { position:relative;width:100%;max-width:660rpx;max-height:85vh;overflow-y:auto;background:#fffafa;border:2rpx solid #ffb8c1;border-radius:34rpx;padding:46rpx 30rpx 30rpx;text-align:center;box-shadow:0 24rpx 80rpx rgba(66,28,37,.15); }.warning-close { position:absolute;top:12rpx;right:16rpx;background:transparent;color:#8792a5;font-size:22rpx;padding:8rpx; }.warning-icon { width:86rpx;height:86rpx; }.warning-title { color:#d62e45;font-size:35rpx;font-weight:650;margin:14rpx 0 24rpx; }.warning-student { background:#edf5ff;color:#223959;border-radius:22rpx;padding:24rpx;font-size:32rpx;font-weight:600; }.warning-person { font-size:27rpx;margin:24rpx 0;color:#3b4b66; }.warning-reason { text-align:left;background:#fff0f1;color:#bc3148;padding:20rpx;border-radius:20rpx;font-size:25rpx;line-height:1.8; }.warning-note { color:#8290a7;font-size:23rpx;line-height:1.8;margin:20rpx 0 28rpx; }.warning-hold { background:#fff;color:#d62e45;border:1rpx solid #f1a8b4; }

.workbench-page .class-report-entry button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:23rpx;padding:18rpx 20rpx}

.workbench-summary { padding: 18rpx 0; color: #586174; font-size: 26rpx; }
.student-roster .roster-row { margin: 0; padding: 18rpx 0 8rpx; border: 0; border-radius: 0; border-bottom: 1rpx solid #eeeef3; }
.student-roster .roster-row:last-child { border-bottom: 0; }
.student-roster .col { min-width: 0; overflow-wrap: anywhere; }
.roster-state { margin-left: 8rpx; font-size: 24rpx; font-weight: 400; color: #586174; }
.roster-row .row-primary, .roster-row .row-more, .row-detail button { width: auto; margin: 0; min-height: 80rpx; flex-shrink: 0; }
.row-detail { padding: 10rpx 0; }
.row-detail button { display: inline-block; }
