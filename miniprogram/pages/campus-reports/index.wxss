.report-filter{display:flex;flex-direction:column;gap:16rpx}.report-overview{display:flex;gap:16rpx;margin:24rpx 0}.report-overview>view{flex:1;min-width:0;padding:32rpx 16rpx;border-radius:32rpx;background:var(--subtle, #eef1ef)}.report-overview>view:nth-child(2){background:var(--subtle, #eef1ef)}.report-overview>view:nth-child(3){background:var(--subtle, #eef1ef)}.report-overview text{display:block;font-size:24rpx;line-height:1.8;color:var(--muted, #68767c)}.report-overview text:first-child{font-size:36rpx;font-weight:600;color:var(--ink, #263238);margin-bottom:16rpx}.report-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:28rpx;line-height:1.95;color:var(--secondary, #536168);margin-top:24rpx}.report-label{font-size:28rpx;color:var(--muted, #68767c);font-weight:600;margin-top:32rpx}.report-footer{font-size:24rpx;line-height:1.9;color:var(--muted, #68767c);padding-top:24rpx;margin-top:32rpx;border-top:1rpx solid var(--line, #dce2df)}.report-actions{display:flex;gap:16rpx;margin-top:32rpx}.report-actions button{flex:1;min-width:0}.report-editor textarea{height:220rpx;min-height:180rpx}.report-class-stats{font-size:24rpx;line-height:1.8;color:var(--muted, #68767c);margin:24rpx 0}.teacher-note{background:var(--subtle, #eef1ef);border-radius:24rpx;padding:24rpx;margin-top:24rpx}.principal-comment{border-top:1rpx solid var(--line, #dce2df);margin-top:24rpx;padding-top:24rpx}.campus-report-page .campus-class-card .row button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:24rpx;padding:16rpx 24rpx}
