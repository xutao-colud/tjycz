.report-filter{display:flex;flex-direction:column;gap:18rpx}.report-overview{display:flex;gap:14rpx;margin:24rpx 0}.report-overview>view{flex:1;min-width:0;padding:30rpx 16rpx;border-radius:30rpx;background:#edf4fd}.report-overview>view:nth-child(2){background:#edf8f2}.report-overview>view:nth-child(3){background:#f6f0fc}.report-overview text{display:block;font-size:20rpx;line-height:1.8;color:#8292a7}.report-overview text:first-child{font-size:37rpx;font-weight:650;color:#24344d;margin-bottom:14rpx}.report-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:27rpx;line-height:1.95;color:#657287;margin-top:24rpx}.report-label{font-size:26rpx;color:#52769d;font-weight:600;margin-top:32rpx}.report-footer{font-size:23rpx;line-height:1.9;color:#96a0af;padding-top:25rpx;margin-top:28rpx;border-top:1rpx solid #edf0f5}.report-actions{display:flex;gap:18rpx;margin-top:28rpx}.report-actions button{flex:1;min-width:0}.report-editor textarea{height:220rpx;min-height:180rpx}.report-class-stats{font-size:23rpx;line-height:1.8;color:#8292a7;margin:24rpx 0}.teacher-note{background:#f6f8fc;border-radius:24rpx;padding:24rpx;margin-top:20rpx}.principal-comment{border-top:1rpx solid #edf0f5;margin-top:24rpx;padding-top:20rpx}.campus-report-page .campus-class-card .row button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:23rpx;padding:18rpx 20rpx}
