<app-nav />
<view class="page homework-detail"><view class="detail-heading">作业详情</view>
  <view class="subject-tabs"><button wx:for="{{subjects}}" wx:key="*this" class="subject-tab {{subject === item ? 'subject-selected' : ''}}" data-subject="{{item}}" bindtap="chooseSubject">{{item}}</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view hidden="{{loading || error}}">
    <view wx:if="{{subjectTasks.length > 1}}" class="chips"><button wx:for="{{subjectTasks}}" wx:key="id" class="chip {{item.id === queryId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTask">{{item.title}}</button></view>
    <view wx:if="{{!subjectTasks.length}}" class="card empty-inline">当日未布置该学科作业</view>
    <view wx:if="{{item && subjectTasks.length}}">
      <view wx:if="{{readOnly}}" class="notice">未来日期仅查看安排，暂不能更新进度。</view>
      <view class="card assignment-card"><view class="row"><view class="assignment-heading"><image class="subject-icon" src="/assets/icons/{{item.type === 'ORAL' ? 'mic' : 'homework'}}.png" /><view class="card-title">{{item.subject}}作业</view></view><text class="status {{item.tone}}">{{item.statusText}}</text></view><view class="assignment-title">{{item.title}}</view><view class="section-note">{{item.studentName}} · {{item.className}} · {{item.date}}</view><view class="timestamp">{{item.status === 'COMPLETED' ? '完成时间：' + item.completedText : item.reviewedAt ? '最近批改：' + item.reviewedText : item.submittedAt ? '提交时间：' + item.submittedText : '尚无提交记录'}}</view><view wx:if="{{item.later}}" class="hint">含后续处理 · 作业归属日期 {{item.date}}</view>
        <view wx:if="{{item.comment || item.accuracy === 0 || item.accuracy}}" class="teacher-feedback"><view class="row"><view class="feedback-name">{{item.reviewerName || '老师反馈'}}</view><text wx:if="{{item.accuracy === 0 || item.accuracy}}" class="muted mini">正确率 {{item.accuracy}}%</text></view><view class="body-text">{{item.comment || '老师已检查确认'}}</view></view>
        <file-list files="{{item.attachments}}" />
        <view class="assignment-content"><view class="content-title">作业内容</view><view class="body-text">{{item.description || '老师未补充文字说明，请结合所布置任务完成。'}}</view></view>
        <view wx:if="{{item.status === 'CORRECTION' || item.mistakes.length}}" class="correction-box"><view class="content-title">订正与错题</view><view class="body-text">{{item.status === 'CORRECTION' ? item.comment : '以下为老师登记的相关错题'}}</view><button wx:for="{{item.mistakes}}" wx:key="id" class="mistake-link" data-id="{{item.id}}" bindtap="mistake">{{item.title}} · {{item.knowledgePoint}} ›</button><view wx:if="{{!item.mistakes.length}}" class="hint">按老师的具体要求订正即可。</view></view>
      </view>
      <view wx:if="{{!readOnly && ((!teacher && (item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS')) || item.status === 'CORRECTION')}}" class="card"><view class="card-title">{{item.status === 'CORRECTION' ? '提交本次订正' : '提交作业'}}</view><textarea aria-label="本次提交说明" class="gap" value="{{submissionText}}" data-field="submissionText" bindinput="field" maxlength="2000" placeholder="填写完成情况或具体订正说明" /><media-field campus-id="{{item.campusId}}" audio-enabled="{{item.type === 'ORAL'}}" reset-key="{{mediaReset}}" disabled="{{busy}}" bindchange="media" binduploading="uploadState" /><view wx:if="{{attachmentIds.length}}" class="row hint"><text>本次待提交 {{attachmentIds.length}} 个附件</text><button class="text-button" bindtap="clearFiles">清空附件</button></view><button class="primary gap" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploading}}">{{item.status === 'CORRECTION' ? '提交订正，等待复核' : '提交老师批改'}}</button><view class="hint">说明和附件一并提交；未提交内容保留为本机草稿。</view></view>
      <view wx:if="{{teacher && item.status !== 'COMPLETED' && !readOnly}}" class="card"><view class="card-title">教师批改</view><view class="section-note">可在现场检查后直接确认，无需家长重复提交。</view><view wx:if="{{item.status === 'NOT_STARTED' || item.status === 'IN_PROGRESS'}}" class="actions"><button wx:if="{{item.status === 'NOT_STARTED'}}" class="secondary" data-status="IN_PROGRESS" bindtap="progress" disabled="{{busy}}">开始辅导</button><button class="secondary" data-status="PENDING_REVIEW" bindtap="progress" disabled="{{busy}}">标记待批改</button></view><view class="field gap"><text class="label">正确率 *（0–100的整数）</text><input aria-label="正确率" type="number" value="{{accuracy}}" data-field="accuracy" bindinput="field" placeholder="请按实际检查结果填写" /></view><view class="field"><text class="label">批改说明 / 订正要求</text><textarea aria-label="批改说明" value="{{comment}}" data-field="comment" bindinput="field" maxlength="2000" placeholder="退回订正时，请说明具体问题" /></view><view class="actions"><button class="danger" data-status="CORRECTION" bindtap="review" disabled="{{busy}}">需订正</button><button class="primary" data-status="COMPLETED" bindtap="review" disabled="{{busy}}">检查完成</button></view><button wx:if="{{nextReady}}" class="text-button" data-status="COMPLETED" data-next="1" bindtap="review" disabled="{{busy}}">提交并查看下一份</button><button class="text-button gap" bindtap="follow">需要额外跟进？登记关注事项 ›</button></view>
      <view class="card"><view class="card-title">提交与批改历史</view><view wx:for="{{item.history}}" wx:key="id" class="history-entry"><view class="row"><view class="feedback-name">{{item.actorName}} · {{item.actionText}}</view><text class="status {{item.tone}}">{{item.statusText}}</text></view><view class="hint">{{item.fullTime}}</view><view class="body-text small-gap">{{item.detail}}</view><file-list files="{{item.attachments}}" /></view><view wx:if="{{!item.history.length}}" class="empty-inline">历史过程未记录，以上展示当前最新结果。</view></view>
      <button class="secondary return-growth" bindtap="backGrowth">返回当日成长</button>
    </view><view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  </view>
</view>
