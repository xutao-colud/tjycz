@import "../../styles/growth.wxss";
.detail-heading { text-align:center; font-size:36rpx; color:var(--ink, #263238); font-weight:600; margin:8rpx 0 24rpx; }.subject-tabs { display:flex; gap:16rpx; margin:0 0rpx 24rpx; border-bottom:1rpx solid var(--line, #dce2df);  background: var(--subtle, #eef1ef); border: 0; border-radius: 24rpx; padding: 8rpx;}.subject-tab { flex:1; min-width:0; background:transparent; color:var(--secondary, #536168); padding: 16rpx 8rpx; border-radius: 16rpx; font-size:28rpx; }.subject-selected { color: var(--ink, #263238); border-bottom: 0; font-weight:600;  background: var(--surface, #ffffff); box-shadow: none;}
.homework-detail .card { padding:24rpx; border-radius:32rpx; }.assignment-heading { display:flex; align-items:center; gap:16rpx; }.subject-icon { width:62rpx; height:62rpx; }.assignment-title { color:var(--ink, #263238); font-size:28rpx; font-weight:600; margin-top:16rpx; line-height:1.7; }.timestamp { color:var(--secondary, #536168); font-size:24rpx; margin:8rpx 0 16rpx; }.teacher-feedback { background: var(--subtle, #eef1ef); border-radius: 24rpx; padding:24rpx; margin:16rpx 0; }.feedback-name { font-size:24rpx; font-weight:600; color:var(--ink, #263238); }.teacher-feedback .body-text { font-size:24rpx; margin-top:8rpx; }
.assignment-content { padding:24rpx; background: var(--subtle, #eef1ef); border-radius: 24rpx; margin-top:24rpx; }.content-title { font-size:24rpx; color:var(--ink, #263238); font-weight:600; margin-bottom:8rpx; }.correction-box { background:var(--subtle, #eef1ef); padding:24rpx; margin-top:16rpx; border-radius:24rpx; }.correction-box .content-title { color:var(--danger, #b33740); }.correction-box .body-text { color:var(--danger, #b33740); }.mistake-link { background:transparent; color:var(--accent, #176b91); text-align:left; font-size:24rpx; padding:16rpx 0; line-height:1.7; }.history-entry { margin-top:24rpx; padding-top:24rpx; border-top:1rpx solid var(--line, #dce2df); }.return-growth { width:100%; padding:24rpx; margin-top:24rpx; }.homework-detail textarea { min-height:160rpx; }

.homework-detail .subject-tabs { background:transparent;border-bottom:1rpx solid var(--line, #dce2df);border-radius:0;padding:0;gap:16rpx; }.homework-detail .subject-selected { color:var(--accent, #176b91);background:transparent;border-bottom:4rpx solid var(--muted, #68767c);border-radius:0;box-shadow:none; }.homework-detail .teacher-feedback { background:var(--subtle, #eef1ef); }.homework-detail .assignment-content { background:var(--subtle, #eef1ef); }.homework-detail .correction-box { background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df); }.homework-detail .return-growth { background:var(--subtle, #eef1ef);color:var(--accent, #176b91); }
