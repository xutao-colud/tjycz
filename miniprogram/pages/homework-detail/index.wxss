@import "../../styles/growth.wxss";
.detail-heading { text-align:center; font-size:34rpx; color:#1d1d1f; font-weight:650; margin:8rpx 0 22rpx; }.subject-tabs { display:flex; gap:12rpx; margin:0 -4rpx 24rpx; border-bottom:1rpx solid #e7e8ee;  background: #eaeaef; border: 0; border-radius: 24rpx; padding: 6rpx;}.subject-tab { flex:1; min-width:0; background:transparent; color:#737783; padding: 15rpx 5rpx; border-radius: 18rpx; font-size:28rpx; }.subject-selected { color: #1d1d1f; border-bottom: 0; font-weight:600;  background: #fff; box-shadow: 0 3rpx 12rpx rgba(29,29,31,.06);}
.homework-detail .card { padding:26rpx; border-radius:32rpx; }.assignment-heading { display:flex; align-items:center; gap:16rpx; }.subject-icon { width:62rpx; height:62rpx; }.assignment-title { color:#1d1d1f; font-size:29rpx; font-weight:600; margin-top:18rpx; line-height:1.7; }.timestamp { color:#737783; font-size:23rpx; margin:8rpx 0 18rpx; }.teacher-feedback { background: #f4f4f8; border-radius: 24rpx; padding:20rpx; margin:18rpx 0; }.feedback-name { font-size:25rpx; font-weight:600; color:#50535d; }.teacher-feedback .body-text { font-size:24rpx; margin-top:8rpx; }
.assignment-content { padding:20rpx; background: #f4f4f8; border-radius: 24rpx; margin-top:20rpx; }.content-title { font-size:25rpx; color:#1d1d1f; font-weight:600; margin-bottom:10rpx; }.correction-box { background:#fff0f1; padding:20rpx; margin-top:18rpx; border-radius:26rpx; }.correction-box .content-title { color:#c72b43; }.correction-box .body-text { color:#8a5461; }.mistake-link { background:transparent; color:#0071e3; text-align:left; font-size:24rpx; padding:12rpx 0; line-height:1.7; }.history-entry { margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid #e7e8ee; }.return-growth { width:100%; padding:24rpx; margin-top:20rpx; }.homework-detail textarea { min-height:160rpx; }

.homework-detail .subject-tabs { background:transparent;border-bottom:1rpx solid #ecf1f9;border-radius:0;padding:0;gap:16rpx; }.homework-detail .subject-selected { color:#1677ff;background:transparent;border-bottom:4rpx solid #1677ff;border-radius:0;box-shadow:none; }.homework-detail .teacher-feedback { background:#f0f6ff; }.homework-detail .assignment-content { background:#f2f7ff; }.homework-detail .correction-box { background:#fff0f1;border:1rpx solid #ffe6e8; }.homework-detail .return-growth { background:#edf5ff;color:#1677ff; }
