<app-nav />
<view class="page follow-page"><view class="hero"><view class="title">{{id ? (kind === 'ISSUE' ? '事项跟进' : '家校沟通') : '关注与沟通'}}</view><view class="subtitle">情况有记录，处理有回应</view></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view hidden="{{loading || error}}">
    <block wx:if="{{!id}}">
      <view class="filter-bar"><select-picker class="filter-item" range="{{childNames}}" value="{{childIndex}}" bindchange="child" label="选择学生" plain="{{true}}"><view class="filter-value">{{childNames[childIndex] || '暂无学生'}} ⌄</view></select-picker><date-picker value="{{date}}" bindchange="changeDate"><view class="filter-value">{{date}} ⌄</view></date-picker></view>
      <view class="row"><view class="chips"><button class="chip {{kind === 'ISSUE' ? 'active' : ''}}" data-kind="ISSUE" bindtap="kind">关注事项</button><button class="chip {{kind === 'MESSAGE' ? 'active' : ''}}" data-kind="MESSAGE" bindtap="kind">普通留言</button></view><select-picker range="{{stateNames}}" value="{{stateIndex}}" bindchange="filter" plain="{{true}}" label="筛选处理状态"><view class="filter-pill">{{stateNames[stateIndex]}} ⌄</view></select-picker></view>
      <view wx:if="{{readOnly}}" class="notice">未来日期仅可查看，不能登记已发生的事项。</view>
      <button wx:if="{{students.length && !readOnly && (teacher || kind === 'MESSAGE')}}" class="secondary" bindtap="toggleCompose">{{compose ? '收起填写区' : kind === 'ISSUE' ? '登记关注事项' : teacher ? '发作业消息' : '给老师留言'}}</button>
      <view wx:if="{{compose && studentId && !readOnly && (teacher || kind === 'MESSAGE')}}" class="card compose-card">
        <view class="card-title">{{kind === 'ISSUE' ? '登记需要额外跟进的情况' : teacher ? '写下孩子的作业反馈' : '写下想与老师沟通的内容'}}</view>
        <view wx:if="{{kind === 'MESSAGE'}}" class="section-note">{{teacher ? '孩子的绑定家长可在小程序中查看与回复。' : '留言会交给该班老师，在小程序内查看与回复。'}}</view>
        <view wx:if="{{teacher && kind === 'MESSAGE' && isToday}}" class="switch-row"><text>设为明日提醒</text><switch checked="{{tomorrowReminder}}" bindchange="setTomorrow" color="#1677ff" /></view>
        <block wx:if="{{kind === 'ISSUE'}}"><view class="field"><text class="label">事项类型</text><select-picker range="{{types}}" value="{{typeIndex}}" bindchange="type" label="选择事项类型"><view class="form-pick">{{types[typeIndex]}}</view></select-picker></view><view class="field"><text class="label">标题 *</text><input aria-label="事项标题" value="{{title}}" data-field="title" bindinput="field" maxlength="200" placeholder="例如：数学作业需要继续辅导" /></view></block>
        <view class="field"><text class="label">{{kind === 'ISSUE' ? '具体情况 / 原因 *' : '留言内容 *'}}</text><textarea aria-label="具体情况或暂停原因" value="{{reason}}" data-field="reason" bindinput="field" maxlength="2000" placeholder="请说明具体情况" /></view>
        <block wx:if="{{kind === 'ISSUE'}}"><view class="field"><text class="label">已采取措施 *</text><textarea aria-label="已采取措施" value="{{measures}}" data-field="measures" bindinput="field" maxlength="2000" placeholder="已做了哪些处理或辅导" /></view><view class="switch-row"><text>需要家长配合</text><switch checked="{{needsParent}}" bindchange="needs" color="#1677ff" /></view><view wx:if="{{needsParent}}" class="field"><text class="label">请家长配合的事项 *</text><textarea aria-label="请家长配合的事项" value="{{parentAction}}" data-field="parentAction" bindinput="field" maxlength="2000" /></view><view class="field"><text class="label">下次反馈时间（可选）</text><input aria-label="预计反馈时间" value="{{nextFeedbackAt}}" data-field="nextFeedbackAt" bindinput="field" placeholder="例如 2026-10-28T19:00" /></view><view wx:if="{{admin && owners.length}}" class="field"><text class="label">负责人（默认本人）</text><select-picker range="{{ownerNames}}" bindchange="owner" value="{{ownerIndex}}" label="选择负责老师"><view class="form-pick">{{ownerId ? ownerNames[ownerIndex] : '本人'}}</view></select-picker></view></block>
        <media-field campus-id="{{students[childIndex].campusId}}" reset-key="{{mediaReset}}" disabled="{{busy}}" bindchange="media" binduploading="uploadState" />
        <view wx:if="{{attachmentIds.length}}" class="row section-note"><text>本次待提交 {{attachmentIds.length}} 个附件</text><button class="text-button" bindtap="clearFiles">清空附件</button></view>
        <button class="primary gap" bindtap="create" loading="{{busy}}" disabled="{{busy || uploading}}">{{kind === 'ISSUE' ? '保存并开始跟进' : '提交留言'}}</button>
        <view class="hint">未提交内容按学生和日期保存为本机草稿</view>
      </view>
      <button wx:for="{{rows}}" wx:key="id" class="card follow-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="card-title col">{{item.title}}</view><text class="status {{item.tone}}">{{item.statusText}}</text></view><view class="body-text small-gap">{{item.reason}}</view><view wx:if="{{kind === 'ISSUE'}}" class="reason-box">已采取措施：{{item.measures}}</view><view class="row hint"><text>{{item.ownerName}} · {{item.studentName}}</text><text>查看记录 ›</text></view></button>
      <view wx:if="{{!rows.length}}" class="card empty-inline">{{kind === 'ISSUE' ? '该日期暂无此状态的关注事项' : '暂无此状态的家校留言'}}</view>
    </block>
    <block wx:if="{{detail}}">
      <view class="card"><view class="row"><view class="card-title col">{{detail.title}}</view><text class="status {{detail.tone}}">{{detail.statusText}}</text></view><view class="section-note">{{detail.studentName}} · {{detail.campusName}} · {{detail.businessDate}}</view><view class="body-text">{{detail.reason}}</view><view wx:if="{{detail.kind === 'ISSUE'}}" class="reason-box"><view>已采取措施：{{detail.measures}}</view><view wx:if="{{detail.needsParent}}">请家长配合：{{detail.parentAction}}</view></view><view class="section-note">负责人：{{detail.ownerName}}<text wx:if="{{detail.nextFeedbackAt}}"> · 预计反馈 {{detail.nextFeedbackText}}</text></view><button class="text-button" bindtap="markRead" disabled="{{busy}}">{{read ? '已标记查看' : '标记已读'}}</button></view>
      <view class="section-title">沟通与处理记录</view>
      <view wx:for="{{detail.logs}}" wx:key="id" class="card log-card {{item.isParent ? 'parent-log' : ''}}"><view class="row"><view class="log-name">{{item.actorName}} · {{item.actionText}}</view><text class="muted mini">{{item.timeText}}</text></view><view class="body-text small-gap">{{item.text}}</view><file-list files="{{item.attachments}}" /><view class="hint">{{item.isParent ? (item.readByStaff ? '老师已查看' : '待老师查看') : (item.readByParent ? '家长已查看' : '待家长查看')}}</view></view>
      <view wx:if="{{detail.status !== 'CANCELLED'}}" class="card"><view class="card-title">补充反馈</view><textarea aria-label="补充反馈" class="gap" value="{{replyText}}" data-field="replyText" bindinput="field" maxlength="2000" placeholder="请填写具体反馈或已配合的情况" /><media-field campus-id="{{detail.campusId}}" reset-key="{{mediaReset}}" disabled="{{busy}}" bindchange="media" binduploading="uploadState" /><view wx:if="{{attachmentIds.length}}" class="row hint"><text>待提交 {{attachmentIds.length}} 个附件</text><button class="text-button" bindtap="clearFiles">清空附件</button></view><view class="actions"><button wx:if="{{!teacher}}" class="secondary" data-action="ACK" bindtap="reply" disabled="{{busy || uploading}}">已了解</button><button class="primary" data-action="REPLY" bindtap="reply" disabled="{{busy || uploading}}">提交反馈</button><button wx:if="{{!teacher && detail.needsParent}}" class="secondary" data-action="PARENT_DONE" bindtap="reply" disabled="{{busy || uploading}}">已配合，待核实</button></view><view wx:if="{{!teacher}}" class="hint">家长反馈后由负责老师核实，不会自动结束事项。</view></view>
      <view wx:if="{{teacher && detail.canManage && detail.status !== 'CANCELLED'}}" class="card"><view class="card-title">处理进展</view><textarea aria-label="处理结果或变更原因" class="gap" value="{{processText}}" data-field="processText" bindinput="field" maxlength="2000" placeholder="填写处理措施、核实结果，或重开 / 撤销原因" /><view class="actions"><button wx:if="{{detail.status === 'OPEN' || detail.status === 'RESOLVED'}}" class="primary" data-status="IN_PROGRESS" bindtap="update" disabled="{{busy}}">{{detail.status === 'RESOLVED' ? '重新跟进' : '开始处理'}}</button><button wx:if="{{detail.status === 'IN_PROGRESS'}}" class="primary" data-status="RESOLVED" bindtap="update" disabled="{{busy}}">核实后解决</button><button wx:if="{{detail.status !== 'RESOLVED' && (admin || user.id === detail.createdBy)}}" class="danger" data-status="CANCELLED" bindtap="update" disabled="{{busy}}">撤销事项</button></view></view>
      <view wx:if="{{admin && owners.length && detail.status !== 'CANCELLED'}}" class="card"><view class="card-title">调整负责人</view><select-picker class="gap" range="{{ownerNames}}" value="{{ownerIndex}}" bindchange="owner" label="选择负责老师"><view class="form-pick">{{ownerId ? ownerNames[ownerIndex] : '请选择老师'}}</view></select-picker><input aria-label="负责人调整原因" class="gap" value="{{ownerReason}}" data-field="ownerReason" bindinput="field" maxlength="2000" placeholder="调整原因" /><button class="secondary gap" bindtap="reassign" disabled="{{busy}}">确认调整</button></view>
    </block>
    <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  </view>
</view>
