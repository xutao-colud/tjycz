.report-filter{display:flex;flex-direction:column;gap:16rpx}.report-overview{display:flex;gap:16rpx;margin:24rpx 0}.report-overview>view{flex:1;min-width:0;padding:32rpx 16rpx;border-radius:32rpx;background:var(--subtle, #eef1ef);color:var(--accent, #176b91)}.report-overview>view:nth-child(2){background:var(--subtle, #eef1ef);color:var(--success, #23734e)}.report-overview>view:nth-child(3){background:var(--subtle, #eef1ef);color:var(--muted, #68767c)}.report-overview text{display:block;font-size:24rpx;line-height:1.8}.report-overview text:first-child{font-size:40rpx;font-weight:600;color:var(--ink, #263238);margin-bottom:16rpx}.report-caption{margin:16rpx 8rpx 24rpx}.report-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:28rpx;line-height:1.95;color:var(--secondary, #536168);margin-top:24rpx}.report-label{font-size:28rpx;color:var(--muted, #68767c);font-weight:600;margin-top:32rpx}.report-footer{font-size:24rpx;line-height:1.9;color:var(--muted, #68767c);padding:24rpx 0;margin-top:32rpx;border-top:1rpx solid var(--line, #dce2df)}.report-actions{display:flex;gap:16rpx;margin-top:32rpx}.report-actions button{flex:1;min-width:0}.report-empty{text-align:center;padding:48rpx 32rpx}.report-empty image{width:78rpx;height:78rpx;margin-bottom:32rpx}.report-empty .hint{margin:24rpx 0 40rpx;line-height:1.9}.report-editor textarea{height:220rpx;min-height:180rpx}

.class-report-page .class-comments .row button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:24rpx;padding:16rpx 24rpx}.class-comment{border-top:1rpx solid var(--line, #dce2df);margin-top:24rpx;padding-top:24rpx}
