.report-filter{display:flex;flex-direction:column;gap:18rpx}.report-overview{display:flex;gap:14rpx;margin:24rpx 0}.report-overview>view{flex:1;min-width:0;padding:30rpx 16rpx;border-radius:30rpx;background:#edf4fd;color:#4a82ba}.report-overview>view:nth-child(2){background:#edf8f2;color:#459672}.report-overview>view:nth-child(3){background:#f6f0fc;color:#9274b5}.report-overview text{display:block;font-size:21rpx;line-height:1.8}.report-overview text:first-child{font-size:39rpx;font-weight:650;color:#24344d;margin-bottom:14rpx}.report-caption{margin:18rpx 5rpx 26rpx}.report-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:27rpx;line-height:1.95;color:#657287;margin-top:26rpx}.report-label{font-size:26rpx;color:#52769d;font-weight:600;margin-top:34rpx}.report-footer{font-size:23rpx;line-height:1.9;color:#96a0af;padding:26rpx 0;margin-top:30rpx;border-top:1rpx solid #edf0f5}.report-actions{display:flex;gap:18rpx;margin-top:30rpx}.report-actions button{flex:1;min-width:0}.report-empty{text-align:center;padding:46rpx 30rpx}.report-empty image{width:78rpx;height:78rpx;margin-bottom:28rpx}.report-empty .hint{margin:24rpx 0 36rpx;line-height:1.9}.report-editor textarea{height:220rpx;min-height:180rpx}

.class-report-page .class-comments .row button{width:auto;min-width:0;margin:0;flex-shrink:0;font-size:23rpx;padding:18rpx 20rpx}.class-comment{border-top:1rpx solid #edf0f5;margin-top:26rpx;padding-top:20rpx}
