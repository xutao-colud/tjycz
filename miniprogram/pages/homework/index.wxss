.homework-hero{display:flex;align-items:center;justify-content:space-between;gap:22rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.homework-filter{padding:24rpx}
.date-filter{display:flex;align-items:center;gap:24rpx;padding-bottom:20rpx;border-bottom:1rpx solid #e7e8ee}
.date-filter .filter-label{font-size:23rpx;flex-shrink:0}
.date-picker{flex:1;min-width:0}
.date-value{display:flex;align-items:center;justify-content:flex-end;gap:24rpx;color:#1d1d1f;font-size:26rpx;font-weight:500}
.subject-filters{display:flex;margin-top:20rpx;gap:24rpx}
.filter-half{flex:1;min-width:0}
.filter-half + .filter-half{padding-left:24rpx;border-left:1rpx solid #e7e8ee}
.filter-choice{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#50535d;font-size:25rpx}
.filter-choice > text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.created-notice{padding:18rpx 24rpx;background:#e8f8f2;color:#25a781;border-radius:26rpx;font-size:24rpx;margin-bottom:18rpx}
.create-entry{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx;border:1rpx solid #e7e8ee}
.create-entry-main{display:flex;align-items:center;gap:18rpx;min-width:0}
.create-plus{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;flex-shrink:0;border-radius:19rpx;background:#f4f4f7;color:#0071e3;font-size:41rpx;line-height:1;font-weight:400}
.create-entry-title{font-size:28rpx;font-weight:600;color:#1d1d1f;line-height:1.5}
.create-entry-subtitle{color:#737783;font-size:22rpx;margin-top:3rpx}
.create-toggle{color:#0071e3;font-size:24rpx;white-space:nowrap}
.create-arrow{margin-left:12rpx;font-size:32rpx;vertical-align:-2rpx}
.form-heading{margin-bottom:18rpx}
.form-heading .hint{margin-top:0}
.form-pickers{display:flex;gap:18rpx;margin-bottom:18rpx}
.form-pickers select-picker{font-size:25rpx}
.create-form textarea{min-height:170rpx}
.required{color:#0071e3;margin-left:4rpx}
.task-list-head{margin:24rpx 2rpx 18rpx}
.task-list-head .hint{margin-top:0}
.homework-card{padding:24rpx}
.task-top{display:flex;align-items:center;gap:18rpx}
.subject-icon{width:78rpx;height:78rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:33rpx;font-weight:600;line-height:1;flex-shrink:0}
.subject-chinese{color:#e79b45;background:#fff1dc}
.subject-math{color:#0071e3;background:#f4f4f7}
.subject-english{color:#9f7cde;background:#f1ebff;font-size:29rpx}
.subject-other{color:#25ad85;background:#e5f8ef}
.task-subject{flex:1;min-width:0}
.subject-name{font-size:28rpx;font-weight:600;color:#1d1d1f}
.task-type{font-size:22rpx;color:#737783;margin-top:2rpx}
.task-status{display:inline-block;border-radius:14rpx;padding:6rpx 15rpx;font-size:22rpx;line-height:1.5;white-space:nowrap}
.status-waiting{color:#737783;background:#f4f4f7}
.status-progressing{color:#0071e3;background:#f4f4f7}
.status-review{color:#d99b40;background:#fff4df}
.status-correction{color:#e38a63;background:#fff0e8}
.status-done{color:#25ae85;background:#e7f8f0}
.task-title{font-size:30rpx;font-weight:600;line-height:1.6;color:#1d1d1f;margin-top:18rpx;word-break:break-all}
.task-student{display:flex;align-items:center;flex-wrap:wrap;color:#737783;font-size:24rpx;margin-top:12rpx}
.student-dot{width:10rpx;height:10rpx;display:inline-block;border-radius:50%;background:#b7c7db;margin-right:12rpx}
.student-class{color:#737783;white-space:pre-wrap}
.task-description{color:#737783;font-size:25rpx;line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:14rpx;word-break:break-all;white-space:pre-wrap}
.task-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-top:1rpx solid #e7e8ee;margin-top:18rpx;padding-top:20rpx}
.task-date{color:#9295a0;font-size:22rpx}
.task-link{color:#0071e3;font-size:24rpx}
.task-arrow{margin-left:12rpx;font-size:30rpx;vertical-align:-1rpx}

.title { font-size: 34rpx; }
