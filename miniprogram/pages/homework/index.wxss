.homework-hero{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.homework-filter{padding:24rpx}
.date-filter{display:flex;align-items:center;gap:24rpx;padding-bottom:24rpx;border-bottom:1rpx solid var(--line, #dce2df)}
.date-filter .filter-label{font-size:24rpx;flex-shrink:0}
.date-picker{flex:1;min-width:0}
.date-value{display:flex;align-items:center;justify-content:flex-end;gap:24rpx;color:var(--ink, #263238);font-size:28rpx;font-weight:500}
.subject-filters{display:flex;margin-top:24rpx;gap:24rpx}
.filter-half{flex:1;min-width:0}
.filter-half + .filter-half{padding-left:24rpx;border-left:1rpx solid var(--line, #dce2df)}
.filter-choice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:var(--ink, #263238);font-size:24rpx}
.filter-choice > text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.created-notice{padding:16rpx 24rpx;background:var(--subtle, #eef1ef);color:var(--success, #23734e);border-radius:24rpx;font-size:24rpx;margin-bottom:16rpx}
.create-entry{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:24rpx;border:1rpx solid var(--line, #dce2df)}
.create-entry-main{display:flex;align-items:center;gap:16rpx;min-width:0}
.create-plus{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;flex-shrink:0;border-radius:16rpx;background:var(--subtle, #eef1ef);color:var(--accent, #176b91);font-size:40rpx;line-height:1;font-weight:400}
.create-entry-title{font-size:28rpx;font-weight:600;color:var(--ink, #263238);line-height:1.5}
.create-entry-subtitle{color:var(--secondary, #536168);font-size:24rpx;margin-top:3rpx}
.create-toggle{color:var(--accent, #176b91);font-size:24rpx;white-space:nowrap}
.create-arrow{margin-left:16rpx;font-size:32rpx;vertical-align:-2rpx}
.form-heading{margin-bottom:16rpx}
.form-heading .hint{margin-top:0}
.form-pickers{display:flex;gap:16rpx;margin-bottom:16rpx}
.form-pickers select-picker{font-size:24rpx}
.create-form textarea{min-height:170rpx}
.required{color:var(--accent, #176b91);margin-left:8rpx}
.task-list-head{margin:24rpx 2rpx 16rpx}
.task-list-head .hint{margin-top:0}
.homework-card{padding:24rpx}
.task-top{display:flex;align-items:center;gap:16rpx}
.subject-icon{width:78rpx;height:78rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600;line-height:1;flex-shrink:0}
.subject-chinese{color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5)}
.subject-math{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.subject-english{color:var(--muted, #68767c);background:var(--subtle, #eef1ef);font-size:28rpx}
.subject-other{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}
.task-subject{flex:1;min-width:0}
.subject-name{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}
.task-type{font-size:24rpx;color:var(--secondary, #536168);margin-top:2rpx}
.task-status{display:inline-block;border-radius:16rpx;padding:8rpx 16rpx;font-size:24rpx;line-height:1.5;white-space:nowrap}
.status-waiting{color:var(--secondary, #536168);background:var(--subtle, #eef1ef)}
.status-progressing{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.status-review{color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5)}
.status-correction{color:var(--danger, #b33740);background:var(--danger-soft, #fceff0)}
.status-done{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}
.task-title{font-size:32rpx;font-weight:600;line-height:1.6;color:var(--ink, #263238);margin-top:16rpx;word-break:break-all}
.task-student{display:flex;align-items:center;flex-wrap:wrap;color:var(--secondary, #536168);font-size:24rpx;margin-top:16rpx}
.student-dot{width:10rpx;height:10rpx;display:inline-block;border-radius:50%;background:var(--muted, #68767c);margin-right:16rpx}
.student-class{color:var(--secondary, #536168);white-space:pre-wrap}
.task-description{color:var(--secondary, #536168);font-size:24rpx;line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:16rpx;word-break:break-all;white-space:pre-wrap}
.task-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-top:1rpx solid var(--line, #dce2df);margin-top:16rpx;padding-top:24rpx}
.task-date{color:var(--muted, #68767c);font-size:24rpx}
.task-link{color:var(--accent, #176b91);font-size:24rpx}
.task-arrow{margin-left:16rpx;font-size:32rpx;vertical-align:-1rpx}

.title { font-size: 36rpx; }
