<app-nav /><view class="{{user.role === 'PARENT' ? 'parent-view' : ''}} {{reducedMotion ? 'reduce-motion' : ''}} {{!loading ? 'parent-ready' : ''}} page rewards-page"><view class="hero"><view class="title">积分与奖品</view><view class="subtitle">把每一份努力，换成孩子期待的奖励。</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry" /><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" bindchange="pickStudents" /><view wx:if="{{child}}" class="reward-balance">{{child.name}} · 可用 <text>{{child.points}}</text> 积分<view wx:if="{{studentLevel}}" class="hint">当前 Lv.{{studentLevel}} · 礼品兑换只扣积分</view></view><view wx:if="{{teacher}}" class="card"><view class="section-title">固定成长奖励</view><view class="hint gap">积分按每次确认发放，努力类经验每天结算一次；日小结仅奖励积分。</view><select-picker range="{{presetNames}}" value="{{presetIndex}}" bindchange="selectPreset" label="选择固定奖励"><view class="form-pick">{{presetNames[presetIndex] || '选择固定奖励'}}</view></select-picker><button class="primary gap" bindtap="award" disabled="{{busy || !presetIndex}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">确认奖励</button><block wx:if="{{admin}}"><button class="text-button gap" bindtap="editPreset" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">新增固定奖励</button><button wx:for="{{allPresets}}" wx:key="id" class="preset-pill" data-id="{{item.id}}" bindtap="editPreset" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{item.campusName}} · {{item.name}} · {{item.points}}积分 / {{item.experience}}经验 {{item.enabled ? '' : '（停用）'}}</button></block></view>
<view wx:if="{{superAdmin}}" class="card"><view class="row"><view class="section-title">自动奖励规则</view><button class="text-button" bindtap="toggleRules" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{rulesOpen ? '收起' : '设置'}}</button></view><view class="hint">全机构共用，由总管理员维护</view><view wx:if="{{rulesOpen}}"><view wx:for="{{automaticRules}}" wx:key="event" class="field gap"><text class="label">{{item.name}} · 积分</text><input aria-label="{{item.name}}奖励积分" value="{{item.points}}" data-index="{{index}}" bindinput="rulePoints" type="number" /></view><view class="field"><text class="label">学习挑战 · 经验（作业/订正共用）</text><input aria-label="学习挑战经验" value="{{learningExperience}}" data-field="learningExperience" bindinput="field" type="number" /></view><view class="field"><text class="label">体能活动 · 经验</text><input aria-label="体能活动经验" value="{{fitnessExperience}}" data-field="fitnessExperience" bindinput="field" type="number" /></view><view class="hint">均为0至100整数。各类经验每天首次奖励，积分按具体完成记录发放。新规则用于后续奖励，历史记录保留</view><button class="primary gap" bindtap="saveRules" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">保存全局奖励规则</button></view></view>
<view wx:if="{{showPreset && admin}}" class="card"><view class="section-title">固定奖励设置</view><view class="field"><text class="label">名称</text><input value="{{presetName}}" data-field="presetName" bindinput="field" maxlength="100" /></view><view class="field"><text class="label">积分（1至100）</text><input value="{{presetPoints}}" data-field="presetPoints" bindinput="field" type="number" /></view><view class="field"><text class="label">经验（0至100）</text><input aria-label="奖励经验" value="{{presetExperience}}" data-field="presetExperience" bindinput="field" type="number" /><view class="hint">设为0时只奖励积分</view></view><button class="secondary" bindtap="togglePreset" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{presetEnabled ? '已启用，点击停用' : '已停用，点击启用'}}</button><view class="actions gap"><button class="primary" bindtap="savePreset" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">保存</button><button class="secondary" bindtap="closePreset" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">取消</button></view></view>
<button wx:if="{{admin}}" class="primary gap" bindtap="editPrize" disabled="{{busy || !child}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">在{{child.campusName}}新增奖品</button><view wx:if="{{showPrize && admin}}" class="card gap"><view class="section-title">奖品设置</view><view class="field"><text class="label">名称</text><input value="{{prizeName}}" data-field="prizeName" bindinput="field" maxlength="100" /></view><view class="field"><text class="label">兑换积分</text><input value="{{pointsCost}}" data-field="pointsCost" bindinput="field" type="number" /></view><view class="field"><text class="label">最低兑换等级</text><input aria-label="最低兑换等级" value="{{requiredLevel}}" data-field="requiredLevel" bindinput="field" type="number" /><view class="hint">Lv.1 表示所有等级可兑换</view></view><view class="field"><text class="label">库存</text><input value="{{stock}}" data-field="stock" bindinput="field" type="number" /></view><image wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFit" class="prize-photo" /><button class="secondary" bindtap="coverPhoto" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">上传奖品图片</button><button class="text-button gap" bindtap="toggleEnabled" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{enabled ? '已上架，点击下架' : '已下架，点击上架'}}</button><view class="actions gap"><button class="primary" bindtap="savePrize" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">保存奖品</button><button class="secondary" bindtap="closePrize" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">取消</button></view></view>
<view wx:if="{{teacher}}" class="card gap"><view class="section-title">本次兑换照片（可选）</view><image wx:if="{{receiptUrl}}" src="{{receiptUrl}}" mode="aspectFit" class="prize-photo" /><button class="secondary gap" bindtap="receiptPhoto" disabled="{{busy || !child}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">拍照记录</button></view><view class="section-title gap">可选奖品</view><view wx:for="{{prizes}}" wx:key="id" class="card prize-card"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFit" class="prize-photo" /><view class="row"><view class="card-title col">{{item.name}}</view><text class="badge {{item.canRedeem ? '' : 'dim'}}">{{item.redemptionHint}}</text></view><view class="hint gap">{{item.campusName}} · 库存 {{item.stock}}</view><view class="prize-level">Lv.{{item.requiredLevel}} 起可兑换 · 经验不消耗</view><view class="prize-cost">{{item.pointsCost}}<text>积分</text></view><view class="actions"><button wx:if="{{teacher}}" class="primary" data-id="{{item.id}}" bindtap="redeem" disabled="{{busy || !item.canRedeem}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{item.canRedeem ? '兑换并发放' : item.redemptionHint}}</button><button wx:if="{{admin}}" class="secondary" data-id="{{item.id}}" bindtap="editPrize" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">编辑</button></view></view><view wx:if="{{!prizes.length}}" class="card hint">校区暂未设置奖品。</view><view wx:if="{{!teacher}}" class="hint gap">可与孩子一起选奖品，由负责老师核对等级与积分后现场兑换，经验不会扣除。</view><view class="section-title gap">兑换记录</view><view wx:for="{{records}}" wx:key="id" class="card"><view class="card-title">{{item.studentName}} · {{item.prizeName}}</view><view class="hint gap">使用{{item.pointsCost}}积分 · {{item.teacherName}} · {{item.createdText}}</view><file-list files="{{item.attachments}}" /><button wx:if="{{teacher}}" class="text-button gap" data-id="{{item.id}}" bindtap="receiptPhoto" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">补充兑换照片</button></view><state-view empty="{{!records.length}}" empty-text="暂无兑换记录" /><view wx:if="{{actionError}}" class="error">{{actionError}}</view></block></view>
