.reward-balance{padding:32rpx;margin-bottom:32rpx;background:var(--subtle, #eef1ef);border-radius:32rpx;color:var(--secondary, #536168)}.reward-balance text{font-size:48rpx;font-weight:600;color:var(--accent, #176b91);margin:0 8rpx}.prize-card{margin-top:24rpx}.prize-photo{width:100%;height:310rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;margin-bottom:24rpx}.prize-cost{font-size:52rpx;font-weight:600;color:var(--warning, #885c18);margin:24rpx 0}.prize-cost text{font-size:24rpx;font-weight:400;margin-left:16rpx}.preset-pill{display:block;text-align:left;border-radius:16rpx;background:var(--subtle, #eef1ef);color:var(--secondary, #536168);padding:16rpx 24rpx;margin-top:16rpx;font-size:24rpx;white-space:normal}

.prize-level{font-size:24rpx;color:var(--accent,#176b91);line-height:1.7;margin-top:16rpx}
