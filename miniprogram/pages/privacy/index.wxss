.policy-copy{margin-top:20rpx;color:#626570;font-size:25rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word}.grant-row{padding:24rpx 0;border-bottom:1rpx solid #eeeef3}.grant-row:last-child{border:0}.card-subtitle{font-size:27rpx;font-weight:600;margin-bottom:12rpx}.grant-row .actions button{min-width:0}.history-row{padding:18rpx 0;color:#737783;font-size:24rpx;border-top:1rpx solid #eeeef3}.request-card .actions:empty{display:none}.request-card .card-title{font-size:27rpx}.export-scroll{height:500rpx;margin-top:20rpx;padding:20rpx;border-radius:22rpx;background:#f5f5f7}.export-text{white-space:pre-wrap;word-break:break-word;font-size:22rpx;line-height:1.8;color:#626570}.external-note{padding:12rpx 4rpx;color:#9295a0;font-size:22rpx;line-height:1.9}.external-note view:first-child{color:#737783;margin-bottom:8rpx}
