.policy-copy{margin-top:24rpx;color:var(--ink, #263238);font-size:24rpx;line-height:1.9;white-space:pre-wrap;word-break:break-word}.grant-row{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}.grant-row:last-child{border:0}.card-subtitle{font-size:28rpx;font-weight:600;margin-bottom:16rpx}.grant-row .actions button{min-width:0}.history-row{padding:16rpx 0;color:var(--secondary, #536168);font-size:24rpx;border-top:1rpx solid var(--line, #dce2df)}.request-card .actions:empty{display:none}.request-card .card-title{font-size:28rpx}.export-scroll{height:500rpx;margin-top:24rpx;padding:24rpx;border-radius:24rpx;background:var(--subtle, #eef1ef)}.export-text{white-space:pre-wrap;word-break:break-word;font-size:24rpx;line-height:1.8;color:var(--ink, #263238)}.external-note{padding:16rpx 8rpx;color:var(--muted, #68767c);font-size:24rpx;line-height:1.9}.external-note view:first-child{color:var(--secondary, #536168);margin-bottom:8rpx}
