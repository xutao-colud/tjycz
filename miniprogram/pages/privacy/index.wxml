<app-nav />
<view class="page privacy-page">
  <view class="hero"><view class="title">隐私与数据</view><view class="subtitle">查看孩子的信息说明，按需申请资料副本</view></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <block wx:if="{{!loading && !error && policy}}">
    <view class="card">
      <view class="card-title">孩子的信息处理说明</view><view class="hint">当前版本 {{policy.version}}</view>
      <select-picker class="gap" range="{{studentNames}}" value="{{studentIndex}}" label="选择孩子" bindchange="child"><text>{{studentNames[studentIndex] || '暂无可查看的孩子'}}</text></select-picker>
      <view class="policy-copy">{{policy.serviceText}}</view><view class="policy-copy">{{policy.mediaText}}</view><view class="policy-copy">{{policy.retentionText}}</view>
    </view>
    <view wx:if="{{policy.consentRequired !== false && consent}}" class="card">
      <view class="card-title">授权状态</view><view wx:if="{{!parent}}" class="hint">此处仅查看状态。请孩子的绑定监护人登录家长账号，分别确认服务信息与图片、录音和视频授权。</view>
      <view class="grant-row"><view class="card-subtitle">托管服务信息处理</view><view wx:if="{{parent}}" class="muted">我的选择：{{consent.serviceText}}</view><view class="hint">孩子当前状态：{{consent.effectiveService ? '授权有效' : '尚未授权或已暂停'}}</view><view wx:if="{{parent}}" class="actions"><button class="secondary" data-scope="SERVICE" data-grant="1" bindtap="consent" disabled="{{busy}}">阅读后同意</button><button class="text-button" data-scope="SERVICE" data-grant="0" bindtap="consent" disabled="{{busy}}">撤回授权</button></view></view>
      <view class="grant-row"><view class="card-subtitle">图片、录音与视频</view><view wx:if="{{parent}}" class="muted">我的选择：{{consent.mediaText}}</view><view class="hint">孩子当前状态：{{consent.effectiveMedia ? '授权有效' : '尚未授权或已暂停'}}</view><view wx:if="{{parent}}" class="actions"><button class="secondary" data-scope="MEDIA" data-grant="1" bindtap="consent" disabled="{{busy}}">阅读后同意</button><button class="text-button" data-scope="MEDIA" data-grant="0" bindtap="consent" disabled="{{busy}}">撤回授权</button></view></view>
      <button wx:if="{{parent && consent.history.length}}" class="text-button" bindtap="history">{{historyOpen ? '收起授权记录' : '查看我的授权记录'}}</button>
      <view wx:if="{{historyOpen}}"><view class="history-row" wx:for="{{consent.history}}" wx:key="id">{{item.timeText}} · {{item.scopeText}} · {{item.actionText}}<view class="hint">{{item.policyVersion}}</view></view></view>
    </view>
    <view wx:if="{{parent && studentId}}" class="card"><view class="card-title">资料申请</view><view class="field gap"><text class="label">申请类型</text><select-picker range="{{requestTypes}}" value="{{requestType}}" label="选择资料申请类型" bindchange="requestType"><text>{{requestTypes[requestType]}}</text></select-picker></view><view class="field"><text class="label">申请说明</text><textarea value="{{reason}}" data-field="reason" bindinput="field" maxlength="1000" placeholder="说明需要资料副本或申请脱敏的原因" aria-label="资料申请说明" /></view><button class="primary" bindtap="createRequest" disabled="{{busy}}">提交申请</button><view class="hint">管理员审核后再处理；提交申请不会立即脱敏。</view></view>
    <view wx:if="{{parent || manager}}" class="section-head"><view class="section-title">{{manager ? '资料申请处理' : '我的资料申请'}}</view><button class="text-button" bindtap="retry">刷新</button></view>
    <view wx:if="{{(parent || manager) && !requests.length}}" class="card empty-inline">暂无资料申请</view>
    <view class="card request-card" wx:for="{{requests}}" wx:key="id"><view class="row"><view class="col card-title">{{item.studentName}} · {{item.typeText}}</view><text class="badge {{item.status === 'COMPLETED' ? '' : 'dim'}}">{{item.statusText}}</text></view><view class="policy-copy">{{item.reason}}</view><view wx:if="{{item.reviewNote}}" class="hint">核对说明：{{item.reviewNote}}</view><view class="hint">{{item.timeText}}</view><view class="actions"><button wx:if="{{manager && item.status === 'OPEN'}}" class="secondary" data-id="{{item.id}}" bindtap="openReview">审核申请</button><button wx:if="{{item.canExport}}" class="primary" data-id="{{item.id}}" bindtap="export" disabled="{{busy}}">查看资料副本</button><button wx:if="{{manager && item.type === 'ERASURE' && item.status === 'APPROVED'}}" class="danger" data-id="{{item.id}}" bindtap="checkErasure" disabled="{{busy}}">核对并执行脱敏</button></view></view>
    <view wx:if="{{reviewId}}" class="card"><view class="card-title">审核 {{reviewName}}</view><select-picker class="gap" range="{{reviewDecisions}}" value="{{reviewDecision}}" label="选择审核结果" bindchange="reviewDecision"><text>{{reviewDecisions[reviewDecision]}}</text></select-picker><textarea class="gap" value="{{reviewNote}}" data-field="reviewNote" bindinput="field" maxlength="1000" placeholder="请填写身份、申请范围等核对说明" aria-label="资料申请核对说明" /><view class="actions"><button class="secondary" bindtap="cancelReview" disabled="{{busy}}">取消</button><button class="primary" bindtap="saveReview" disabled="{{busy}}">保存审核</button></view></view>
    <view wx:if="{{erasureId}}" class="card"><view class="card-title">{{erasureName}} · 最终核对</view><view wx:if="{{erasureBlocks.length}}" class="notice"><view wx:for="{{erasureBlocks}}" wx:key="*this">{{item}}</view></view><block wx:else><view class="policy-copy">执行后移除孩子的姓名、联系方式和学习正文，关闭相关媒体访问；保留必要的脱敏账目与申请审计，共用附件不连带删除。</view><input value="{{eraseConfirmation}}" data-field="eraseConfirmation" bindinput="field" placeholder="请输入“确认脱敏”" aria-label="确认资料脱敏" /></block><view class="actions"><button class="secondary" bindtap="cancelErasure" disabled="{{busy}}">取消</button><button wx:if="{{!erasureBlocks.length}}" class="danger" bindtap="executeErasure" disabled="{{busy}}">最终确认并执行</button></view></view>
    <view wx:if="{{exportText}}" class="card"><view class="card-title">孩子的资料副本</view><view class="hint">副本含孩子个人资料，请保管好复制内容。</view><scroll-view class="export-scroll" scroll-y><text class="export-text" selectable>{{exportText}}</text></scroll-view><view class="actions"><button class="secondary" bindtap="copyExport">复制资料文本</button><button class="text-button" bindtap="closeExport">收起</button></view></view>
    <view class="external-note"><view>机构正式启用前需完成</view><view wx:for="{{policy.externalConfiguration}}" wx:key="*this">{{item}}</view></view>
  </block>
</view>
