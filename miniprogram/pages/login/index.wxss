page { background: var(--subtle, #eef1ef); color: var(--ink, #263238); }
.login-shell { position: relative; overflow: hidden; min-height: 100vh; padding: 0 0 calc(32rpx + env(safe-area-inset-bottom)); background: var(--surface, #ffffff); }
.login-shell view, .login-shell text, .login-shell button, .login-shell input { box-sizing: border-box; }
.background-waves { position: absolute; z-index: 0; pointer-events: none; inset: 0; overflow: hidden; }
.wave { position: absolute; bottom: -105rpx; width: 600rpx; height: 210rpx; border-radius: 50%; transform: rotate(30deg); }
.wave-green { left: -270rpx; bottom: -45rpx; background: rgba(121,229,130,.23); }
.wave-mint { left: -320rpx; bottom: 14rpx; background: rgba(179,240,184,.23); }
.wave-blue { right: -270rpx; bottom: -18rpx; background: rgba(100,197,250,.23); transform: rotate(-35deg); }
.wave-sky { right: -280rpx; bottom: -85rpx; background: rgba(60,183,250,.19); transform: rotate(-29deg); }
.login-topbar { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 8rpx 40rpx; }
.back-button { display: flex; align-items: center; width: 68rpx; height: 64rpx; }
.back-chevron { width: 16rpx; height: 16rpx; border-left: 3rpx solid var(--line, #dce2df); border-bottom: 3rpx solid var(--line, #dce2df); transform: rotate(45deg); }
.topbar-action { padding: 16rpx 0 16rpx 24rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.topbar-title { color: var(--ink, #263238); font-size: 28rpx; font-weight: 600; }
.topbar-space { width: 68rpx; }
.brand-logo { display: block; width: 142rpx; height: 108rpx; margin: 0 auto; }
.brand-name { color: var(--ink, #263238); font-size: 44rpx; font-weight: 600; letter-spacing: 0; line-height: 1.4; }
.brand-sub { display: flex; align-items: center; justify-content: center; gap: 16rpx; color: var(--ink, #263238); font-size: 24rpx; font-weight: 500; letter-spacing: 0; }
.brand-sub text { width: 40rpx; height: 1rpx; background: var(--muted, #68767c); }
.auth-brand { position: relative; z-index: 1; padding: 32rpx 0 48rpx; text-align: center; }
.auth-logo { width: 220rpx; height: 220rpx; }
.auth-form { position: relative; z-index: 1; margin: 0 40rpx; }
.login-tabs { display: flex; align-items: center; gap: 40rpx; justify-content: space-between; margin: 8rpx 0 40rpx; }
.login-tab { position: relative; flex: 1; padding: 16rpx 0 24rpx; color: var(--secondary, #536168); font-size: 28rpx; text-align: center; }
.login-tab.tab-active { color: var(--accent, #176b91); font-weight: 600; }
.login-tab.tab-active::after { content: ""; position: absolute; width: 170rpx; height: 4rpx; left: 50%; bottom: 0; transform: translateX(-50%); border-radius: 8rpx; background: var(--accent, #176b91); }
.input-row { display: flex; align-items: center; gap: 16rpx; height: 92rpx; margin-bottom: 24rpx; padding: 0 24rpx; border: 1rpx solid var(--line, #dce2df); border-radius: 24rpx; background: var(--subtle, #eef1ef); }
.input-row input { flex: 1; min-width: 0; height: 88rpx; min-height: 88rpx; padding: 0; border: 0; background: transparent; color: var(--ink, #263238); font-size: 28rpx; line-height: 88rpx; }
.input-row input::placeholder { color: var(--muted, #68767c); }
.phone-prefix { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; padding-right: 16rpx; color: var(--ink, #263238); font-size: 28rpx; }
.phone-prefix text { color: var(--secondary, #536168); font-size: 24rpx; }
.input-clear { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 60rpx; color: var(--muted, #68767c); font-size: 36rpx; }
.code-button { flex-shrink: 0; margin: 0; padding: 24rpx 0 24rpx 16rpx; color: var(--accent, #176b91); background: transparent; font-size: 24rpx; font-weight: 500; }
.input-icon { position: relative; flex-shrink: 0; width: 30rpx; height: 35rpx; }
.person-icon::before { content: ""; position: absolute; left: 10rpx; top: 3rpx; width: 12rpx; height: 12rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 50%; }
.person-icon view { position: absolute; left: 5rpx; top: 21rpx; width: 24rpx; height: 14rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 16rpx 16rpx 4rpx 4rpx; }
.lock-icon::before { content: ""; position: absolute; top: 2rpx; left: 9rpx; width: 14rpx; height: 18rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 8rpx 8rpx 0 0; }
.lock-icon view { position: absolute; top: 16rpx; left: 5rpx; width: 24rpx; height: 20rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 8rpx; background: var(--subtle, #eef1ef); }
.eye-action { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 50rpx; height: 72rpx; }
.eye-shape { position: relative; display: flex; align-items: center; justify-content: center; width: 27rpx; height: 16rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 75% 20%; transform: rotate(45deg); }
.eye-shape view { width: 6rpx; height: 6rpx; border-radius: 50%; background: var(--accent, #176b91); }
.eye-shape::after { content: ""; position: absolute; width: 34rpx; height: 2rpx; background: var(--accent, #176b91); transform: rotate(-3deg); }
.eye-visible .eye-shape::after { display: none; }
.account-options { display: flex; align-items: center; justify-content: space-between; margin: 0rpx 2rpx 32rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.check-label { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; }
.check-box, .agreement-check { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 27rpx; height: 27rpx; border: 2rpx solid var(--line, #dce2df); border-radius: 8rpx; color: var(--surface, #ffffff); background: var(--surface, #ffffff); font-size: 24rpx; line-height: 1; }
.checked { border-color: var(--line, #dce2df); background: var(--accent, #176b91); }
.forgot-link { color: var(--secondary, #536168); padding: 8rpx 0 8rpx 16rpx; }
.login-shell .primary { width: 100%; background: var(--accent, #176b91); border-radius: 24rpx; color: var(--surface, #ffffff); box-shadow: none; font-weight: 500; font-size: 28rpx; padding: 24rpx 24rpx; line-height: 1.5; }
.login-submit { margin-top: 8rpx; }
.agreement-row { display: flex; gap: 16rpx; align-items: flex-start; margin: 32rpx 0 0; padding: 8rpx 0; }
.agreement-check { width: 25rpx; height: 25rpx; margin-top: 3rpx; border-radius: 50%; font-size: 24rpx; }
.agreement-copy { color: var(--secondary, #536168); font-size: 24rpx; line-height: 1.8; }
.legal-link { color: var(--accent, #176b91); }
.capability-note { margin: -8rpx 1rpx 24rpx; color: var(--muted, #68767c); font-size: 24rpx; line-height: 1.65; }
.login-error { margin: 0 0 16rpx; padding: 16rpx 24rpx; color: var(--danger, #b33740); background: var(--subtle, #eef1ef); border-radius:24rpx; font-size: 24rpx; line-height: 1.6; }
.other-login { position: relative; z-index: 1; padding: 56rpx 48rpx 0; }
.other-heading { display: flex; align-items: center; justify-content: center; gap: 24rpx; color: var(--muted, #68767c); font-size: 24rpx; }
.other-heading view { width: 100rpx; height: 1rpx; background: var(--subtle, #eef1ef); }
.wechat-entry { padding: 24rpx 0 16rpx; text-align: center; color: var(--secondary, #536168); font-size: 24rpx; }
.wechat-entry image { display: block; width: 98rpx; height: 98rpx; margin: 0 auto 16rpx; }
.demo-credentials { position: relative; z-index: 1; margin: 16rpx 40rpx 0; color: var(--secondary, #536168); font-size: 24rpx; text-align: center; line-height: 1.8; }
.demo-credentials view { margin-top: 3rpx; color: var(--muted, #68767c); font-size: 24rpx; }
.connection-state { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 16rpx 0 8rpx; color: var(--muted, #68767c); font-size: 24rpx; }
.connection-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: var(--danger, #b33740); }
.connection-dot.connected { background: var(--success, #23734e); }
.existing-session { position: relative; z-index: 1; display: flex; align-items: center; gap: 16rpx; margin: -16rpx 40rpx 24rpx; padding: 16rpx; border: 1rpx solid var(--line, #dce2df); border-radius:24rpx; background: var(--subtle, #eef1ef); }
.existing-session > view:first-child { flex: 1; min-width: 0; }
.existing-title { color: var(--accent, #176b91); font-size: 24rpx; font-weight: 500; }
.existing-caption { color: var(--muted, #68767c); font-size: 24rpx; margin-top: 3rpx; }
.existing-session button { flex-shrink: 0; background: var(--accent, #176b91); color: var(--surface, #ffffff); padding: 16rpx 16rpx; font-size: 24rpx; border-radius:16rpx; }
.session-logout { color: var(--muted, #68767c); font-size: 24rpx; padding: 8rpx 0; }
.identity-heading { position: relative; padding: 32rpx 24rpx 56rpx; text-align: center; }
.identity-title { font-size: 40rpx; font-weight: 600; color: var(--ink, #263238); }
.identity-subtitle { margin-top: 16rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.identity-list { position: relative; padding: 0 32rpx; }
.identity-card { display: flex; align-items: center; gap: 24rpx; min-height: 236rpx; margin-bottom: 24rpx; padding: 24rpx 24rpx; border-radius: 32rpx; }
.identity-parent { background: var(--subtle, #eef1ef); }
.identity-teacher { background: var(--subtle, #eef1ef); }
.identity-principal { background: var(--subtle, #eef1ef); }
.identity-admin { background: var(--subtle, #eef1ef); }
.identity-avatar { flex-shrink: 0; width: 183rpx; height: 183rpx; border-radius: 50%; }
.identity-copy { flex: 1; min-width: 0; }
.identity-name { margin-bottom: 16rpx; color: var(--ink, #263238); font-size: 32rpx; font-weight: 600; }
.identity-line { color: var(--muted, #68767c); font-size: 24rpx; line-height: 1.7; }
.identity-teacher .identity-line { color: var(--success, #23734e); }
.identity-admin .identity-line { color: var(--warning, #885c18); }
.identity-arrow { flex-shrink: 0; padding: 8rpx; color: var(--muted, #68767c); font-size: 48rpx; }
.identity-teacher .identity-arrow { color: var(--success, #23734e); }
.identity-principal .identity-arrow { color: var(--accent, #176b91); }
.identity-admin .identity-arrow { color: var(--warning, #885c18); }
.identity-note { position: relative; padding: 8rpx 24rpx 32rpx; color: var(--muted, #68767c); text-align: center; font-size: 24rpx; }
.stage-roles .wave { opacity: .35; }
 .welcome-screen { position:relative; display:flex; flex-direction:column; min-height:100vh; background:var(--paper); }
.welcome-content { position:relative; flex:1; display:flex; flex-direction:column; justify-content:center; padding:80rpx 40rpx 40rpx; }
.welcome-brand { position:relative; z-index:1; display:flex; align-items:center; gap:24rpx; }
.welcome-logo { width:128rpx; height:128rpx; margin:0; flex-shrink:0; border-radius:50%; }
.welcome-brand .brand-name { font-size:36rpx; margin:0; }
.welcome-brand .brand-sub { justify-content:flex-start; margin-top:8rpx; color:var(--secondary); font-size:24rpx; }
.welcome-intro { margin-top:56rpx; text-align:left; }
.welcome-eyebrow { color:var(--secondary); font-size:24rpx; line-height:1.5; }
.welcome-headline { margin-top:16rpx; color:var(--ink); font-size:52rpx; font-weight:600; line-height:1.5; }
.welcome-headline text { display:table; color:#286650; border-bottom:8rpx solid #ecd27e; }
.welcome-description { margin-top:24rpx; color:var(--secondary); font-size:26rpx; line-height:1.8; }
.welcome-services { display:flex; gap:12rpx; margin-top:40rpx; }
.welcome-service { flex:1; min-width:0; padding:24rpx 12rpx; border-radius:16rpx; text-align:left; }
.welcome-service-study { background:#e1eef4; }
.welcome-service-habit { background:#e6efdf; }
.welcome-service-family { background:#f5ecd2; }
.welcome-service image { display:block; width:40rpx; height:40rpx; }
.welcome-service-title { margin-top:16rpx; color:var(--ink); font-size:28rpx; font-weight:600; line-height:1.5; }
.welcome-service-caption { margin-top:8rpx; color:var(--secondary); font-size:24rpx; line-height:1.6; }
.welcome-bottom { flex-shrink:0; padding:32rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); background:var(--paper); text-align:left; }
.welcome-title { color:var(--ink); font-size:28rpx; font-weight:600; line-height:1.5; }
.welcome-caption { margin-top:8rpx; color:var(--secondary); font-size:24rpx; line-height:1.6; }
.welcome-start { margin-top:24rpx; }
.welcome-skip { position:absolute; z-index:2; top:8rpx; right:24rpx; padding:16rpx; color:var(--secondary); font-size:24rpx; }
.stage-welcome { padding-bottom:0; }

@media (max-height: 700px) {
  .welcome-content { padding-top:64rpx; padding-bottom:24rpx; }
  .welcome-logo { width:104rpx; height:104rpx; }
  .welcome-intro { margin-top:32rpx; }
  .welcome-headline { font-size:44rpx; }
  .welcome-services { margin-top:24rpx; }
  .welcome-service { padding-top:16rpx; padding-bottom:16rpx; }
  .welcome-bottom { padding-top:24rpx; }
}
.recovery-body { position: relative; padding: 56rpx 40rpx 104rpx; }
.recovery-symbol { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; margin: 8rpx auto 32rpx; border-radius: 50%; background: var(--subtle, #eef1ef); }
.lock-illustration { position: relative; width: 53rpx; height: 46rpx; border-radius: 8rpx; background: var(--accent, #176b91); margin-top: 16rpx; }
.lock-illustration::before { content: ""; position: absolute; left: 10rpx; top: -24rpx; width: 33rpx; height: 35rpx; border: 6rpx solid var(--line, #dce2df); border-radius: 24rpx 24rpx 0 0; }
.lock-illustration view { width: 6rpx; height: 15rpx; margin: 16rpx auto; border-radius: 4rpx; background: var(--surface, #ffffff); }
.recovery-title { font-size: 32rpx; font-weight: 600; text-align: center; }
.recovery-subtitle { color: var(--muted, #68767c); font-size: 24rpx; text-align: center; margin: 16rpx 0 40rpx; }
.recovery-note { margin-top: 0; color: var(--muted, #68767c); }
.recovery-secondary { padding: 24rpx 0 0; color: var(--secondary, #536168); font-size: 24rpx; text-align: center; }
.auth-state-card { position: relative; margin: 56rpx 40rpx 144rpx; padding: 48rpx 24rpx; text-align: center; }
.wechat-large { display: block; width: 118rpx; height: 118rpx; margin: 0 auto 40rpx; }
.state-title { margin-bottom: 16rpx; color: var(--ink, #263238); font-size: 36rpx; font-weight: 600; }
.state-description { color: var(--secondary, #536168); font-size: 24rpx; line-height: 1.8; }
.wechat-permissions { margin: 40rpx 0; padding: 0 16rpx; color: var(--secondary, #536168); font-size: 24rpx; text-align: left; line-height: 2; }
.wechat-permissions text { margin-right: 16rpx; color: var(--success, #23734e); }
.wechat-authorize { width: 100%; margin: 32rpx 0 8rpx; padding: 24rpx 16rpx; border-radius:32rpx; background: var(--success, #23734e); color: var(--surface, #ffffff); font-size: 28rpx; font-weight: 500; }
.auth-state-card .text-button { margin-top: 8rpx; color: var(--muted, #68767c); }
.success-screen { position: relative; padding: 136rpx 48rpx 200rpx; text-align: center; }
.success-circle { display: flex; align-items: center; justify-content: center; width: 142rpx; height: 142rpx; margin: 0 auto 48rpx; border: 5rpx solid var(--line, #dce2df); border-radius: 50%; background: var(--success, #23734e); color: var(--surface, #ffffff); font-size: 84rpx; line-height: 1; box-shadow: none; }
.success-brand { margin-top: 8rpx; color: var(--ink, #263238); font-size: 28rpx; }
.success-identity { margin-top: 16rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.login-shell.success-leaving { pointer-events: none; animation: success-fade-out 1.2s ease-in-out forwards; }
@keyframes success-fade-out { from { opacity: 1; } to { opacity: 0; } }
.success-progress { overflow: hidden; width: 156rpx; height: 5rpx; margin: 40rpx auto 0; border-radius: 8rpx; background: var(--subtle, #eef1ef); }
.success-progress view { width: 100%; height: 100%; border-radius: 8rpx; background: var(--accent, #176b91); transform-origin: left center; animation: success-progress-fill 1.5s linear both; }
@keyframes success-progress-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
.success-transition-note { margin-top: 24rpx; color: var(--muted, #68767c); font-size: 24rpx; }
.success-caption { margin-top: 24rpx; color: var(--muted, #68767c); font-size: 24rpx; }
.outline-button { width: 100%; margin-top: 24rpx; border: 2rpx solid var(--line, #dce2df); border-radius:32rpx; color: var(--accent, #176b91); background: var(--surface, #ffffff); padding: 24rpx; font-size: 28rpx; }
.binding-illustration { position: relative; width: 150rpx; height: 155rpx; margin: 0 auto 40rpx; }
.binding-phone { position: absolute; left: 32rpx; top: 5rpx; width: 82rpx; height: 130rpx; border: 6rpx solid var(--line, #dce2df); border-radius:24rpx; background: var(--subtle, #eef1ef); color: var(--surface, #ffffff); font-size: 52rpx; line-height: 125rpx; }
.binding-alert { position: absolute; right: 6rpx; bottom: 3rpx; width: 61rpx; height: 61rpx; border: 4rpx solid var(--surface, #ffffff); border-radius:24rpx; color: var(--surface, #ffffff); background: var(--danger, #b33740); font-size: 44rpx; font-weight: 600; }
.auth-state-card .state-description + .primary { margin-top: 48rpx; }
.dialog-mask { position: fixed; z-index: 200; inset: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(22,39,67,.32); }
.login-dialog { width: 100%; max-width: 650rpx; border-radius: 32rpx; padding: 40rpx; background: var(--surface, #ffffff); }
.dialog-title { color: var(--ink, #263238); font-size: 32rpx; font-weight: 600; text-align: center; }
.dialog-content { max-height: 480rpx; margin: 24rpx 0 32rpx; color: var(--secondary, #536168); font-size: 24rpx; line-height: 1.9; }
