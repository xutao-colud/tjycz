@media (max-width: 360px) { .auth-form { margin: 0 32rpx; } .identity-avatar { width: 160rpx; height: 160rpx; } .identity-card { gap: 16rpx; padding: 24rpx; } .identity-name { font-size: 28rpx; } .identity-line { font-size: 24rpx; } .brand-name { font-size: 40rpx; } }
