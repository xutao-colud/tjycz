<view class="login-shell stage-{{stage}} {{successLeaving ? 'success-leaving' : ''}}">
  <view wx:if="{{stage !== 'welcome'}}" class="background-waves"><view class="wave wave-green"></view><view class="wave wave-mint"></view><view class="wave wave-blue"></view><view class="wave wave-sky"></view></view>

  <view wx:if="{{stage === 'welcome'}}" class="welcome-screen">

    <view class="welcome-content">
      <view class="welcome-brand"><image class="brand-logo welcome-logo" src="/assets/login/auth-logo.png" mode="aspectFit" aria-label="悦成长中心 Logo"/><view class="welcome-brand-copy"><view class="brand-name">天健悦成长</view><view class="brand-sub">托管中心 · 向上向善</view></view></view>
      <view class="welcome-intro">
        <view class="welcome-eyebrow">用心托管 · 陪伴成长</view>
        <view class="welcome-headline">放学后的时光<text>充实，也温暖</text></view>
        <view class="welcome-description"><view>从一道题的思考，到一个好习惯的养成，</view><view>陪孩子走好成长的每一步。</view></view>
      </view>
      <view class="welcome-services">
        <view class="welcome-service welcome-service-study"><image src="/assets/icons/homework.svg" mode="aspectFit" aria-hidden="true"/><view class="welcome-service-title">作业辅导</view><view class="welcome-service-caption">陪伴解题思路</view></view>
        <view class="welcome-service welcome-service-habit"><image src="/assets/icons/points.svg" mode="aspectFit" aria-hidden="true"/><view class="welcome-service-title">习惯养成</view><view class="welcome-service-caption">培养专注自律</view></view>
        <view class="welcome-service welcome-service-family"><image src="/assets/icons/summaries.svg" mode="aspectFit" aria-hidden="true"/><view class="welcome-service-title">家校共育</view><view class="welcome-service-caption">分享每日成长</view></view>
      </view>
    </view>
    <view class="welcome-bottom"><view class="welcome-title">每一天进步，看得见</view><view class="welcome-caption">一份用心的陪伴，连接孩子、老师与家长</view><button class="primary welcome-start" bindtap="start">开启成长之旅</button></view>
    <view class="welcome-skip" bindtap="skipIdentity">跳过</view>
  </view>

  <block wx:elif="{{stage === 'roles'}}">
    <view class="login-topbar"><view class="back-button" bindtap="back" aria-label="返回"><view class="back-chevron"></view></view><view class="topbar-action" bindtap="skipIdentity">跳过</view></view>
    <view class="identity-heading"><view class="identity-title">选择您的身份</view><view class="identity-subtitle">不同身份将使用不同的功能界面</view></view>
    <view class="identity-list"><view wx:for="{{identities}}" wx:key="code" class="identity-card identity-{{item.tone}}" data-role="{{item.code}}" bindtap="selectIdentity" role="button" aria-label="{{item.title}}"><image class="identity-avatar" src="/assets/login/{{item.image}}.png" mode="aspectFit"/><view class="identity-copy"><view class="identity-name">{{item.title}}</view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="identity-line">{{line}}</view></view><view class="identity-arrow">›</view></view></view>
    <view class="identity-note">本地体验可选择身份，正式账号权限由机构分配</view>
  </block>

  <block wx:elif="{{stage === 'login'}}">
    <view class="login-topbar"><view class="back-button" bindtap="back" aria-label="返回选择身份"><view class="back-chevron"></view></view><view class="topbar-action" bindtap="changeIdentity">切换身份 · {{selectedRoleName}}</view></view>
    <view class="auth-brand"><image class="brand-logo auth-logo" src="/assets/login/auth-logo.png" mode="aspectFit" aria-label="悦成长中心 Logo"/></view>
    <view wx:if="{{hasSession}}" class="existing-session"><view><view class="existing-title">您已登录</view><view class="existing-caption">继续查看今天的学习与成长</view></view><button bindtap="resume">进入首页</button><view class="session-logout" bindtap="logout">退出</view></view>
    <view class="auth-form">
      <view class="account-login-title">账号密码登录</view>
      <block>
        <view class="input-row"><view class="input-icon person-icon"><view></view></view><input value="{{username}}" data-field="username" bindinput="field" placeholder="请输入账号" disabled="{{busy}}" confirm-type="next"/></view>
        <view class="input-row"><view class="input-icon lock-icon"><view></view></view><input value="{{password}}" password="{{!showPassword}}" data-field="password" bindinput="field" placeholder="请输入密码" disabled="{{busy}}" bindconfirm="submit" confirm-type="go"/><view class="eye-action {{showPassword ? 'eye-visible' : ''}}" data-target="showPassword" bindtap="togglePassword" role="button" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}"><view class="eye-shape"><view></view></view></view></view>
        <view class="account-options"><view class="check-label" bindtap="toggleRemember"><view class="check-box {{remember ? 'checked' : ''}}">{{remember ? '✓' : ''}}</view><text>记住账号</text></view><view class="forgot-link" bindtap="forgot">忘记密码？</view></view>
      </block>
      <view wx:if="{{error}}" class="login-error">{{error}}</view>
      <button class="primary login-submit" bindtap="submit" data-mode="account" loading="{{busy}}" disabled="{{busy}}">登录</button>
      <view class="agreement-row"><view class="agreement-check {{agreed ? 'checked' : ''}}" bindtap="toggleAgreement" role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户协议和隐私政策">{{agreed ? '✓' : ''}}</view><view class="agreement-copy"><text bindtap="toggleAgreement">我已阅读并同意 </text><text class="legal-link" data-kind="terms" bindtap="showLegal">《用户协议》</text><text> 和 </text><text class="legal-link" data-kind="privacy" bindtap="showLegal">《隐私政策》</text></view></view>
    </view>
    <view wx:if="{{demoAvailable}}" class="demo-credentials">本地体验账号：admin · 密码：admin<view>可切换家长、老师、校长或管理员身份体验</view></view>
    <view class="connection-state"><view class="connection-dot {{connected ? 'connected' : ''}}"></view>{{health}}</view>
  </block>

  <block wx:elif="{{stage === 'forgot' || stage === 'reset'}}">
    <view class="login-topbar"><view class="back-button" bindtap="back" aria-label="返回"><view class="back-chevron"></view></view><view class="topbar-title">{{stage === 'forgot' ? '忘记密码' : '重置密码'}}</view><view class="topbar-space"></view></view>
    <view class="recovery-body">
      <view class="recovery-symbol"><view class="lock-illustration"><view></view></view></view>
      <view class="recovery-title">{{stage === 'forgot' ? '找回您的账号密码' : '设置新的登录密码'}}</view>
      <view class="recovery-subtitle">{{stage === 'forgot' ? '请输入账号绑定的手机号' : '验证身份后，为账号设置新密码'}}</view>
      <view wx:if="{{stage === 'forgot'}}" class="input-row"><view class="phone-prefix">+86</view><input type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="field" placeholder="请输入手机号"/></view>
      <block wx:else><view class="input-row"><input type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="field" placeholder="请输入验证码"/><button class="code-button" bindtap="requestCode">获取验证码</button></view><view class="input-row"><input value="{{newPassword}}" password="{{!showNewPassword}}" data-field="newPassword" bindinput="field" placeholder="请输入新密码"/><view class="eye-action {{showNewPassword ? 'eye-visible' : ''}}" data-target="showNewPassword" bindtap="togglePassword"><view class="eye-shape"><view></view></view></view></view><view class="input-row"><input value="{{confirmPassword}}" password="{{!showConfirmPassword}}" data-field="confirmPassword" bindinput="field" placeholder="请再次输入新密码"/><view class="eye-action {{showConfirmPassword ? 'eye-visible' : ''}}" data-target="showConfirmPassword" bindtap="togglePassword"><view class="eye-shape"><view></view></view></view></view></block>
      <view wx:if="{{error}}" class="login-error">{{error}}</view><view class="capability-note recovery-note">暂未开通自助找回密码，请联系机构管理员处理</view>
      <button wx:if="{{stage === 'forgot'}}" class="primary" bindtap="requestCode">获取验证码</button><button wx:else class="primary" bindtap="resetPassword">确认重置</button>
      <view wx:if="{{stage === 'forgot'}}" class="recovery-secondary" bindtap="openReset">已有验证码？设置新密码</view><view class="recovery-secondary" bindtap="contact">联系机构管理员</view>
    </view>
  </block>

  <block wx:elif="{{stage === 'wechat'}}">
    <view class="login-topbar"><view class="back-button" bindtap="back" aria-label="返回"><view class="back-chevron"></view></view><view class="topbar-title">微信快捷登录</view><view class="topbar-space"></view></view>
    <view class="auth-state-card"><image class="wechat-large" src="/assets/login/wechat.png" mode="aspectFit"/><view class="state-title">使用微信账号快捷登录</view><view class="state-description">登录后可查看与账号绑定的学习记录</view><view class="wechat-permissions"><view><text>•</text> 用于识别当前微信身份</view><view><text>•</text> 关联机构已开通的账号</view></view><view class="capability-note">当前机构暂未开通微信登录与绑定服务</view><button class="wechat-authorize" bindtap="authorizeWechat">微信授权登录</button><button class="text-button" bindtap="useAccount">使用账号密码登录</button></view>
  </block>

  <block wx:elif="{{stage === 'success'}}">
    <view class="success-screen"><view class="success-circle">✓</view><view class="state-title">登录成功，欢迎回来</view><view class="success-brand">天健悦成长托管中心</view><view class="success-identity">{{resultName}} · {{resultRole}}</view><view class="success-caption">今天的成长，从这里开始</view><view class="success-progress"><view></view></view><view class="success-transition-note">即将为您展开今天的成长记录</view></view>
  </block>

  <block wx:elif="{{stage === 'unbound'}}">
    <view class="login-topbar"><view class="back-button" bindtap="back" aria-label="返回"><view class="back-chevron"></view></view><view class="topbar-title">账号绑定提示</view><view class="topbar-space"></view></view>
    <view class="auth-state-card"><view class="binding-illustration"><view class="binding-phone">♧</view><view class="binding-alert">!</view></view><view class="state-title">微信账号尚未绑定</view><view class="state-description">请使用机构账号登录，或联系管理员核实绑定情况</view><button class="primary" bindtap="useAccount">使用账号密码登录</button><button class="outline-button" bindtap="contact">联系管理员</button></view>
  </block>

  <view wx:if="{{infoOpen || legalOpen}}" class="dialog-mask" bindtap="closeInfo" catchtouchmove="noop"><view class="login-dialog" catchtap="noop"><view class="dialog-title">{{legalOpen ? legalTitle : infoTitle}}</view><scroll-view class="dialog-content" scroll-y="{{true}}"><view>{{legalOpen ? legalText : infoText}}</view></scroll-view><button wx:if="{{legalOpen}}" class="primary" bindtap="closeLegal">我知道了</button><block wx:else><button class="primary" bindtap="closeInfo">我知道了</button></block></view></view>
</view>
