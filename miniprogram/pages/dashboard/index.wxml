<app-nav id="management-nav" current="dashboard"/>
<view class="page dashboard-page {{arriving ? 'home-arriving' : ''}}">
  <view class="profile-row">
    <view class="profile-avatar">{{user.name ? user.name[0] : '学'}}</view>
    <view class="profile-copy"><view class="profile-name">{{settings.institutionName || '晚辅智管'}}<text class="profile-role">{{owner ? '老板 / 总管理员' : admin ? '校长端' : teacher ? '教师端' : '家长端'}}</text></view><view class="profile-caption">{{user.name || '欢迎回来'}} · {{roleName}}</view></view>
    <date-picker class="plain-picker date-picker" value="{{date}}" label="{{teacher ? '选择工作日期' : '选择学习日期'}}" bindchange="changeDate"><view class="date-top">{{teacher ? '工作日期' : '学习日历'}}</view><view class="date-value">{{date}}</view></date-picker>
  </view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry"/>
  <block wx:if="{{!loading && !error && dashboard}}">
    <view wx:if="{{admin}}" class="admin-intro"><view class="section-title">{{owner ? '机构运营总览' : '校区运营概览'}}</view><text class="hint">{{date}} · 点击统计查看明细</text></view>
    <view wx:if="{{admin}}" class="teacher-stat-grid">
      <view wx:for="{{operationMetrics}}" wx:key="page" class="teacher-stat stat-{{item.tone}}" data-page="{{item.page}}" bindtap="go" hover-class="stat-pressed" role="button" aria-label="{{item.name}}，查看明细"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/><view><view class="teacher-stat-label">{{item.name}}<text class="stat-link">›</text></view><view class="teacher-stat-value">{{item.value}}<text>{{item.suffix}}</text></view></view></view>
    </view>
    <view wx:elif="{{teacher}}" class="teacher-stat-grid">
      <view class="teacher-stat stat-blue" data-page="attendance" bindtap="go" role="button" aria-label="查看学生到校情况"><image src="/assets/icons/attendance.svg" mode="aspectFit"/><view><view class="teacher-stat-label">到校人数 ›</view><view class="teacher-stat-value">{{dashboard.presentCount || 0}}<text>/{{dashboard.studentCount || 0}}</text></view></view></view>
      <view class="teacher-stat stat-coral" data-page="homework" bindtap="go" role="button" aria-label="查看作业"><image src="/assets/icons/homework.svg" mode="aspectFit"/><view><view class="teacher-stat-label">作业已完成 ›</view><view class="teacher-stat-value">{{dashboard.completedHomeworkCount || 0}}<text>/{{dashboard.homeworkCount || 0}}</text></view></view></view>
      <view class="teacher-stat stat-orange" data-page="homework" bindtap="go" role="button" aria-label="查看待订正作业"><image src="/assets/icons/mistakes.svg" mode="aspectFit"/><view><view class="teacher-stat-label">待订正作业 ›</view><view class="teacher-stat-value">{{dashboard.pendingCorrectionCount || 0}}<text>份</text></view></view></view>
      <view class="teacher-stat stat-amber" data-page="lessons" bindtap="go" role="button" aria-label="查看课程课时"><image src="/assets/icons/lessons.svg" mode="aspectFit"/><view><view class="teacher-stat-label">低课时提醒 ›</view><view class="teacher-stat-value">{{dashboard.lowBalanceCount || 0}}<text>人</text></view></view></view>
    </view>
    <view wx:else class="learning-banner">
      <view class="banner-orbit orbit-one"></view><view class="banner-orbit orbit-two"></view>
      <view class="banner-check">✓</view><view class="banner-copy"><view class="banner-label">今日成长概览</view><view class="banner-description">作业完成 {{dashboard.completedHomeworkCount || 0}} / {{dashboard.homeworkCount || 0}} 份 · 到校 {{dashboard.presentCount || 0}} 人</view></view><view class="banner-rate">{{percent}}<text>%</text></view>
    </view>
    <view wx:if="{{!teacher}}" class="parent-summary-grid">
      <view wx:for="{{metrics}}" wx:key="name" class="parent-summary-item" data-page="{{item.page}}" bindtap="go"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/><view><view class="parent-summary-label">{{item.name}} ›</view><view class="parent-summary-value">{{item.value}}<text>{{item.unit}}</text></view></view></view>
    </view>
    <view class="card application-card">
      <view class="card-head"><view class="section-title">{{owner ? '经营与管理' : admin ? '校区管理' : teacher ? '快捷应用' : '学习与成长'}}</view><text class="section-caption">{{admin ? '运营与师生管理' : teacher ? '高效安排每一天' : '陪伴孩子的每一步'}}</text></view>
      <view class="application-grid"><view wx:for="{{applications}}" wx:key="page" class="application" data-page="{{item.page}}" bindtap="go"><image class="application-icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/><text>{{item.name}}</text></view></view>
      <view class="application-grid second-grid"><view wx:for="{{management}}" wx:key="page" class="application" data-page="{{item.page}}" bindtap="go"><image class="application-icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/><text>{{item.name}}</text></view></view>
    </view>
    <view wx:if="{{!teacher}}" class="card">
      <view class="card-head"><view class="section-title">孩子的今天</view><text class="section-caption">学习情况</text></view>
      <view wx:for="{{children}}" wx:key="id" class="child-row"><view class="row"><view class="child-identity"><view class="child-avatar">{{item.name[0]}}</view><view><view class="child-name">{{item.name}}</view><view class="hint">{{item.className}}</view></view></view><text class="badge">{{item.attendanceText}}</text></view><view class="child-stats"><view><text class="child-value">{{item.homeworkCompleted}}/{{item.homeworkTotal}}</text><text>作业完成</text></view><view><text class="child-value">{{item.points}}</text><text>成长积分</text></view><view><text class="child-value">{{item.lessonBalance}}</text><text>剩余课时</text></view></view></view>
      <view wx:if="{{!children.length}}" class="empty-inline">暂无绑定孩子，请联系机构核实</view>
    </view>
    <view wx:if="{{admin && satisfactionStats.length}}" class="card"><view class="section-title">{{date}} · 日小结满意度</view><view wx:for="{{satisfactionStats}}" wx:key="classId" class="satisfaction-class"><view class="row"><view class="col">{{item.className}} · {{item.campusName}}</view><text class="satisfaction-percent">{{item.satisfactionPercent === null ? '暂无统计' : item.satisfactionPercent + '%'}}</text></view><view class="hint">已评价 {{item.submittedCount}} / {{item.parentCount}} · 默认满意 {{item.defaultCount}} · 不满意 {{item.dissatisfiedCount}}</view></view><view class="hint">按每个孩子的每位绑定家长统计；未评价计为满意。</view></view>
    <view wx:if="{{admin}}" class="card"><view class="row"><view><view class="section-title">当日已结算消课</view><view class="hint">按排课与学生签退的实际结算统计</view></view><view class="overview-value">{{dashboard.todayConsumed || 0}}<text>课时</text></view></view></view>
    <view wx:if="{{teacher && !owner}}" class="card overview-card"><view class="card-head"><view class="section-title">{{admin ? '教学运行情况' : '今日工作进度'}}</view><text class="section-caption">{{date}}</text></view><view class="overview-grid"><view wx:for="{{metrics}}" wx:key="name" class="overview-item" data-page="{{item.page}}" bindtap="go"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/><view><view class="overview-label">{{item.name}} ›</view><view class="overview-value">{{item.value}}<text>{{item.unit}}</text></view></view></view></view></view>
    <view wx:if="{{!owner}}" class="card"><view class="card-head"><view class="section-title">各科学习进度</view><text class="legend"><text class="legend-dot"></text>已完成</text></view><view wx:for="{{progress}}" wx:key="subject" class="subject-row"><view class="subject-symbol {{item.tone}}">{{item.subject[0]}}</view><view class="col"><view class="row"><text class="subject-name">{{item.subject}}</text><text class="subject-count">{{item.completed}}<text> / {{item.total}} 份</text></text></view><view class="progress"><view class="progress-inner {{item.tone}}" style="width:{{item.percent}}%"></view></view></view></view><view wx:if="{{!progress.length}}" class="empty-inline">当日暂无学习任务</view></view>
    <view wx:if="{{teacher && weekly.length}}" class="card"><view class="card-head"><view class="section-title">近七日出勤</view><text class="legend"><text class="legend-dot"></text>到校人数</text></view><view class="attendance-chart"><view wx:for="{{weekly}}" wx:key="date" class="chart-column" data-page="attendance" data-date="{{item.date}}" bindtap="go"><text class="chart-number">{{item.present}}</text><view class="chart-track"><view class="chart-fill" style="height:{{item.percent}}%"></view></view><text class="chart-label">{{item.shortDate}}</text></view></view></view>
    <view wx:if="{{!owner}}" class="card activity-card"><view class="card-head"><view class="section-title">成长动态</view><text class="section-caption">记录每一次进步</text></view><view wx:for="{{activities}}" wx:key="id" class="activity-row"><view class="activity-dot tone-{{item.tone}}"></view><view class="col"><view class="activity-title">{{item.title}}</view><view class="activity-detail">{{item.detail}}</view><view class="activity-time">{{item.timeText}}</view></view></view><view wx:if="{{!activities.length}}" class="empty-inline">今天的成长故事，等待记录</view></view>
    <view class="dashboard-footer">{{demo ? '体验环境 · 数据均为虚构' : '用心陪伴，记录成长'}}</view>
  </block>
</view>
