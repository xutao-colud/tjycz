.dashboard-page { padding-top: 18rpx; }
.home-arriving { animation: home-arrive 420ms ease-out; }
@keyframes home-arrive { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }
.profile-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx; padding: 0 2rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; border: 4rpx solid #fff; border-radius: 50%; color: #0071e3; background: #f4f4f7; font-size: 30rpx; font-weight: 600; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 30rpx; font-weight: 650; color: #1d1d1f; }
.profile-role { display: inline-block; margin-left: 10rpx; padding: 3rpx 9rpx; border-radius: 5rpx; color: #0071e3; background: #f4f4f7; font-size: 18rpx; font-weight: 400; vertical-align: middle; }
.profile-caption { overflow: hidden; margin-top: 7rpx; color: #737783; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.date-picker { flex-shrink: 0; text-align: right; }
.date-picker.plain-picker::after { display: block; right: 5rpx; top: 62%; }
.date-top { margin-bottom: 5rpx; color: #737783; font-size: 20rpx; }
.date-value { color: #737783; font-size: 20rpx; }
.teacher-stat-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; margin-bottom: 20rpx; }
.teacher-stat { display: flex; align-items: center; gap: 17rpx; min-height: 138rpx; padding: 22rpx 20rpx; border: 1rpx solid #fff; border-radius: 28rpx; }
.teacher-stat image { flex-shrink: 0; width: 56rpx; height: 56rpx; }
.stat-blue { background: linear-gradient(120deg,#f4f4f7,#f4f4f7); }
.stat-coral { background: linear-gradient(120deg,#fff0f0,#fff5f4); }
.stat-orange { background: linear-gradient(120deg,#fff4df,#fff8ed); }
.stat-amber { background: linear-gradient(120deg,#fff0e8,#fff8f1); }
.teacher-stat-label { color: #737783; font-size: 22rpx; }
.teacher-stat-value { margin-top: 4rpx; color: #1d1d1f; font-size: 42rpx; font-weight: 650; line-height: 1.2; }
.teacher-stat-value text { margin-left: 5rpx; color: #737783; font-size: 24rpx; font-weight: 400; }
.learning-banner { position: relative; overflow: hidden; display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(115deg,#245a8f,#3a78ae); margin-bottom: 18rpx; }
.banner-check { display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; width: 70rpx; height: 70rpx; border-radius: 50%; color: #fff; background: linear-gradient(#59dfbd,#36cfaa); border: 2rpx solid rgba(255,255,255,.4); font-size: 38rpx; }
.banner-copy { z-index: 1; flex: 1; min-width: 0; }
.banner-label { font-size: 29rpx; font-weight: 600; }
.banner-description { margin-top: 8rpx; color: rgba(255,255,255,.83); font-size: 20rpx; line-height: 1.6; }
.banner-rate { z-index: 1; font-size: 42rpx; font-weight: 600; }
.banner-rate text { margin-left: 3rpx; font-size: 22rpx; }
.banner-orbit { position: absolute; width: 220rpx; height: 220rpx; border: 36rpx solid rgba(255,255,255,.055); border-radius: 50%; }
.orbit-one { top: -150rpx; right: -20rpx; }
.orbit-two { bottom: -190rpx; right: 80rpx; width: 280rpx; height: 280rpx; }
.parent-summary-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.parent-summary-item { display: flex; align-items: center; gap: 16rpx; padding: 19rpx; border: 1rpx solid #fff; border-radius: 26rpx; background: #fff; }
.parent-summary-item image { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.parent-summary-label { color: #737783; font-size: 21rpx; }
.parent-summary-value { margin-top: 5rpx; color: #1d1d1f; font-size: 31rpx; font-weight: 650; line-height: 1.3; }
.parent-summary-value text { padding-left: 6rpx; color: #9295a0; font-size: 19rpx; font-weight: 400; }
.section-caption { color: #9295a0; font-size: 20rpx; }
.application-card { padding: 22rpx 18rpx 14rpx; }
.application-card .card-head { margin-bottom: 14rpx; padding: 0 6rpx; }
.application-grid { display: flex; flex-wrap: wrap; }
.application { display: flex; flex-direction: column; align-items: center; gap: 10rpx; width: 25%; padding: 10rpx 0 12rpx; color: #50535d; font-size: 22rpx; }
.application-icon { width: 66rpx; height: 66rpx; }
.second-grid { margin-top: 2rpx; }
.overview-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24rpx 16rpx; padding: 2rpx 0; }
.overview-item { display: flex; align-items: center; gap: 16rpx; }
.admin-intro { margin: 2rpx 2rpx 18rpx; }
.stat-link { margin-left: 12rpx; color: #737783; }
.stat-pressed { opacity: .7; }
.overview-item image { width: 44rpx; height: 44rpx; }
.overview-label { color: #9295a0; font-size: 21rpx; }
.overview-value { margin-top: 4rpx; color: #1d1d1f; font-size: 31rpx; font-weight: 600; line-height: 1.3; }
.overview-value text { padding-left: 7rpx; color: #9295a0; font-size: 19rpx; font-weight: 400; }
.subject-row { display: flex; align-items: center; gap: 18rpx; padding: 13rpx 0; }
.subject-symbol { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 54rpx; height: 54rpx; border-radius:20rpx; font-size: 24rpx; font-weight: 600; }
.subject-symbol.green { color: #23bb83; background: #e9f9f1; }
.subject-symbol.blue { color: #0071e3; background: #f4f4f7; }
.subject-symbol.purple { color: #9672e7; background: #f3eeff; }
.subject-name { color: #737783; font-size: 24rpx; }
.subject-count { color: #50535d; font-size: 24rpx; }
.subject-count text { color: #9295a0; font-size: 20rpx; }
.progress-inner.blue { background: #5299ff; }
.progress-inner.purple { background: #aa87ed; }
.legend { display: flex; align-items: center; gap: 8rpx; color: #9295a0; font-size: 20rpx; }
.legend-dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; background: #27c08a; }
.attendance-chart { display: flex; justify-content: space-between; gap: 16rpx; padding-top: 10rpx; }
.chart-column { display: flex; flex: 1; flex-direction: column; align-items: center; }
.chart-number { color: #737783; font-size: 20rpx; margin-bottom: 10rpx; }
.chart-track { display: flex; align-items: flex-end; overflow: hidden; width: 25rpx; height: 110rpx; border-radius: 5rpx; background: #f4f4f7; }
.chart-fill { width: 100%; min-height: 0; border-radius: 5rpx; background: linear-gradient(#557fae,#a6bedb); }
.chart-label { color: #9295a0; font-size: 17rpx; margin-top: 12rpx; white-space: nowrap; }
.activity-row { display: flex; gap: 17rpx; padding: 17rpx 0; border-bottom: 1rpx solid #e7e8ee; }
.activity-row:last-child { border-bottom: 0; padding-bottom: 0; }
.activity-dot { flex-shrink: 0; width: 11rpx; height: 11rpx; margin-top: 10rpx; border: 5rpx solid #e7e8ee; border-radius: 50%; background: #0071e3; box-sizing: content-box; }
.activity-dot.tone-1 { border-color: #e9f8f1; background: #26c18c; }
.activity-dot.tone-2 { border-color: #fff3df; background: #ffb841; }
.activity-title { color: #50535d; font-size: 25rpx; }
.activity-detail { margin-top: 6rpx; color: #737783; font-size: 23rpx; }
.activity-time { margin-top: 6rpx; color: #9295a0; font-size: 20rpx; }
.child-row { padding: 14rpx 0; border-bottom: 1rpx solid #e7e8ee; }
.child-row:last-child { padding-bottom: 0; border-bottom: 0; }
.child-identity { display: flex; align-items: center; gap: 14rpx; }
.child-avatar { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; background: #f4f4f7; color: #0071e3; font-size: 26rpx; }
.child-name { font-size: 27rpx; font-weight: 500; }
.child-identity .hint { margin-top: 3rpx; }
.child-stats { display: flex; margin-top: 18rpx; padding: 18rpx 0; border-radius:20rpx; background: #fafafd; }
.child-stats view { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 5rpx; color: #9295a0; font-size: 20rpx; }
.child-stats .child-value { color: #50535d; font-size: 28rpx; font-weight: 600; }
.dashboard-footer { padding: 6rpx 0; color: #9295a0; text-align: center; font-size: 20rpx; letter-spacing: 1rpx; }
