.dashboard-page { padding-top: 16rpx; }
.home-arriving { animation: home-arrive 420ms ease-out; }
@keyframes home-arrive { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }
.profile-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; padding: 0 2rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; border: 4rpx solid var(--surface, #ffffff); border-radius: 50%; color: var(--accent, #176b91); background: var(--subtle, #eef1ef); font-size: 32rpx; font-weight: 600; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 32rpx; font-weight: 600; color: var(--ink, #263238); }
.profile-role { display: inline-block; margin-left: 8rpx; padding: 3rpx 8rpx; border-radius: 8rpx; color: var(--accent, #176b91); background: var(--subtle, #eef1ef); font-size: 24rpx; font-weight: 400; vertical-align: middle; }
.profile-caption { overflow: hidden; margin-top: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.date-picker { flex-shrink: 0; text-align: right; }
.date-picker.plain-picker::after { display: block; right: 5rpx; top: 62%; }
.date-top { margin-bottom: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.date-value { color: var(--secondary, #536168); font-size: 24rpx; }
.teacher-stat-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin-bottom: 24rpx; }
.teacher-stat { display: flex; align-items: center; gap: 16rpx; min-height: 138rpx; padding: 24rpx 24rpx; border: 1rpx solid var(--surface, #ffffff); border-radius: 32rpx; }
.teacher-stat image { flex-shrink: 0; width: 56rpx; height: 56rpx; }
.stat-blue { background: var(--subtle, #eef1ef); }
.stat-coral { background: var(--subtle, #eef1ef); }
.stat-orange { background: var(--warning-soft, #fbf3e5); }
.stat-amber { background: var(--danger-soft, #fceff0); }
.teacher-stat-label { color: var(--secondary, #536168); font-size: 24rpx; }
.teacher-stat-value { margin-top: 8rpx; color: var(--ink, #263238); font-size: 44rpx; font-weight: 600; line-height: 1.2; }
.teacher-stat-value text { margin-left: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; font-weight: 400; }
.learning-banner { position: relative; overflow: hidden; display: flex; align-items: center; gap: 24rpx; padding: 32rpx 24rpx; border-radius: 32rpx; color: var(--surface, #ffffff); background: var(--accent, #176b91); margin-bottom: 16rpx; }
.banner-check { display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; width: 70rpx; height: 70rpx; border-radius: 50%; color: var(--surface, #ffffff); background: var(--success, #23734e); border: 2rpx solid rgba(255,255,255,.4); font-size: 40rpx; }
.banner-copy { z-index: 1; flex: 1; min-width: 0; }
.banner-label { font-size: 28rpx; font-weight: 600; }
.banner-description { margin-top: 8rpx; color: rgba(255,255,255,.83); font-size: 24rpx; line-height: 1.6; }
.banner-rate { z-index: 1; font-size: 44rpx; font-weight: 600; }
.banner-rate text { margin-left: 3rpx; font-size: 24rpx; }
.banner-orbit { position: absolute; width: 220rpx; height: 220rpx; border: 36rpx solid rgba(255,255,255,.055); border-radius: 50%; }
.orbit-one { top: -150rpx; right: -20rpx; }
.orbit-two { bottom: -190rpx; right: 80rpx; width: 280rpx; height: 280rpx; }
.parent-summary-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin-bottom: 24rpx; }
.parent-summary-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; border: 1rpx solid var(--surface, #ffffff); border-radius: 24rpx; background: var(--surface, #ffffff); }
.parent-summary-item image { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.parent-summary-label { color: var(--secondary, #536168); font-size: 24rpx; }
.parent-summary-value { margin-top: 8rpx; color: var(--ink, #263238); font-size: 32rpx; font-weight: 600; line-height: 1.3; }
.parent-summary-value text { padding-left: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; font-weight: 400; }
.section-caption { color: var(--secondary, #536168); font-size: 24rpx; }
.application-card { padding: 24rpx 16rpx 16rpx; }
.application-card .card-head { margin-bottom: 16rpx; padding: 0 8rpx; }
.application-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); }
.application { display: flex; flex-direction: column; align-items: center; gap: 8rpx; min-width: 0; padding: 8rpx 0 16rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.application-icon { width: 66rpx; height: 66rpx; }
.second-grid { margin-top: 2rpx; }
.overview-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24rpx 16rpx; padding: 2rpx 0; }
.overview-item { display: flex; align-items: center; gap: 16rpx; }
.admin-intro { margin: 2rpx 2rpx 16rpx; }
.stat-link { margin-left: 16rpx; color: var(--secondary, #536168); }
.stat-pressed { opacity: .7; }
.overview-item image { width: 44rpx; height: 44rpx; }
.overview-label { color: var(--secondary, #536168); font-size: 24rpx; }
.overview-value { margin-top: 8rpx; color: var(--ink, #263238); font-size: 32rpx; font-weight: 600; line-height: 1.3; }
.overview-value text { padding-left: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; font-weight: 400; }
.subject-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.subject-symbol { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 54rpx; height: 54rpx; border-radius:24rpx; font-size: 24rpx; font-weight: 600; }
.subject-symbol.green { color: var(--success, #23734e); background: var(--subtle, #eef1ef); }
.subject-symbol.blue { color: var(--accent, #176b91); background: var(--subtle, #eef1ef); }
.subject-symbol.purple { color: var(--accent, #176b91); background: var(--subtle, #eef1ef); }
.subject-name { color: var(--secondary, #536168); font-size: 24rpx; }
.subject-count { color: var(--secondary, #536168); font-size: 24rpx; }
.subject-count text { color: var(--secondary, #536168); font-size: 24rpx; }
.progress-inner.blue { background: var(--accent, #176b91); }
.progress-inner.purple { background: var(--accent, #176b91); }
.legend { display: flex; align-items: center; gap: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.legend-dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--success, #23734e); }
.attendance-chart { display: flex; justify-content: space-between; gap: 16rpx; padding-top: 8rpx; }
.chart-column { display: flex; flex: 1; flex-direction: column; align-items: center; }
.chart-number { color: var(--secondary, #536168); font-size: 24rpx; margin-bottom: 8rpx; }
.chart-track { display: flex; align-items: flex-end; overflow: hidden; width: 25rpx; height: 110rpx; border-radius: 8rpx; background: var(--subtle, #eef1ef); }
.chart-fill { width: 100%; min-height: 0; border-radius: 8rpx; background: var(--accent, #176b91); }
.chart-label { color: var(--secondary, #536168); font-size: 24rpx; margin-top: 16rpx; white-space: nowrap; }
.activity-row { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line, #dce2df); }
.activity-row:last-child { border-bottom: 0; padding-bottom: 0; }
.activity-dot { flex-shrink: 0; width: 11rpx; height: 11rpx; margin-top: 8rpx; border: 5rpx solid var(--line, #dce2df); border-radius: 50%; background: var(--accent, #176b91); box-sizing: content-box; }
.activity-dot.tone-1 { border-color: var(--line, #dce2df); background: var(--success, #23734e); }
.activity-dot.tone-2 { border-color: var(--line, #dce2df); background: var(--warning, #885c18); }
.activity-title { color: var(--secondary, #536168); font-size: 24rpx; }
.activity-detail { margin-top: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.activity-time { margin-top: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.child-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line, #dce2df); }
.child-row:last-child { padding-bottom: 0; border-bottom: 0; }
.child-identity { display: flex; align-items: center; gap: 16rpx; }
.child-avatar { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--subtle, #eef1ef); color: var(--accent, #176b91); font-size: 28rpx; }
.child-name { font-size: 28rpx; font-weight: 500; }
.child-identity .hint { margin-top: 3rpx; }
.child-stats { display: flex; margin-top: 16rpx; padding: 16rpx 0; border-radius:24rpx; background: var(--subtle, #eef1ef); }
.child-stats view { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.child-stats .child-value { color: var(--secondary, #536168); font-size: 28rpx; font-weight: 600; }
.dashboard-footer { padding: 8rpx 0; color: var(--secondary, #536168); text-align: center; font-size: 24rpx; letter-spacing: 0; }

.satisfaction-class{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}.satisfaction-percent{color:var(--accent, #176b91);font-size:36rpx;font-weight:600}

.profile-row{padding:32rpx 24rpx;border-radius:32rpx;background:var(--accent, #176b91);box-shadow:none;margin-bottom:24rpx}.profile-name{color:var(--surface, #ffffff)}.profile-caption{color:var(--muted, #68767c)}.profile-role{background:rgba(255,255,255,.17);color:var(--muted, #68767c);border-radius:8rpx;padding:8rpx 8rpx}.profile-avatar{color:var(--accent, #176b91);border-color:var(--line, #dce2df);background:var(--surface, #ffffff)}.profile-row .date-top,.profile-row .date-value{color:var(--muted, #68767c)}.satisfaction-class{padding:24rpx 0}.satisfaction-percent{color:var(--accent, #176b91);font-size:40rpx}.application-card{border-top:4rpx solid var(--line, #dce2df)}.application{border-radius:24rpx;background:var(--subtle, #eef1ef);padding:24rpx 8rpx}.application-grid{gap:16rpx}.second-grid{margin-top:16rpx}
.profile-row { background:var(--surface);border:1rpx solid var(--line);border-left:4rpx solid var(--accent);padding:24rpx; }
.profile-name { color:var(--ink); }
.profile-caption,.profile-role,.profile-row .date-top,.profile-row .date-value { color:var(--secondary); }
.profile-role { background:var(--subtle); }
