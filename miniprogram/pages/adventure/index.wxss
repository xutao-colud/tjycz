page{background:#f8f9f7}.adventure-page{padding:32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));color:#24353c}.adventure-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:32rpx}.adventure-heading .title{font-size:48rpx;font-weight:600}.adventure-heading .eyebrow{font-size:24rpx;color:#627078}.child-choice{font-size:26rpx;max-width:180rpx;word-break:break-all}.mode-switch{display:flex;gap:8rpx;padding:8rpx;background:#ecefeb;border-radius:24rpx;margin-bottom:24rpx}.mode-switch button{flex:1;min-width:0;background:transparent;padding:20rpx 8rpx;margin:0;color:#536168;font-size:28rpx;border-radius:16rpx}.mode-switch button.selected{background:#fff;color:#175b85;box-shadow:0 2rpx 4rpx #0000000a}.world{overflow:hidden;background:#fff;border:1rpx solid #dce2df;border-radius:32rpx}.world-heading{padding:32rpx 32rpx 0}.world-kicker{color:#176b91;font-size:24rpx}.world-title{font-size:40rpx;font-weight:600;margin:8rpx 0}.world-description{color:#536168;font-size:26rpx;line-height:1.6}.map-scene{position:relative;height:360rpx;margin:0 16rpx}.map-art{width:100%;height:100%}.map-pet{position:absolute;width:144rpx;height:144rpx;left:8rpx;bottom:32rpx}.seals{position:absolute;left:29%;right:12%;top:50%;display:flex;justify-content:space-between}.seal{height:56rpx;width:56rpx;border:4rpx solid #fff;border-radius:50%;background:#e6ebe8;color:#536168;display:flex;align-items:center;justify-content:center;font-size:26rpx}.seal:nth-child(2){transform:translateY(-56rpx)}.seal.earned{background:#176b91;color:#fff}.map-caption{position:absolute;right:16rpx;bottom:16rpx;font-size:24rpx;color:#536168}.pet-scene{display:flex;flex-direction:column;align-items:center;width:100%;margin:0;padding:8rpx 24rpx 24rpx;background:transparent;border-radius:0}.pet-scene image{width:320rpx;height:320rpx}.pet-scene text{font-size:24rpx;color:#536168}.level{padding:24rpx 32rpx 32rpx;border-top:1rpx solid #eef1ef;font-size:24rpx;color:#536168;font-variant-numeric:tabular-nums}.level-number{font-size:36rpx;font-weight:600;color:#175b85}.level-name{display:block;margin-top:4rpx;font-size:24rpx}.xp-track{height:12rpx;border-radius:8rpx;background:#eef1ef;overflow:hidden;margin:24rpx 0 16rpx}.xp-track view{height:100%;background:#176b91;border-radius:8rpx}.level-note{display:flex;justify-content:space-between;gap:8rpx;font-size:24rpx}.level-note text{color:#175b85}.companion-bar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 0;color:#536168;font-size:24rpx}.companion-bar button,.secondary-links button{width:auto;min-height:88rpx;padding:16rpx 0;margin:0;background:transparent;font-size:24rpx;color:#176b91}.companion-settings{padding:24rpx;background:#fff;border:1rpx solid #dce2df;border-radius:24rpx}.pet-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.pet-options button{width:100%;min-width:0;padding:8rpx;border:2rpx solid transparent;background:#f5f6f4;border-radius:16rpx;font-size:26rpx}.pet-options button.chosen{border-color:#176b91;background:#edf4f7}.pet-options image{display:block;width:100%;height:128rpx}.name-form{display:flex;gap:16rpx;margin-top:24rpx}.name-form input{flex:1;min-width:0}.name-form button{width:auto;flex-shrink:0;margin:0}.section-head{margin:32rpx 0 16rpx}.task-list{border-top:1rpx solid #dce2df}.task-row{display:flex;align-items:center;gap:16rpx;width:100%;margin:0;padding:24rpx 0;background:transparent;text-align:left;border-radius:0;border-bottom:1rpx solid #dce2df}.task-check{flex-shrink:0;width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #b8c7cd;border-radius:12rpx;color:#627078}.task-check.done{background:#176b91;color:white;border-color:#176b91}.task-title{font-size:28rpx;font-weight:500}.task-description{font-size:24rpx;color:#536168;line-height:1.6;margin-top:8rpx}.task-reward{flex-shrink:0;text-align:right;font-size:24rpx;color:#176b91}.task-reward text{display:block}.task-reward text:first-child{color:#627078;margin-bottom:8rpx}.task-footnote{font-size:24rpx;color:#627078;margin:16rpx 0 32rpx;line-height:1.6}.collection{display:flex;align-items:center;gap:24rpx;padding:24rpx 0}.stamp{display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;width:128rpx;height:128rpx;border:3rpx double #176b91;border-radius:50%;color:#176b91;transform:rotate(-6deg);font-size:20rpx}.stamp text:first-child{font-size:40rpx;font-weight:600}.reward-entry{display:flex;justify-content:space-between;align-items:center;gap:16rpx;width:100%;padding:24rpx 0;margin:16rpx 0 0;border-radius:0;border-top:1rpx solid #dce2df;border-bottom:1rpx solid #dce2df;background:transparent;text-align:left;font-size:26rpx}.reward-entry>view:last-child{white-space:nowrap;color:#176b91}.reward-entry>view:last-child text{font-size:36rpx;font-weight:600}.secondary-links{display:flex;justify-content:space-between}.rules,.journal{background:#fff;padding:24rpx;border-radius:24rpx;border:1rpx solid #dce2df;font-size:26rpx;color:#536168;line-height:1.8}.rules>view+view{margin-top:16rpx}.journal-row{padding:16rpx 0;border-bottom:1rpx solid #eef1ef}.journal-row .hint{display:block}.adventure-page button:active{opacity:.8}.adventure-page button:focus-visible{outline:4rpx solid #176b91;outline-offset:4rpx}
