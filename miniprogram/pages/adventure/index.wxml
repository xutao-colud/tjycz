<app-nav current="adventure" />
<view class="page adventure-page">
  <view class="adventure-heading"><view><view class="eyebrow">天健悦成长 · 每一步都算数</view><view class="title">成长乐园</view></view><select-picker wx:if="{{students.length > 1}}" range="{{childNames}}" value="{{childIndex}}" bindchange="chooseChild" label="切换孩子" disabled="{{busy}}" plain="{{true}}"><view class="child-choice">{{childNames[childIndex]}} ⌄</view></select-picker></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !adventure}}" empty-text="绑定孩子后，开启成长旅程" bindretry="retry" />
  <block wx:if="{{!loading && !error && adventure}}">
    <view class="mode-switch"><button class="{{adventure.mode === 'ADVENTURE' ? 'selected' : ''}}" data-mode="ADVENTURE" bindtap="mode" disabled="{{busy || teacher}}">探险闯关</button><button class="{{adventure.mode === 'PET' ? 'selected' : ''}}" data-mode="PET" bindtap="mode" disabled="{{busy || teacher}}">伙伴养成</button></view>
    <view class="world">
      <view class="world-heading"><view class="world-kicker">{{adventure.mode === 'ADVENTURE' ? '第 ' + adventure.chapter + ' 章' : adventure.stageName}}</view><view class="world-title">{{adventure.mode === 'ADVENTURE' ? adventure.chapterName : adventure.petName + '的成长营地'}}</view><view class="world-description">{{adventure.mode === 'ADVENTURE' ? '每完成一天学习挑战，就点亮一枚路标' : '作业、运动和努力，让伙伴陪你一起长大'}}</view></view>
      <view wx:if="{{adventure.mode === 'ADVENTURE'}}" class="map-scene"><image class="map-art" src="/assets/adventure/trail.svg" mode="aspectFit"/><image class="map-pet" src="{{adventure.petImage}}" mode="aspectFit"/><view class="seals"><view wx:for="{{adventure.sealsList}}" wx:key="id" class="seal {{item.earned ? 'earned' : ''}}"><text>{{item.earned ? '✓' : item.id + 1}}</text></view></view><view class="map-caption">迷雾关卡 · {{adventure.seals}} / 3 枚路标</view></view>
      <button wx:else class="pet-scene" bindtap="greet" aria-label="和成长伙伴打招呼"><image src="{{adventure.petImage}}" mode="aspectFit"/><text>{{greeting || '点点伙伴，和它打个招呼'}}</text></button>
      <view class="level"><view class="row"><view><text class="level-number">Lv.{{adventure.level}}</text><text class="level-name">{{adventure.studentName}}的成长记录</text></view><text>{{adventure.levelXp}} / {{adventure.nextLevelXp}} 经验</text></view><view class="xp-track"><view style="width:{{adventure.percent}}%"></view></view><view class="level-note">再获得 {{adventure.remaining}} 经验升到下一级<text>今日 +{{adventure.todayXp}}</text></view></view>
    </view>
    <view class="companion-bar"><text>{{adventure.petName}} · {{adventure.stageName}}</text><button wx:if="{{!teacher}}" bindtap="customize">{{customizeOpen ? '收起设置' : '选择伙伴 / 改名'}}</button></view>
    <view wx:if="{{customizeOpen && !teacher}}" class="companion-settings"><view class="pet-options"><button wx:for="{{pets}}" wx:key="key" class="{{adventure.pet === item.key ? 'chosen' : ''}}" data-pet="{{item.key}}" bindtap="pet" disabled="{{busy}}"><image src="{{item.image}}" mode="aspectFit"/><text>{{item.name}}</text></button></view><view class="name-form"><input aria-label="伙伴名字" value="{{nameDraft}}" data-field="nameDraft" bindinput="field" maxlength="12" placeholder="给伙伴起个名字" disabled="{{busy}}"/><button class="primary" bindtap="rename" disabled="{{busy}}">保存</button></view><view class="hint">更换伙伴保留全部经验，Lv.3 获得围巾，Lv.5 获得探险装备</view></view>
    <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
    <view class="section-head"><view class="section-title">今天的小小挑战</view><text class="muted">{{adventure.doneCount}} / 3 已完成</text></view>
    <view class="task-list"><button wx:for="{{adventure.tasks}}" wx:key="key" class="task-row" data-key="{{item.key}}" bindtap="task"><view class="task-check {{item.done ? 'done' : ''}}">{{item.done ? '✓' : '·'}}</view><view class="col"><view class="task-title">{{item.title}}</view><view class="task-description">{{item.description}}</view></view><view class="task-reward"><text>{{item.done ? '已获得' : '可获得'}}</text><text>{{item.variableExperience ? '最高 ' : '+'}}{{item.xp}} 经验</text><text>{{item.variablePoints ? '最高 ' : '+'}}{{item.points}} 积分</text></view></button></view>
    <view class="task-footnote">按老师确认当天记录，每类每天一次；按自身情况参与，不要求全部完成</view>
    <view class="collection"><view class="stamp"><text>{{adventure.badges}}</text><text>成长印章</text></view><view class="col"><view class="section-title">把努力收进手册</view><view class="hint">累计三个学习日，击退一只迷雾怪，留下一个印章。中断不会清零</view></view></view>
    <button class="reward-entry" bindtap="rewards"><view><view class="section-title">我的奖励积分</view><view class="hint">兑换奖品不影响等级与伙伴成长</view></view><view><text>{{adventure.points}}</text> 分 ›</view></button>
    <view class="secondary-links"><button bindtap="journal">{{journalOpen ? '收起成长记录' : '查看成长记录'}}</button><button bindtap="rules">{{rulesOpen ? '收起规则' : '成长规则'}}</button></view>
    <view wx:if="{{journalOpen}}" class="journal"><view wx:for="{{adventure.recent}}" wx:key="index" class="row journal-row"><view>{{item.title}}<text class="hint">{{item.date}}</text></view><text>+{{item.amount}} 经验 · {{item.points}} 积分</text></view><view wx:if="{{!adventure.recent.length}}" class="hint">第一份成长记录，等待下一次努力</view></view>
    <view wx:if="{{rulesOpen}}" class="rules"><view class="section-title">每一次努力都有依据</view><view>作业完成或订正通过共用每日学习挑战，体能与努力鼓励分别结算；各类经验每天奖励一次，数额按管理员设置执行。积分按具体事项和每次确认发放，设为0经验的规则只奖励积分</view><view>玩法、伙伴和名字按孩子保存，绑定家长共同管理。切换模式不会重复奖励</view><view>经验从功能启用后的新记录开始累计，按老师确认日期计算。原有积分不换算为经验，小结发布、手动调分和奖品兑换不产生经验</view><view>等级越高，下一次升级需要的经验越多；休息或请假不会扣经验，也不会让伙伴生病</view></view>
  </block>
</view>
