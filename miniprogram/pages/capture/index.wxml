<app-nav />
<view class="page capture-page"><view class="hero"><view class="title">手工录题</view><view class="subtitle">拍清题目，校对后保存。</view><button class="text-button" data-url="/pages/scan/index?studentId={{studentIds[0] || ''}}" bindtap="go">整页自动识别与分题 ›</button></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry" /><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" bindchange="pickStudents" /><view class="card"><view class="capture-steps"><text>1 拍照</text><text>2 校对题目</text><text>3 确认保存</text></view><view class="field"><text class="label">科目</text><select-picker range="{{subjects}}" value="{{subjectIndex}}" data-field="subjectIndex" bindchange="choose" label="选择科目"><view class="form-pick">{{subjects[subjectIndex] || '选择科目'}}</view></select-picker></view><view class="field"><text class="label">保存到</text><select-picker range="{{kinds}}" value="{{kindIndex}}" data-field="kindIndex" bindchange="choose" label="保存位置"><view class="form-pick">{{kinds[kindIndex] || '保存位置'}}</view></select-picker></view><button class="primary gap" bindtap="snap" disabled="{{busy || !studentIds.length}}">{{photo ? '重新拍照或选择照片' : '拍照 / 从相册选择'}}</button><image wx:if="{{photoUrl}}" src="{{photoUrl}}" mode="widthFix" class="capture-photo" /><view wx:if="{{note}}" class="capture-note">{{note}}</view><view class="field"><text class="label">校对题目（照片清楚可留空）</text><textarea value="{{question}}" data-field="question" bindinput="field" disabled="{{busy}}" maxlength="{{kindIndex ? 2000 : 10000}}" placeholder="可按照片填写题目，知识点与错误原因可后补" /></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><button class="primary gap" bindtap="save" disabled="{{busy || !photo || saved}}" loading="{{busy}}">{{saved ? '已保存' : '确认并保存'}}</button><view wx:if="{{saved}}" class="actions gap"><button class="secondary" bindtap="view">查看记录</button><button class="secondary" bindtap="next">继续拍下一题</button></view></view></block></view>
