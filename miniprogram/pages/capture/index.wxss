.capture-steps{display:flex;justify-content:space-between;color:var(--muted, #68767c);font-size:24rpx;margin-bottom:32rpx}.capture-photo{display:block;width:100%;border-radius:32rpx;margin:32rpx 0;background:var(--subtle, #eef1ef)}.capture-note{padding:24rpx;background:var(--warning-soft, #fbf3e5);border-radius:24rpx;font-size:24rpx;line-height:1.8;color:var(--warning, #885c18)}
