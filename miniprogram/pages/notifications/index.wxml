<app-nav /><view class="page"><view class="hero"><view class="title">到离校消息</view><view class="subtitle">孩子的每一次到达与归家，都清楚留在这里。</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry" /><block wx:if="{{!loading && !error}}"><student-picker students="{{students}}" selected="{{studentIds}}" bindchange="pickStudents" /><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><view class="card-title col">{{item.title}}</view><text class="badge {{item.readAt ? 'dim' : ''}}">{{item.readAt ? '已读' : '未读'}}</text></view><view class="message-body">{{item.message}}</view><view class="hint">{{item.createdText}}<text wx:if="{{teacher}}"> · 接收家长：{{item.parentName}}</text></view><file-list files="{{item.attachments}}" /><view class="hint gap">站内消息已生成，微信订阅推送尚未配置。</view><button wx:if="{{!teacher && !item.readAt}}" class="text-button gap" data-id="{{item.id}}" bindtap="read" disabled="{{busy}}">我已知晓</button></view><state-view empty="{{!items.length}}" empty-text="暂无到离校消息" /><view wx:if="{{actionError}}" class="error">{{actionError}}</view></block></view>
