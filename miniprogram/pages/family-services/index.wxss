.family-page .hero{margin-bottom:24rpx}.family-page .card{border-radius:30rpx;box-shadow:0 8rpx 30rpx rgba(45,60,83,.035);margin-bottom:24rpx}.family-child{display:flex;align-items:center;gap:20rpx}.family-avatar{width:104rpx;height:104rpx;flex-shrink:0;border-radius:30rpx;background:#eff4fb}.family-name{font-size:32rpx;font-weight:600}.family-child .text-button{flex-shrink:0;font-size:25rpx}.family-warning{background:#fff4e7;color:#9a622e;border-radius:28rpx;padding:30rpx;margin:24rpx 0}.family-warning .hint{color:#a07851;margin-top:8rpx}.family-page>.section-title{margin:30rpx 0 20rpx}.family-balance{font-size:68rpx;font-weight:650;padding:12rpx 0}.family-balance text{font-size:27rpx;font-weight:400;margin-left:10rpx;color:#8d94a4}.family-order-status{font-size:30rpx;padding:28rpx 0}.family-meal-symbol{width:66rpx;height:66rpx;line-height:66rpx;text-align:center;border-radius:22rpx;color:#a67643;background:#fff3e5;font-size:32rpx}.family-list-row{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #edf0f5}.family-list-row:last-child{border:0}.family-list-row .badge{flex-shrink:0}.family-list-title{font-size:28rpx;font-weight:550;line-height:1.6}.family-qr{display:block;width:330rpx;height:330rpx;margin:24rpx auto;border-radius:24rpx;background:#fff}.family-page .actions{display:flex;flex-wrap:wrap;gap:16rpx}.family-page .actions button{flex:1;min-width:160rpx}.family-page .section-title{font-size:32rpx}.family-payment .hint{line-height:1.8}
