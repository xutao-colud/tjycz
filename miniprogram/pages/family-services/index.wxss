.family-page .hero{margin-bottom:24rpx}.family-page .card{border-radius:32rpx;box-shadow:none;margin-bottom:24rpx}.family-child{display:flex;align-items:center;gap:24rpx}.family-avatar{width:104rpx;height:104rpx;flex-shrink:0;border-radius:32rpx;background:var(--subtle, #eef1ef)}.family-name{font-size:32rpx;font-weight:600}.family-child .text-button{flex-shrink:0;font-size:24rpx}.family-warning{background:var(--warning-soft, #fbf3e5);color:var(--danger, #b33740);border-radius:32rpx;padding:32rpx;margin:24rpx 0}.family-warning .hint{color:var(--danger, #b33740);margin-top:8rpx}.family-page>.section-title{margin:32rpx 0 24rpx}.family-balance{font-size:68rpx;font-weight:600;padding:16rpx 0}.family-balance text{font-size:28rpx;font-weight:400;margin-left:8rpx;color:var(--muted, #68767c)}.family-order-status{font-size:32rpx;padding:32rpx 0}.family-meal-symbol{width:66rpx;height:66rpx;line-height:66rpx;text-align:center;border-radius:24rpx;color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5);font-size:32rpx}.family-list-row{display:flex;align-items:center;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}.family-list-row:last-child{border:0}.family-list-row .badge{flex-shrink:0}.family-list-title{font-size:28rpx;font-weight:550;line-height:1.6}.family-qr{display:block;width:330rpx;height:330rpx;margin:24rpx auto;border-radius:24rpx;background:var(--surface, #ffffff)}.family-page .actions{display:flex;flex-wrap:wrap;gap:16rpx}.family-page .actions button{flex:1;min-width:160rpx}.family-page .section-title{font-size:32rpx}.family-payment .hint{line-height:1.8}
