<app-nav />
<view class="page family-page">
  <view class="hero"><view class="title">{{teacher ? '续费意向与订餐' : '课程与今日订餐'}}</view><view class="subtitle">每一份安排，都清楚可见。</view></view>
  <view class="card"><select-picker range="{{childNames}}" value="{{childIndex}}" bindchange="changeChild" label="选择孩子"><view class="form-pick">{{childNames[childIndex] || '选择孩子'}}</view></select-picker></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  <view wx:if="{{mediaBlocked}}" class="notice">孩子头像需要有效的服务与媒体授权。<button wx:if="{{mediaCanConsent}}" class="text-button" bindtap="openMediaConsent">阅读说明并授权</button><view wx:else>请该孩子的绑定监护人在“隐私与授权”中确认。</view></view>
  <block wx:if="{{!loading && !error}}">
    <view wx:if="{{family}}" class="card family-child"><image class="family-avatar" src="{{avatarUrl}}" mode="aspectFill" /><view class="col"><view class="family-name">{{family.student.name}}</view><view class="hint">{{family.student.grade}} · {{family.student.className}}</view><view class="hint">{{family.student.campusName}}</view></view><button class="text-button" data-kind="avatar" bindtap="choosePhoto" disabled="{{busy || uploading}}">上传头像</button></view>
    <block wx:if="{{!teacher && family}}">
      <view wx:if="{{lowCount}}" class="family-warning"><view class="family-name">有 {{lowCount}} 门课程需要关注余额</view><view class="hint">按课程预警线提醒，可直接选择续费意向。</view></view>
      <view class="section-title">课程余额</view>
      <view wx:for="{{accounts}}" wx:key="id" class="card"><view class="row"><view class="family-name col">{{item.courseName}}</view><text class="badge {{item.lowBalance ? 'warn' : ''}}">{{item.lowBalance ? '余额预警' : '余额充足'}}</text></view><view class="family-balance">{{item.available}}<text>{{item.unit}}</text></view><view class="hint">预警线 {{item.warningThreshold}} {{item.unit}}<text wx:if="{{item.refundReserved}}"> · 退款预留 {{item.refundReserved}} {{item.unit}}</text></view><view class="field"><view class="label">续费意向</view><select-picker range="{{intentNames}}" value="{{item.intentIndex}}" data-id="{{item.id}}" bindchange="intention" label="选择续费意向"><view class="form-pick">{{intentNames[item.intentIndex] || '选择续费意向'}}</view></select-picker></view></view>
      <view wx:if="{{!accounts.length}}" class="card hint">暂无课程账户，请联系校区核对报名。</view>
      <view class="card"><view class="row"><view class="section-title col">今天订餐</view><text class="family-meal-symbol">餐</text></view><view class="hint">{{family.date}} · {{mealPriceText ? '餐费 ' + mealPriceText : '校区尚未设置餐费'}}</view><view class="family-order-status">{{family.meal ? family.meal.ordered ? '已订餐 · 本单 ' + mealAmountText : '今天不订餐' : '尚未选择今日用餐安排'}}</view><view class="actions"><button class="primary" data-ordered="yes" bindtap="orderMeal" disabled="{{busy || uploading || family.settings.mealPrice === null || family.meal.ordered === true}}">今天订餐</button><button class="secondary" data-ordered="no" bindtap="orderMeal" disabled="{{busy || uploading || family.meal.ordered === false}}">今天不订餐</button></view><view class="hint gap">餐费按下单时的价格记录，不扣课程课时。</view></view>
      <view class="card family-payment"><view class="section-title">扫码缴费</view><block wx:if="{{family.settings.paymentQr}}"><view class="hint">{{family.settings.campusName}}</view><button class="primary gap" bindtap="openQr">查看缴费二维码</button><view class="hint gap">打开后可长按查看或保存。线下缴费后请校区核对到账，不自动增加课时或标记已付款。</view></block><view wx:else class="hint gap">校区暂未设置缴费二维码，请联系老师。</view></view>
    </block>
    <block wx:if="{{teacher}}"><view class="card"><view class="section-title">家长续费意向</view><view wx:for="{{intents}}" wx:key="id" class="family-list-row"><view class="col"><view class="family-list-title">{{item.studentName}} · {{item.courseName}}</view><view class="hint">{{item.parentName}} · {{item.campusName}}</view></view><text class="badge {{item.intention === 'INTERESTED' ? '' : 'warn'}}">{{item.intentionText}}</text></view><view wx:if="{{!intents.length}}" class="hint gap">当前权限范围内暂无家长续费意向。</view></view><view class="card"><view class="row"><view class="section-title col">{{date}} 订餐 · {{mealCount}} 份</view><date-picker value="{{date}}" bindchange="changeDate" label="查看订餐日期"><view class="form-pick">{{date}} ⌄</view></date-picker></view><view wx:for="{{meals}}" wx:key="id" class="family-list-row"><view class="col"><view class="family-list-title">{{item.studentName}} · {{item.className}}</view><view class="hint">{{item.parentName}} · {{item.campusName}} · {{item.amountText}}</view></view><text class="badge {{item.ordered ? '' : 'dim'}}">{{item.ordered ? '已订餐' : '不订餐'}}</text></view><view wx:if="{{!meals.length}}" class="hint gap">当日暂无订餐选择。</view></view></block>
    <view wx:if="{{admin}}" class="card"><view class="section-title">校区餐费与收款码</view><select-picker range="{{campusNames}}" value="{{configIndex}}" bindchange="changeConfigCampus" label="设置哪个校区"><view class="form-pick">{{campusNames[configIndex] || '设置哪个校区'}}</view></select-picker><block wx:if="{{config}}"><view class="field"><text class="label">每份餐费（元，留空暂停订餐）</text><input value="{{configPrice}}" data-field="configPrice" bindinput="field" type="digit" disabled="{{busy || uploading}}" /></view><image wx:if="{{configQrUrl}}" src="{{configQrUrl}}" mode="aspectFit" class="family-qr" /><view class="actions"><button class="secondary" data-kind="qr" bindtap="choosePhoto" disabled="{{busy || uploading}}">上传收款码</button><button wx:if="{{configQr}}" class="secondary" bindtap="removeQr" disabled="{{busy || uploading}}">移除</button><button class="primary" bindtap="saveConfig" disabled="{{busy || uploading}}">保存设置</button></view></block><view wx:else class="hint gap">暂无可配置的授权校区。</view></view>
  </block>
</view>
