.authorization-page{padding-bottom:210rpx}.authorization-heading{padding:20rpx 0 8rpx}.authorization-heading .title{font-size:36rpx}.authorization-heading .subtitle{font-size:23rpx}
.authorization-steps{display:flex;justify-content:space-between;position:relative;margin:34rpx 18rpx 38rpx}.authorization-steps:before{content:"";position:absolute;top:19rpx;left:13%;right:13%;height:2rpx;background:#dde7f4}.authorization-step{position:relative;flex:1;text-align:center;color:#9199a8;font-size:22rpx;line-height:1.8}.authorization-step text{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;margin:0 auto 10rpx;border-radius:50%;background:#edf1f7;color:#8492a8;border:3rpx solid #f8faff}.step-current{color:#0071e3;font-weight:600}.step-current text{color:#fff;background:#1677ff}.step-done text{background:#e6efff;color:#0071e3}
.authorization-form{padding:28rpx}.authorization-section-title{font-size:28rpx;font-weight:650;color:#26374d}.authorization-form .field{margin-top:25rpx}.authorization-form .label{font-size:25rpx;font-weight:400;color:#737e91}.authorization-form input,.authorization-form textarea{background:#f5f7fb;border:1rpx solid #edf0f6;border-radius:18rpx}.authorization-form textarea{height:160rpx;min-height:160rpx}
.authorization-segment{display:flex;padding:5rpx;margin:24rpx 0;background:#f2f5fa;border-radius:18rpx}.authorization-segment button{flex:1;border-radius:14rpx;margin:0;padding:16rpx 10rpx;font-size:25rpx;font-weight:500;color:#7b8495;background:transparent;line-height:1.5}.authorization-segment .segment-selected{color:#0071e3;background:#e3efff}
.authorization-choice{display:flex;gap:14rpx;margin:22rpx 0}.authorization-choice button{flex:1;margin:0;padding:20rpx 12rpx;color:#737e91;border:1rpx solid #e8edf5;background:#fafbfe;border-radius:20rpx;font-size:24rpx;font-weight:500}.authorization-choice text{display:block;font-size:20rpx;font-weight:400;margin-top:7rpx;color:#8e98a9}.authorization-choice .choice-selected{color:#0071e3;border-color:#b7d3fc;background:#eef5ff}.authorization-time-row{display:flex;gap:18rpx}.authorization-time-row .field{flex:1;min-width:0}
.authorization-footer{position:fixed;bottom:0;left:0;right:0;z-index:110;display:flex;gap:16rpx;max-width:750rpx;margin:0 auto;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #eaf0f7}.authorization-footer button{flex:1;margin:0;min-width:0;font-size:25rpx;padding:22rpx 12rpx;border-radius:20rpx}
.face-panel{padding:32rpx}.face-entry{display:flex;align-items:center;flex-direction:column;justify-content:center;min-height:360rpx;margin:28rpx 0;background:#f5f8fd;border:1rpx solid #e4edf8;border-radius:28rpx;color:#50617a;font-size:28rpx;font-weight:600}.face-entry image{width:108rpx;height:108rpx;opacity:.68;margin-bottom:25rpx}.face-entry text{font-size:22rpx;color:#8a96a9;font-weight:400;margin-top:10rpx}.face-state{display:flex;align-items:center;gap:16rpx;font-size:23rpx;color:#7a8799;line-height:1.7}.face-explanation{margin-top:24rpx;color:#748198;font-size:25rpx;line-height:1.9}
.authorization-confirm{padding:28rpx}.authorization-person{display:flex;gap:20rpx;align-items:center;padding:26rpx 0}.person-icon{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:28rpx;background:#eaf3ff;flex-shrink:0}.person-icon image{width:52rpx;height:52rpx}.person-name{font-size:29rpx;font-weight:650;color:#23344e}.person-name text{font-size:21rpx;color:#0071e3;background:#e5f0ff;padding:5rpx 11rpx;border-radius:8rpx;margin-left:14rpx;font-weight:500}.person-phone{font-size:24rpx;color:#8791a3;margin-top:12rpx}.confirm-line{display:flex;gap:20rpx;justify-content:space-between;font-size:24rpx;line-height:1.7;padding:20rpx 18rpx;margin:8rpx 0;background:#f5f7fb;border-radius:14rpx}.confirm-line>text{flex-shrink:0;color:#8590a5}.confirm-line>view{text-align:right;color:#3f4f67;overflow-wrap:anywhere;min-width:0}.authorization-warm{padding:22rpx;margin-top:25rpx;border-radius:20rpx;background:#fff6eb;color:#ad8247;font-size:22rpx;line-height:1.9}.authorization-check{display:flex;align-items:flex-start;gap:14rpx;margin-top:22rpx;padding:14rpx 0;background:transparent;color:#78869b;font-size:23rpx;text-align:left;line-height:1.8;font-weight:400}.authorization-check checkbox{transform:scale(.85);transform-origin:left top;flex-shrink:0}
.authorization-success{display:flex;align-items:center;flex-direction:column;text-align:center;padding:46rpx 10rpx 36rpx}.authorization-success image{width:104rpx;height:104rpx;margin-bottom:28rpx}.authorization-success view{font-size:33rpx;font-weight:650;color:#253a54}.authorization-success text{margin-top:15rpx;font-size:24rpx;color:#8993a4;line-height:1.8}.authorization-code{text-align:center;background:#f1f7ff}.pickup-code{font-size:63rpx;letter-spacing:12rpx;font-weight:650;color:#0071e3;padding:20rpx 0}.authorization-error{margin-top:24rpx}
