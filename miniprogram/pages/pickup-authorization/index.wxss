.authorization-page{padding-bottom:208rpx}.authorization-heading{padding:24rpx 0 8rpx}.authorization-heading .title{font-size:36rpx}.authorization-heading .subtitle{font-size:24rpx}
.authorization-steps{display:flex;justify-content:space-between;position:relative;margin:32rpx 16rpx 40rpx}.authorization-steps:before{content:"";position:absolute;top:19rpx;left:13%;right:13%;height:2rpx;background:var(--subtle, #eef1ef)}.authorization-step{position:relative;flex:1;text-align:center;color:var(--muted, #68767c);font-size:24rpx;line-height:1.8}.authorization-step text{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;margin:0 auto 8rpx;border-radius:50%;background:var(--subtle, #eef1ef);color:var(--muted, #68767c);border:3rpx solid var(--line, #dce2df)}.step-current{color:var(--accent, #176b91);font-weight:600}.step-current text{color:var(--surface, #ffffff);background:var(--accent, #176b91)}.step-done text{background:var(--subtle, #eef1ef);color:var(--accent, #176b91)}
.authorization-form{padding:32rpx}.authorization-section-title{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}.authorization-form .field{margin-top:24rpx}.authorization-form .label{font-size:24rpx;font-weight:400;color:var(--secondary, #536168)}.authorization-form input,.authorization-form textarea{background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df);border-radius:16rpx}.authorization-form textarea{height:160rpx;min-height:160rpx}
.authorization-segment{display:flex;padding:8rpx;margin:24rpx 0;background:var(--subtle, #eef1ef);border-radius:16rpx}.authorization-segment button{flex:1;border-radius:16rpx;margin:0;padding:16rpx 8rpx;font-size:24rpx;font-weight:500;color:var(--secondary, #536168);background:transparent;line-height:1.5}.authorization-segment .segment-selected{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.authorization-choice{display:flex;gap:16rpx;margin:24rpx 0}.authorization-choice button{flex:1;margin:0;padding:24rpx 16rpx;color:var(--secondary, #536168);border:1rpx solid var(--line, #dce2df);background:var(--subtle, #eef1ef);border-radius:24rpx;font-size:24rpx;font-weight:500}.authorization-choice text{display:block;font-size:24rpx;font-weight:400;margin-top:8rpx;color:var(--muted, #68767c)}.authorization-choice .choice-selected{color:var(--accent, #176b91);border-color:var(--line, #dce2df);background:var(--subtle, #eef1ef)}.authorization-time-row{display:flex;gap:16rpx}.authorization-time-row .field{flex:1;min-width:0}
.authorization-footer{position:fixed;bottom:0;left:0;right:0;z-index:110;display:flex;gap:16rpx;max-width:750rpx;margin:0 auto;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid var(--line, #dce2df)}.authorization-footer button{flex:1;margin:0;min-width:0;font-size:24rpx;padding:24rpx 16rpx;border-radius:24rpx}
.face-panel{padding:32rpx}.face-entry{display:flex;align-items:center;flex-direction:column;justify-content:center;min-height:360rpx;margin:32rpx 0;background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df);border-radius:32rpx;color:var(--secondary, #536168);font-size:28rpx;font-weight:600}.face-entry image{width:108rpx;height:108rpx;opacity:.68;margin-bottom:24rpx}.face-entry text{font-size:24rpx;color:var(--muted, #68767c);font-weight:400;margin-top:8rpx}.face-state{display:flex;align-items:center;gap:16rpx;font-size:24rpx;color:var(--muted, #68767c);line-height:1.7}.face-explanation{margin-top:24rpx;color:var(--secondary, #536168);font-size:24rpx;line-height:1.9}
.authorization-confirm{padding:32rpx}.authorization-person{display:flex;gap:24rpx;align-items:center;padding:24rpx 0}.person-icon{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border-radius:32rpx;background:var(--subtle, #eef1ef);flex-shrink:0}.person-icon image{width:52rpx;height:52rpx}.person-name{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}.person-name text{font-size:24rpx;color:var(--accent, #176b91);background:var(--subtle, #eef1ef);padding:8rpx 8rpx;border-radius:8rpx;margin-left:16rpx;font-weight:500}.person-phone{font-size:24rpx;color:var(--muted, #68767c);margin-top:16rpx}.confirm-line{display:flex;gap:24rpx;justify-content:space-between;font-size:24rpx;line-height:1.7;padding:24rpx 16rpx;margin:8rpx 0;background:var(--subtle, #eef1ef);border-radius:16rpx}.confirm-line>text{flex-shrink:0;color:var(--muted, #68767c)}.confirm-line>view{text-align:right;color:var(--ink, #263238);overflow-wrap:anywhere;min-width:0}.authorization-warm{padding:24rpx;margin-top:24rpx;border-radius:24rpx;background:var(--subtle, #eef1ef);color:var(--warning, #885c18);font-size:24rpx;line-height:1.9}.authorization-check{display:flex;align-items:flex-start;gap:16rpx;margin-top:24rpx;padding:16rpx 0;background:transparent;color:var(--muted, #68767c);font-size:24rpx;text-align:left;line-height:1.8;font-weight:400}.authorization-check checkbox{transform:scale(.85);transform-origin:left top;flex-shrink:0}
.authorization-success{display:flex;align-items:center;flex-direction:column;text-align:center;padding:48rpx 8rpx 40rpx}.authorization-success image{width:104rpx;height:104rpx;margin-bottom:32rpx}.authorization-success view{font-size:32rpx;font-weight:600;color:var(--ink, #263238)}.authorization-success text{margin-top:16rpx;font-size:24rpx;color:var(--muted, #68767c);line-height:1.8}.authorization-code{text-align:center;background:var(--subtle, #eef1ef)}.pickup-code{font-size:64rpx;letter-spacing:0;font-weight:600;color:var(--accent, #176b91);padding:24rpx 0}.authorization-error{margin-top:24rpx}
