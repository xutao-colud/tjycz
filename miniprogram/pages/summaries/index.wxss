.summaries-date{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.summaries-date-value{display:flex;align-items:center;gap:16rpx}
.summaries-generator{padding:0;overflow:hidden}
.summaries-generator-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx;background:var(--surface, #ffffff);color:var(--ink, #263238);text-align:left;border-radius:32rpx}
.summaries-generator-label{display:flex;align-items:center;gap:16rpx;min-width:0}
.summaries-generator-icon{width:64rpx;height:64rpx;background:var(--subtle, #eef1ef);border-radius:32rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.summaries-generator-icon image{width:38rpx;height:38rpx}
.summaries-generator-title{font-size:28rpx;font-weight:600}
.summaries-generator-note{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx;font-weight:400}
.summaries-toggle-text{font-size:24rpx;color:var(--accent, #176b91);flex-shrink:0}
.summaries-generator-body{padding:16rpx 24rpx 24rpx;border-top:1rpx solid var(--line, #dce2df)}
.summaries-section-note{font-size:24rpx;color:var(--secondary, #536168)}
.summary-report{padding:0;overflow:hidden}
.summary-report-head{display:flex;align-items:center;gap:16rpx;padding:24rpx;border-bottom:1rpx solid var(--line, #dce2df)}
.summary-avatar{width:74rpx;height:74rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--subtle, #eef1ef);color:var(--accent, #176b91);font-size:32rpx;font-weight:600}
.summary-student-name{font-size:28rpx;font-weight:600;color:var(--ink, #263238);line-height:1.4;word-break:break-all}
.summary-report-date{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.summary-report-head .badge{flex-shrink:0}
.summary-content{padding:0 24rpx}
.summary-section{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}
.summary-section:last-child{border-bottom:0}
.summary-section-heading{display:flex;align-items:center;gap:16rpx}
.summary-section-icon{width:44rpx;height:44rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.summary-section-icon image{width:27rpx;height:27rpx}
.summary-tone-green{background:var(--subtle, #eef1ef)}
.summary-tone-blue{background:var(--subtle, #eef1ef)}
.summary-tone-purple{background:var(--subtle, #eef1ef)}
.summary-tone-orange{background:var(--warning-soft, #fbf3e5)}
.summary-section-name{font-size:28rpx;font-weight:600;color:var(--secondary, #536168)}
.summary-section-text{font-size:24rpx;line-height:1.85;color:var(--secondary, #536168);margin-top:16rpx;white-space:pre-wrap;word-break:break-word}
.summary-teacher-comment{margin:8rpx 24rpx 16rpx;padding:24rpx;background:var(--subtle, #eef1ef);border-radius:32rpx}
.summary-comment-title{font-size:24rpx;font-weight:600;color:var(--accent, #176b91);margin-bottom:8rpx}
.summary-comment-text{font-size:24rpx;color:var(--secondary, #536168);line-height:1.85;white-space:pre-wrap;word-break:break-word}
.summary-edit-form{margin:8rpx 24rpx 24rpx;padding-top:24rpx;border-top:1rpx solid var(--line, #dce2df)}
.summary-edit-form .label{margin-top:16rpx}
.summary-edit-form .hint{margin-bottom:16rpx}
.summary-content-input{height:380rpx}
.summary-actions{padding:0 24rpx 24rpx;margin-top:8rpx}
.summary-actions:empty{display:none}
.badge.review-pending{color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5)}
.badge.review-rejected{color:var(--danger, #b33740);background:var(--subtle, #eef1ef)}
.summary-review-note{margin:16rpx 24rpx 24rpx;padding:24rpx 24rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;color:var(--secondary, #536168);font-size:24rpx;line-height:1.8}
.summary-review-title{font-weight:600;color:var(--secondary, #536168);margin-bottom:8rpx}
.summary-review-returned{background:var(--subtle, #eef1ef)}
.summary-review-returned .summary-review-title{color:var(--danger, #b33740)}
.summary-review-opinion{white-space:pre-wrap;word-break:break-word;margin-top:8rpx}
.summary-return-button{color:var(--danger, #b33740);background:var(--subtle, #eef1ef)}
.summary-history{margin:0 24rpx 24rpx;border-top:1rpx solid var(--line, #dce2df)}
.summary-history-toggle{display:flex;justify-content:space-between;align-items:center;width:100%;padding:24rpx 0;background:transparent;border-radius:0;color:var(--muted, #68767c);font-size:24rpx;font-weight:500;text-align:left}
.summary-history-toggle text{color:var(--secondary, #536168);font-size:24rpx}
.summary-history-entry{padding:24rpx 0;border-top:1rpx solid var(--line, #dce2df)}
.summary-history-title{font-size:24rpx;font-weight:600;color:var(--secondary, #536168);line-height:1.6}
.summary-history-meta{font-size:24rpx;color:var(--secondary, #536168);line-height:1.8;margin-top:8rpx}
.summary-history-comment{font-size:24rpx;color:var(--secondary, #536168);line-height:1.8;white-space:pre-wrap;word-break:break-word;margin-top:8rpx}
.summary-version-toggle{display:block;padding:16rpx 0;background:transparent;border-radius:0;color:var(--muted, #68767c);font-size:24rpx;font-weight:400;text-align:left;line-height:1.8}
.summary-history-content{padding:24rpx 24rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;font-size:24rpx;color:var(--secondary, #536168);line-height:1.85;white-space:pre-wrap;word-break:break-word}
.summary-published{border-top:1rpx solid var(--line, #dce2df);padding:24rpx 24rpx 24rpx}
.summary-published-meta{font-size:24rpx;color:var(--secondary, #536168);margin-bottom:8rpx;word-break:break-all}
.summary-feedback{padding:24rpx;background:var(--subtle, #eef1ef);border-radius:32rpx;margin-top:16rpx}
.summary-feedback-head{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.summary-feedback-title{font-size:24rpx;color:var(--secondary, #536168);font-weight:500}
.summary-feedback-score{font-size:32rpx;font-weight:600;color:var(--warning, #885c18)}
.summary-feedback-score text{font-size:24rpx;font-weight:400;color:var(--warning, #885c18)}
.summary-feedback-text{font-size:24rpx;line-height:1.8;color:var(--secondary, #536168);white-space:pre-wrap;word-break:break-word;margin-top:16rpx}
.summary-feedback-form{padding-top:24rpx}
.summary-rating{display:flex;gap:16rpx;margin:16rpx 0}
.summary-rating-item{flex:1;min-width:0;padding:16rpx 0;text-align:center;border-radius:16rpx;background:var(--subtle, #eef1ef);color:var(--secondary, #536168);border:1rpx solid transparent;font-size:28rpx;font-weight:600}
.summary-rating-item text{font-size:24rpx;font-weight:400;margin-left:8rpx}
.summary-rating-item.summary-rating-active{background:var(--subtle, #eef1ef);border-color:var(--line, #dce2df);color:var(--accent, #176b91)}

.title { font-size: 36rpx; }

.satisfaction-class{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}.satisfaction-percent{color:var(--accent, #176b91);font-size:36rpx;font-weight:600}.summary-rating button{width:auto;min-width:0;flex:1;margin:0;font-size:28rpx;line-height:1.6}.summary-rating button::after{border:0}

.summary-report-head{background:var(--subtle, #eef1ef);border-bottom-color:var(--line, #dce2df);padding:32rpx 24rpx}.summary-avatar{background:var(--accent, #176b91);color:var(--surface, #ffffff);border:3rpx solid var(--line, #dce2df);border-radius:24rpx}.summary-student-name{color:var(--accent, #176b91)}.summary-section-text{color:var(--secondary, #536168);line-height:1.9}.summary-section-icon{border-radius:16rpx}.summary-teacher-comment{background:var(--subtle, #eef1ef);border-left:4rpx solid var(--line, #dce2df)}.daily-feedback-card{border:1rpx solid var(--line, #dce2df);background:var(--surface, #ffffff);border-top:4rpx solid var(--line, #dce2df)}.daily-feedback-card .summary-feedback-head>.section-title{flex:1;min-width:0;font-size:28rpx}.daily-feedback-card .summary-feedback-head>text{flex-shrink:0;max-width:220rpx;padding:8rpx 16rpx;border-radius:16rpx;background:var(--subtle, #eef1ef);color:var(--accent, #176b91);font-size:24rpx}.daily-feedback-card>.hint{margin-top:16rpx}.summary-rating-item.summary-rating-active{background:var(--accent, #176b91);border-color:var(--muted, #68767c);color:var(--surface, #ffffff);box-shadow:none}.satisfaction-overview{border-top:4rpx solid var(--line, #dce2df)}.satisfaction-class .satisfaction-percent{padding:8rpx 16rpx;border-radius:16rpx;background:var(--subtle, #eef1ef)}
