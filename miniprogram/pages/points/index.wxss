.points-balance-card{position:relative;overflow:hidden;padding:24rpx;background:var(--warning, #885c18);border-radius:32rpx;color:var(--surface, #ffffff);margin-bottom:16rpx;box-shadow:none}
.points-balance-top{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}
.points-balance-label{font-size:24rpx;color:var(--muted, #68767c)}
.points-balance-icon{width:66rpx;height:66rpx;border-radius:32rpx;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center}
.points-balance-icon image{width:42rpx;height:42rpx}
.points-balance-number{font-size:72rpx;font-weight:600;letter-spacing:0;line-height:1.2;margin:8rpx 0 24rpx;position:relative;z-index:1;word-break:break-all}
.points-balance-unit{font-size:28rpx;font-weight:400;letter-spacing:0;margin-left:16rpx;vertical-align:baseline}
.points-balance-foot{display:flex;justify-content:space-between;gap:24rpx;border-top:1rpx solid rgba(255,255,255,.23);padding-top:24rpx;font-size:24rpx;color:var(--muted, #68767c);position:relative;z-index:1}
.points-balance-orbit{position:absolute;width:320rpx;height:320rpx;border:54rpx solid rgba(255,255,255,.055);border-radius:50%;right:-110rpx;bottom:-130rpx;pointer-events:none}
.points-editor{padding:0;overflow:hidden}
.points-editor-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:24rpx;text-align:left;padding:24rpx;background:var(--surface, #ffffff);color:var(--ink, #263238);border-radius:32rpx}
.points-editor-title{font-size:28rpx;font-weight:600}
.points-editor-note{font-size:24rpx;color:var(--secondary, #536168);font-weight:400;margin-top:8rpx}
.points-toggle-text{font-size:24rpx;white-space:nowrap;color:var(--accent, #176b91)}
.points-toggle-mark{font-size:32rpx;margin-left:16rpx}
.points-form{padding:24rpx;border-top:1rpx solid var(--line, #dce2df)}
.points-section-note{font-size:24rpx;color:var(--secondary, #536168)}
.points-ledger{padding-top:8rpx;padding-bottom:8rpx}
.points-ledger-row{display:flex;align-items:center;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}
.points-ledger-row:last-child{border-bottom:0}
.points-entry-icon{width:76rpx;height:76rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.points-entry-icon image{width:42rpx;height:42rpx}
.points-icon-green{background:var(--subtle, #eef1ef)}
.points-icon-blue{background:var(--subtle, #eef1ef)}
.points-icon-purple{background:var(--subtle, #eef1ef)}
.points-icon-orange{background:var(--warning-soft, #fbf3e5)}
.points-entry-title{font-size:28rpx;font-weight:500;color:var(--ink, #263238);line-height:1.5;word-break:break-all}
.points-entry-type{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.points-entry-time{font-size:24rpx;color:var(--muted, #68767c);margin-top:8rpx}
.points-entry-amount{text-align:right;flex-shrink:0;max-width:190rpx}
.points-change{font-size:36rpx;line-height:1.3;word-break:break-all}
.points-entry-balance{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx;word-break:break-all}
.points-empty{padding:48rpx 0;text-align:center;font-size:24rpx;color:var(--secondary, #536168)}
.points-empty image{display:block;width:110rpx;height:110rpx;margin:0 auto 16rpx;opacity:.7}
.points-empty text{display:block;font-size:24rpx;color:var(--muted, #68767c);margin-top:8rpx}
.points-rules-head{display:flex;align-items:center;gap:16rpx;margin-bottom:24rpx}
.points-rules-icon{width:44rpx;height:44rpx;border-radius:24rpx;background:var(--warning-soft, #fbf3e5);display:flex;align-items:center;justify-content:center}
.points-rules-icon image{width:28rpx;height:28rpx}
.points-rules-head .card-title{font-size:28rpx}
.points-rule-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:16rpx 0}
.points-rule-name{font-size:24rpx;color:var(--secondary, #536168)}
.points-rule-value{font-size:28rpx;font-weight:600;color:var(--success, #23734e);white-space:nowrap}
.points-rule-unit{font-size:24rpx;font-weight:400;margin-left:8rpx}
.points-rule-hint{font-size:24rpx;color:var(--secondary, #536168);border-top:1rpx solid var(--line, #dce2df);padding-top:24rpx;margin-top:16rpx}

.title { font-size: 36rpx; }
