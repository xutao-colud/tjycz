.points-balance-card{position:relative;overflow:hidden;padding:24rpx;background:linear-gradient(120deg,#ffad39,#ffca53);border-radius:28rpx;color:#fff;margin-bottom:18rpx;box-shadow:0 8rpx 24rpx rgba(255,173,57,.14)}
.points-balance-top{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}
.points-balance-label{font-size:25rpx;color:#fff8ec}
.points-balance-icon{width:66rpx;height:66rpx;border-radius:28rpx;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center}
.points-balance-icon image{width:42rpx;height:42rpx}
.points-balance-number{font-size:70rpx;font-weight:700;letter-spacing:1rpx;line-height:1.2;margin:6rpx 0 24rpx;position:relative;z-index:1;word-break:break-all}
.points-balance-unit{font-size:26rpx;font-weight:400;letter-spacing:0;margin-left:16rpx;vertical-align:baseline}
.points-balance-foot{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid rgba(255,255,255,.23);padding-top:20rpx;font-size:22rpx;color:#fff8ec;position:relative;z-index:1}
.points-balance-orbit{position:absolute;width:320rpx;height:320rpx;border:54rpx solid rgba(255,255,255,.055);border-radius:50%;right:-110rpx;bottom:-130rpx;pointer-events:none}
.points-editor{padding:0;overflow:hidden}
.points-editor-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:22rpx;text-align:left;padding:24rpx;background:#fff;color:#1d1d1f;border-radius:28rpx}
.points-editor-title{font-size:28rpx;font-weight:600}
.points-editor-note{font-size:22rpx;color:#737783;font-weight:400;margin-top:6rpx}
.points-toggle-text{font-size:23rpx;white-space:nowrap;color:#0071e3}
.points-toggle-mark{font-size:30rpx;margin-left:12rpx}
.points-form{padding:24rpx;border-top:1rpx solid #e7e8ee}
.points-section-note{font-size:23rpx;color:#737783}
.points-ledger{padding-top:4rpx;padding-bottom:4rpx}
.points-ledger-row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #e7e8ee}
.points-ledger-row:last-child{border-bottom:0}
.points-entry-icon{width:76rpx;height:76rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.points-entry-icon image{width:42rpx;height:42rpx}
.points-icon-green{background:#e7f8f1}
.points-icon-blue{background:#f4f4f7}
.points-icon-purple{background:#f0edff}
.points-icon-orange{background:#fff2e4}
.points-entry-title{font-size:27rpx;font-weight:500;color:#1d1d1f;line-height:1.5;word-break:break-all}
.points-entry-type{font-size:21rpx;color:#737783;margin-top:4rpx}
.points-entry-time{font-size:21rpx;color:#9295a0;margin-top:5rpx}
.points-entry-amount{text-align:right;flex-shrink:0;max-width:190rpx}
.points-change{font-size:36rpx;line-height:1.3;word-break:break-all}
.points-entry-balance{font-size:21rpx;color:#737783;margin-top:9rpx;word-break:break-all}
.points-empty{padding:46rpx 0;text-align:center;font-size:25rpx;color:#737783}
.points-empty image{display:block;width:110rpx;height:110rpx;margin:0 auto 18rpx;opacity:.7}
.points-empty text{display:block;font-size:22rpx;color:#9295a0;margin-top:8rpx}
.points-rules-head{display:flex;align-items:center;gap:12rpx;margin-bottom:20rpx}
.points-rules-icon{width:44rpx;height:44rpx;border-radius:22rpx;background:#fff6dd;display:flex;align-items:center;justify-content:center}
.points-rules-icon image{width:28rpx;height:28rpx}
.points-rules-head .card-title{font-size:28rpx}
.points-rule-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:15rpx 0}
.points-rule-name{font-size:25rpx;color:#737783}
.points-rule-value{font-size:29rpx;font-weight:600;color:#25bb91;white-space:nowrap}
.points-rule-unit{font-size:21rpx;font-weight:400;margin-left:6rpx}
.points-rule-hint{font-size:22rpx;color:#737783;border-top:1rpx solid #e7e8ee;padding-top:20rpx;margin-top:12rpx}

.title { font-size: 34rpx; }
