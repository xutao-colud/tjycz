.student-hero{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.search-card{padding:24rpx}
.search-row{display:flex;align-items:center;gap:16rpx}
.search-input{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0;padding-left:24rpx;background:var(--subtle, #eef1ef);border-radius:24rpx}
.search-input input{height:80rpx;padding:0 16rpx 0 0;background:transparent;border:0;font-size:28rpx}
.search-symbol{width:24rpx;height:24rpx;border:3rpx solid var(--line, #dce2df);border-radius:50%;position:relative;flex-shrink:0}
.search-symbol::after{content:'';position:absolute;width:12rpx;height:3rpx;background:var(--accent, #176b91);right:-9rpx;bottom:-5rpx;transform:rotate(45deg);border-radius:4rpx}
.search-button{padding:16rpx 16rpx;background:transparent;color:var(--accent, #176b91);font-size:28rpx;font-weight:600;flex-shrink:0}
.class-filter{display:flex;align-items:center;gap:24rpx;border-top:1rpx solid var(--line, #dce2df);margin-top:16rpx;padding-top:24rpx}
.class-picker{flex:1;min-width:0}
.class-picker-value{display:flex;align-items:center;justify-content:space-between;color:var(--ink, #263238);font-size:24rpx;gap:16rpx}
.roster-head{margin:24rpx 2rpx 16rpx}
.roster-count{margin-left:16rpx;color:var(--secondary, #536168);font-size:24rpx;font-weight:400}
.student-card{border:1rpx solid var(--line, #dce2df);padding:24rpx;border-radius:32rpx;transition:border-color .15s}
.student-pressed{background:var(--subtle, #eef1ef)}
.student-top{display:flex;align-items:center;gap:16rpx}
.student-avatar{width:82rpx;height:82rpx;border-radius:32rpx;flex-shrink:0;font-size:36rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.avatar-tone-0{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.avatar-tone-1{color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5)}
.avatar-tone-2{color:var(--muted, #68767c);background:var(--subtle, #eef1ef)}
.avatar-tone-3{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}
.student-info{flex:1;min-width:0}
.student-name{font-size:32rpx;font-weight:600;color:var(--ink, #263238);margin-bottom:8rpx}
.student-info .list-description{font-size:24rpx;word-break:break-all}
.student-top .badge{font-size:24rpx;padding:8rpx 16rpx}
.student-metrics{display:flex;background:var(--subtle, #eef1ef);border-radius:32rpx;margin-top:16rpx;padding:24rpx 8rpx}
.student-metric{flex:1;min-width:0;text-align:center;border-right:1rpx solid var(--line, #dce2df)}
.student-metric:last-child{border-right:0}
.metric-number{color:var(--ink, #263238);font-size:32rpx;line-height:1.3;font-weight:600}
.metric-total{font-size:24rpx;font-weight:400;color:var(--secondary, #536168)}
.metric-unit{font-size:24rpx;font-weight:400;margin-left:8rpx;color:var(--secondary, #536168)}
.points-number{color:var(--warning, #885c18)}
.lesson-number{color:var(--muted, #68767c)}
.metric-caption{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.student-times{display:flex;justify-content:space-between;gap:16rpx;font-size:24rpx;color:var(--secondary, #536168);margin-top:16rpx}
.time-dot{display:inline-block;width:9rpx;height:9rpx;background:var(--success, #23734e);border-radius:50%;vertical-align:middle;margin-right:8rpx}
.out-dot{background:var(--accent, #176b91)}
.parent-line{color:var(--secondary, #536168);font-size:24rpx;border-top:1rpx solid var(--line, #dce2df);padding-top:16rpx;margin-top:16rpx}

.title { font-size: 36rpx; }
