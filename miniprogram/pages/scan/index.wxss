.scan-toolbar{display:flex;align-items:center;gap:24rpx;padding:16rpx 24rpx;margin-bottom:16rpx;background:var(--surface, #ffffff);border-radius:24rpx}.scan-toolbar button{padding:16rpx 24rpx;flex-shrink:0}.scan-status{margin:24rpx 0 16rpx;font-weight:600;font-size:24rpx}.scan-canvas{position:relative;overflow:hidden;width:100%;border-radius:24rpx;background:var(--subtle, #eef1ef);line-height:0}.scan-page-image{display:block;width:100%}.question-box{position:absolute;min-width:0;min-height:0;margin:0;padding:0;border:2rpx solid rgba(0,113,227,.55);border-radius:8rpx;background:rgba(0,113,227,.025);overflow:visible;line-height:1.3;text-align:left}.question-box.active{z-index:2;border:4rpx solid var(--muted, #68767c);background:rgba(0,113,227,.08)}.question-box.selected{border-color:var(--muted, #68767c);background:rgba(0,113,227,.1)}.question-box.imported{border-color:var(--line, #dce2df);background:rgba(145,152,163,.08)}.box-label{position:absolute;left:0;top:0;max-width:100%;padding:3rpx 8rpx;border-radius:0 0 8rpx 0;background:var(--accent, #176b91);color:var(--surface, #ffffff);font-size:24rpx;white-space:nowrap;line-height:1.4}.selected .box-label{background:var(--accent, #176b91)}.imported .box-label{background:var(--muted, #68767c)}.edit-box{position:absolute;z-index:5;border:4rpx dashed var(--muted, #68767c);background:rgba(255,183,70,.13);line-height:1.4}.edit-box.editing{border-style:solid}.edit-label{position:absolute;left:0;top:0;padding:3rpx 8rpx;color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5);font-size:24rpx}.resize-handle{position:absolute;right:-12rpx;bottom:-12rpx;width:44rpx;height:44rpx;border:5rpx solid white;border-radius:50%;background:var(--warning, #885c18);box-shadow:none}.question-tabs{width:100%;white-space:nowrap;margin:24rpx 0}.question-tab{display:inline-block;vertical-align:middle;margin-right:16rpx;padding:16rpx 24rpx;color:var(--secondary, #536168);background:var(--subtle, #eef1ef);border-radius:24rpx;font-size:24rpx}.question-tab.active{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}.question-editor{padding:24rpx}.select-question{flex-shrink:0;padding:16rpx 24rpx;border:1rpx solid var(--line, #dce2df);color:var(--accent, #176b91);background:var(--subtle, #eef1ef);font-size:24rpx}.select-question.chosen{color:var(--accent, #176b91);border-color:var(--line, #dce2df);background:var(--subtle, #eef1ef)}.scan-warning{margin-top:16rpx;font-size:24rpx;color:var(--warning, #885c18);line-height:1.6}.question-editor textarea{height:220rpx}.question-editor .empty-question-text{height:90rpx}.edit-actions{display:flex;flex-wrap:wrap;gap:16rpx}.edit-actions button{flex:1 0 44%;min-width:0;padding:16rpx 8rpx;font-size:24rpx}.scan-save .actions button{min-width:0}.scan-empty{text-align:center;padding:40rpx 24rpx 32rpx}.scan-empty image{width:80rpx;height:80rpx;margin-bottom:16rpx}.scan-empty .muted{margin-top:16rpx;line-height:1.8}.history-toggle{display:flex;justify-content:space-between;width:100%;padding:16rpx 8rpx;background:transparent;color:var(--secondary, #536168);font-size:24rpx}.scan-history-row{display:flex;align-items:center;gap:16rpx;width:100%;padding:16rpx 0;background:transparent;text-align:left;border-bottom:1rpx solid var(--line, #dce2df)}.scan-history-row:last-child{border-bottom:0}.scan-history-row image{width:76rpx;height:94rpx;border-radius:8rpx;background:var(--subtle, #eef1ef)}.scan-progress{position:absolute;top:0;bottom:0;left:0;right:0;overflow:hidden;background:rgba(240,246,255,.18);line-height:1.6}.scan-progress text{position:absolute;bottom:22rpx;left:24rpx;right:24rpx;padding:16rpx;background:rgba(255,255,255,.92);border-radius:16rpx;color:var(--secondary, #536168);font-size:24rpx}.scan-line{position:absolute;left:0;right:0;height:5rpx;background:var(--accent, #176b91);box-shadow:none;animation:scanning 2.5s ease-in-out infinite alternate}@keyframes scanning{from{top:2%}to{top:92%}}
