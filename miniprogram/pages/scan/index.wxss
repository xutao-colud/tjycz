.scan-toolbar{display:flex;align-items:center;gap:20rpx;padding:18rpx 22rpx;margin-bottom:18rpx;background:#fff;border-radius:26rpx}.scan-toolbar button{padding:18rpx 22rpx;flex-shrink:0}.scan-status{margin:22rpx 0 14rpx;font-weight:600;font-size:25rpx}.scan-canvas{position:relative;overflow:hidden;width:100%;border-radius:22rpx;background:#e9ebf0;line-height:0}.scan-page-image{display:block;width:100%}.question-box{position:absolute;min-width:0;min-height:0;margin:0;padding:0;border:2rpx solid rgba(0,113,227,.55);border-radius:6rpx;background:rgba(0,113,227,.025);overflow:visible;line-height:1.3;text-align:left}.question-box.active{z-index:2;border:4rpx solid #0071e3;background:rgba(0,113,227,.08)}.question-box.selected{border-color:#0071e3;background:rgba(0,113,227,.1)}.question-box.imported{border-color:#9da4ae;background:rgba(145,152,163,.08)}.box-label{position:absolute;left:0;top:0;max-width:100%;padding:3rpx 10rpx;border-radius:0 0 8rpx 0;background:#0071e3;color:#fff;font-size:20rpx;white-space:nowrap;line-height:1.4}.selected .box-label{background:#0071e3}.imported .box-label{background:#8a929e}.edit-box{position:absolute;z-index:5;border:4rpx dashed #d78a20;background:rgba(255,183,70,.13);line-height:1.4}.edit-box.editing{border-style:solid}.edit-label{position:absolute;left:0;top:0;padding:3rpx 8rpx;color:#81550f;background:#fff3d9;font-size:20rpx}.resize-handle{position:absolute;right:-12rpx;bottom:-12rpx;width:44rpx;height:44rpx;border:5rpx solid white;border-radius:50%;background:#d78a20;box-shadow:0 1rpx 8rpx rgba(0,0,0,.2)}.question-tabs{width:100%;white-space:nowrap;margin:20rpx 0}.question-tab{display:inline-block;vertical-align:middle;margin-right:12rpx;padding:14rpx 22rpx;color:#687180;background:#e9ecf2;border-radius:20rpx;font-size:24rpx}.question-tab.active{color:#0066cc;background:#dfedff}.question-editor{padding:24rpx}.select-question{flex-shrink:0;padding:13rpx 20rpx;border:1rpx solid #d6e6fb;color:#0071e3;background:#f0f6ff;font-size:24rpx}.select-question.chosen{color:#0066cc;border-color:#bdd9ff;background:#e7f1ff}.scan-warning{margin-top:12rpx;font-size:22rpx;color:#a27537;line-height:1.6}.question-editor textarea{height:220rpx}.question-editor .empty-question-text{height:90rpx}.edit-actions{display:flex;flex-wrap:wrap;gap:12rpx}.edit-actions button{flex:1 0 44%;min-width:0;padding:15rpx 10rpx;font-size:24rpx}.scan-save .actions button{min-width:0}.scan-empty{text-align:center;padding:40rpx 25rpx 32rpx}.scan-empty image{width:80rpx;height:80rpx;margin-bottom:16rpx}.scan-empty .muted{margin-top:14rpx;line-height:1.8}.history-toggle{display:flex;justify-content:space-between;width:100%;padding:18rpx 4rpx;background:transparent;color:#737783;font-size:24rpx}.scan-history-row{display:flex;align-items:center;gap:18rpx;width:100%;padding:18rpx 0;background:transparent;text-align:left;border-bottom:1rpx solid #f0f1f4}.scan-history-row:last-child{border-bottom:0}.scan-history-row image{width:76rpx;height:94rpx;border-radius:10rpx;background:#f0f1f4}.scan-progress{position:absolute;top:0;bottom:0;left:0;right:0;overflow:hidden;background:rgba(240,246,255,.18);line-height:1.6}.scan-progress text{position:absolute;bottom:22rpx;left:24rpx;right:24rpx;padding:14rpx;background:rgba(255,255,255,.92);border-radius:14rpx;color:#506480;font-size:22rpx}.scan-line{position:absolute;left:0;right:0;height:5rpx;background:#59aaff;box-shadow:0 0 32rpx #6cbbff;animation:scanning 2.5s ease-in-out infinite alternate}@keyframes scanning{from{top:2%}to{top:92%}}
