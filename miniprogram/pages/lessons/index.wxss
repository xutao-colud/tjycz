.lessons-section-note{font-size:24rpx;color:var(--secondary, #536168)}
.lessons-account{padding-bottom:0;overflow:hidden}
.lessons-account-head{display:flex;align-items:center;gap:16rpx}
.lessons-course-icon{width:76rpx;height:76rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.lessons-course-icon image{width:44rpx;height:44rpx}
.lessons-tone-green{background:var(--subtle, #eef1ef)}
.lessons-tone-blue{background:var(--subtle, #eef1ef)}
.lessons-tone-orange{background:var(--warning-soft, #fbf3e5)}
.lessons-course-name{font-size:28rpx;font-weight:600;line-height:1.4;color:var(--ink, #263238);word-break:break-all}
.lessons-account-caption{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.lessons-account-head .badge{font-size:24rpx;padding:8rpx 16rpx}
.lessons-balance{padding:24rpx 0;text-align:center}
.lessons-balance-label{font-size:24rpx;color:var(--secondary, #536168)}
.lessons-balance-line{margin-top:8rpx;word-break:break-all}
.lessons-balance-value{font-size:72rpx;font-weight:600;line-height:1.2;color:var(--success, #23734e)}
.lessons-balance-value.lessons-balance-low{color:var(--warning, #885c18)}
.lessons-balance-unit{font-size:24rpx;color:var(--secondary, #536168);margin-left:8rpx}
.lessons-account-stats{display:flex;border-radius:32rpx;background:var(--subtle, #eef1ef);padding:24rpx 0}
.lessons-account-stat{flex:1;min-width:0;text-align:center}
.lessons-account-stat+.lessons-account-stat{border-left:1rpx solid var(--line, #dce2df)}
.lessons-stat-value{font-size:36rpx;font-weight:600;color:var(--ink, #263238);line-height:1.35;word-break:break-all}
.lessons-stat-label{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.lessons-threshold{font-size:24rpx;color:var(--secondary, #536168);padding:24rpx 0;text-align:center}
.lessons-threshold-low{color:var(--warning, #885c18)}
.lessons-pending{background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df)}
.lessons-pending-head{display:flex;align-items:center;gap:16rpx}
.lessons-pending-mark{width:50rpx;height:50rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5);font-size:32rpx;font-weight:600;flex-shrink:0}
.lessons-pending-title{font-size:28rpx;font-weight:600;color:var(--warning, #885c18)}
.lessons-pending-subtitle{font-size:24rpx;color:var(--warning, #885c18);margin-top:8rpx}
.lessons-pending-row{display:flex;align-items:center;gap:16rpx;margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid var(--line, #dce2df)}
.lessons-pending-course{font-size:24rpx;color:var(--warning, #885c18)}
.lessons-pending-reason{font-size:24rpx;color:var(--warning, #885c18);margin-top:8rpx;word-break:break-all}
.lessons-retry{font-size:24rpx;padding:16rpx 16rpx;flex-shrink:0;background:var(--subtle, #eef1ef);color:var(--accent, #176b91);border:1rpx solid var(--line, #dce2df);border-radius:24rpx}
.lessons-filter{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.lessons-filter-value{display:flex;align-items:center;gap:16rpx}
.lessons-filter select-picker{max-width:82%}
.lessons-filter-value .filter-value{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420rpx}
.lessons-ledger{padding-top:0;padding-bottom:0}
.lessons-ledger-row{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}
.lessons-ledger-row:last-child{border-bottom:0}
.lessons-ledger-main{display:flex;align-items:center;gap:16rpx}
.lessons-ledger-dot{width:58rpx;height:58rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.lessons-dot-positive{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}
.lessons-dot-negative{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.lessons-entry-title{font-size:28rpx;font-weight:500;color:var(--ink, #263238)}
.lessons-reversed{margin-left:16rpx;font-size:24rpx;padding:2rpx 8rpx;vertical-align:middle}
.lessons-entry-course{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx;word-break:break-all}
.lessons-entry-amount{font-size:36rpx;max-width:190rpx;word-break:break-all;text-align:right}
.lessons-entry-reason{font-size:24rpx;color:var(--secondary, #536168);margin-top:16rpx;word-break:break-all}
.lessons-entry-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx;font-size:24rpx;color:var(--muted, #68767c)}
.lessons-entry-balances{color:var(--secondary, #536168);white-space:nowrap}
.lessons-empty{padding:48rpx 0;text-align:center;color:var(--secondary, #536168);font-size:24rpx}
.lessons-empty image{width:100rpx;height:100rpx;display:block;margin:0 auto 16rpx;opacity:.7}
.lessons-renewals{padding-top:0;padding-bottom:0}
.lessons-renewal-row{padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}
.lessons-renewal-row:last-child{border-bottom:0}
.lessons-renewal-name{font-size:28rpx;font-weight:500;color:var(--ink, #263238);word-break:break-all}
.lessons-renewal-main{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:24rpx 0 16rpx}
.lessons-renewal-money{font-size:40rpx;font-weight:600;color:var(--ink, #263238);word-break:break-all}
.lessons-currency{font-size:24rpx;margin-right:8rpx}
.lessons-renewal-units{display:flex;gap:24rpx;font-size:24rpx;color:var(--secondary, #536168);flex-shrink:0}
.lessons-renewal-units text{font-size:28rpx;font-weight:600;color:var(--secondary, #536168)}
.lessons-renewal-time{font-size:24rpx;color:var(--muted, #68767c)}
.lessons-renewal-note{font-size:24rpx;color:var(--secondary, #536168);margin-top:16rpx;padding:16rpx 16rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;word-break:break-all}
.lessons-empty-inline{padding:32rpx 0;text-align:center;font-size:24rpx;color:var(--secondary, #536168)}
.lessons-footer-note{font-size:24rpx;color:var(--muted, #68767c);text-align:center;padding:8rpx 16rpx 16rpx}

.title { font-size: 36rpx; }
