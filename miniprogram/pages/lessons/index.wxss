.lessons-section-note{font-size:23rpx;color:#737783}
.lessons-account{padding-bottom:0;overflow:hidden}
.lessons-account-head{display:flex;align-items:center;gap:18rpx}
.lessons-course-icon{width:76rpx;height:76rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.lessons-course-icon image{width:44rpx;height:44rpx}
.lessons-tone-green{background:#e6f8ef}
.lessons-tone-blue{background:#f4f4f7}
.lessons-tone-orange{background:#fff1df}
.lessons-course-name{font-size:29rpx;font-weight:600;line-height:1.4;color:#1d1d1f;word-break:break-all}
.lessons-account-caption{font-size:21rpx;color:#737783;margin-top:7rpx}
.lessons-account-head .badge{font-size:20rpx;padding:5rpx 12rpx}
.lessons-balance{padding:24rpx 0;text-align:center}
.lessons-balance-label{font-size:23rpx;color:#737783}
.lessons-balance-line{margin-top:8rpx;word-break:break-all}
.lessons-balance-value{font-size:70rpx;font-weight:700;line-height:1.2;color:#25bb91}
.lessons-balance-value.lessons-balance-low{color:#efa448}
.lessons-balance-unit{font-size:24rpx;color:#737783;margin-left:10rpx}
.lessons-account-stats{display:flex;border-radius:28rpx;background:#fafafd;padding:20rpx 0}
.lessons-account-stat{flex:1;min-width:0;text-align:center}
.lessons-account-stat+.lessons-account-stat{border-left:1rpx solid #e7e8ee}
.lessons-stat-value{font-size:34rpx;font-weight:600;color:#1d1d1f;line-height:1.35;word-break:break-all}
.lessons-stat-label{font-size:21rpx;color:#737783;margin-top:8rpx}
.lessons-threshold{font-size:21rpx;color:#737783;padding:20rpx 0;text-align:center}
.lessons-threshold-low{color:#ca9044}
.lessons-pending{background:#fff8ed;border:1rpx solid #ffecd0}
.lessons-pending-head{display:flex;align-items:center;gap:16rpx}
.lessons-pending-mark{width:50rpx;height:50rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#d59b44;background:#ffebc7;font-size:30rpx;font-weight:600;flex-shrink:0}
.lessons-pending-title{font-size:28rpx;font-weight:600;color:#9c712e}
.lessons-pending-subtitle{font-size:22rpx;color:#b19363;margin-top:5rpx}
.lessons-pending-row{display:flex;align-items:center;gap:18rpx;margin-top:23rpx;padding-top:23rpx;border-top:1rpx solid #f2e7d4}
.lessons-pending-course{font-size:24rpx;color:#7e684b}
.lessons-pending-reason{font-size:22rpx;color:#ab9370;margin-top:7rpx;word-break:break-all}
.lessons-retry{font-size:22rpx;padding:13rpx 18rpx;flex-shrink:0;background:#f4f4f7;color:#0071e3;border:1rpx solid #e7e8ee;border-radius:22rpx}
.lessons-filter{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.lessons-filter-value{display:flex;align-items:center;gap:16rpx}
.lessons-filter select-picker{max-width:82%}
.lessons-filter-value .filter-value{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420rpx}
.lessons-ledger{padding-top:0;padding-bottom:0}
.lessons-ledger-row{padding:24rpx 0;border-bottom:1rpx solid #e7e8ee}
.lessons-ledger-row:last-child{border-bottom:0}
.lessons-ledger-main{display:flex;align-items:center;gap:16rpx}
.lessons-ledger-dot{width:58rpx;height:58rpx;border-radius:19rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.lessons-dot-positive{color:#25bb91;background:#e7f8f1}
.lessons-dot-negative{color:#b0a2ec;background:#f1effc}
.lessons-entry-title{font-size:27rpx;font-weight:500;color:#1d1d1f}
.lessons-reversed{margin-left:12rpx;font-size:18rpx;padding:2rpx 9rpx;vertical-align:middle}
.lessons-entry-course{font-size:22rpx;color:#737783;margin-top:5rpx;word-break:break-all}
.lessons-entry-amount{font-size:34rpx;max-width:190rpx;word-break:break-all;text-align:right}
.lessons-entry-reason{font-size:22rpx;color:#737783;margin-top:16rpx;word-break:break-all}
.lessons-entry-meta{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:12rpx;font-size:21rpx;color:#9295a0}
.lessons-entry-balances{color:#737783;white-space:nowrap}
.lessons-empty{padding:44rpx 0;text-align:center;color:#737783;font-size:24rpx}
.lessons-empty image{width:100rpx;height:100rpx;display:block;margin:0 auto 16rpx;opacity:.7}
.lessons-renewals{padding-top:0;padding-bottom:0}
.lessons-renewal-row{padding:24rpx 0;border-bottom:1rpx solid #e7e8ee}
.lessons-renewal-row:last-child{border-bottom:0}
.lessons-renewal-name{font-size:27rpx;font-weight:500;color:#1d1d1f;word-break:break-all}
.lessons-renewal-main{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0 12rpx}
.lessons-renewal-money{font-size:40rpx;font-weight:650;color:#1d1d1f;word-break:break-all}
.lessons-currency{font-size:25rpx;margin-right:5rpx}
.lessons-renewal-units{display:flex;gap:22rpx;font-size:21rpx;color:#737783;flex-shrink:0}
.lessons-renewal-units text{font-size:26rpx;font-weight:600;color:#737783}
.lessons-renewal-time{font-size:21rpx;color:#9295a0}
.lessons-renewal-note{font-size:23rpx;color:#737783;margin-top:14rpx;padding:14rpx 18rpx;background:#fafafd;border-radius:20rpx;word-break:break-all}
.lessons-empty-inline{padding:34rpx 0;text-align:center;font-size:24rpx;color:#737783}
.lessons-footer-note{font-size:22rpx;color:#9295a0;text-align:center;padding:6rpx 12rpx 14rpx}

.title { font-size: 34rpx; }
