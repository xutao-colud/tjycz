<app-nav />
<view class="{{user.role === 'PARENT' ? 'parent-view' : ''}} {{reducedMotion ? 'reduce-motion' : ''}} {{!loading ? 'parent-ready' : ''}} page fitness-page">
  <view class="hero">
    <view class="eyebrow">每天动一动</view>
    <view class="title">体能记录</view>
    <view class="subtitle">{{teacher ? '记录每一次运动，见证每一点进步。' : '运动与坚持，都在这里留下足迹。'}}</view>
  </view>

  <view class="filter-bar fitness-date">
    <text class="filter-label">记录日期</text>
    <date-picker class="plain-picker" value="{{date}}" label="选择体能记录日期" bindchange="changeDate">
      <view class="fitness-date-value">
        <text class="filter-value">{{date}}</text>
        <text class="chevron">⌄</text>
      </view>
    </date-picker>
  </view>

  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <block wx:if="{{!loading && !error}}">
    <student-picker
      students="{{students}}"
      selected="{{studentIds}}"
      multiple="{{teacher}}"
      bindchange="pickStudents"
    />

    <view class="card fitness-overview">
      <view class="fitness-overview-icon">
        <image src="/assets/icons/fitness.svg" mode="aspectFit" />
      </view>
      <view class="col">
        <view class="fitness-overview-title">每一次坚持都算数</view>
        <view class="fitness-overview-note">{{date}} · 当日运动记录</view>
      </view>
      <view class="fitness-overview-total">
        <text class="fitness-overview-number">{{records.length}}</text>
        <text class="fitness-overview-unit">条</text>
      </view>
    </view>

    <view wx:if="{{teacher}}" class="card fitness-editor">
      <button class="fitness-editor-toggle" bindtap="toggleForm" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">
        <view class="fitness-editor-label">
          <text class="fitness-add">+</text>
          <view>
            <view class="fitness-editor-title">添加运动记录</view>
            <view class="fitness-editor-note">已选择 {{studentIds.length}} 位学生</view>
          </view>
        </view>
        <text class="fitness-toggle-text">{{formOpen ? '收起' : '展开'}}</text>
      </button>
      <view wx:if="{{formOpen}}" class="fitness-form">
        <view class="field">
          <text class="label">手动填写运动项目 *</text>
          <input value="{{project}}" data-field="project" bindinput="field" maxlength="80" placeholder="自由输入，例如：篮球、跑步、平板支撑" />
        </view>
        <view class="row">
          <view class="field col">
            <text class="label">次数</text>
            <input type="number" value="{{count}}" data-field="count" bindinput="field" placeholder="选填，不适用可留空" />
          </view>
          <view class="field col">
            <text class="label">时长 / 秒</text>
            <input type="number" value="{{duration}}" data-field="duration" bindinput="field" placeholder="选填，不适用可留空" />
          </view>
        </view>
        <view class="hint">次数与时长至少填一项大于 0。同一学生每天同一项目只记录一次，积分按机构规则奖励。</view>
        <button class="primary gap" bindtap="submit" disabled="{{busy || !studentIds.length}}" loading="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">为 {{studentIds.length}} 位学生打卡</button>
      </view>
    </view>

    <view wx:if="{{result}}" class="notice">{{result}}</view>
    <view wx:if="{{actionError}}" class="error">{{actionError}}</view>

    <view class="section-head">
      <view class="section-title">运动明细</view>
      <text class="fitness-record-count">共 {{records.length}} 条</text>
    </view>
    <view wx:for="{{records}}" wx:key="id" class="card fitness-record">
      <view class="fitness-record-head">
        <view class="fitness-project-icon fitness-tone-{{item.tone}}">
          <image src="/assets/icons/fitness.svg" mode="aspectFit" />
        </view>
        <view class="col">
          <view class="fitness-project-name">{{item.project}}</view>
          <view class="fitness-record-person">{{item.studentName}} · {{item.date}}</view>
        </view>
        <text class="badge {{item.confirmed ? '' : 'warn'}}">{{item.confirmation}}</text>
      </view>
      <view class="fitness-measures">
        <view class="fitness-measure">
          <view><text class="fitness-measure-value">{{item.count}}</text><text class="fitness-measure-unit">次</text></view>
          <view class="fitness-measure-label">完成次数</view>
        </view>
        <view class="fitness-measure">
          <view><text class="fitness-measure-value">{{item.duration}}</text><text class="fitness-measure-unit">秒</text></view>
          <view class="fitness-measure-label">运动时长</view>
        </view>
      </view>
    </view>
    <state-view empty="{{!records.length}}" empty-text="当日还没有运动记录" />
  </block>
</view>
