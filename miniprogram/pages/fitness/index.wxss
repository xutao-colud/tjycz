.fitness-date{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.fitness-date-value{display:flex;align-items:center;gap:18rpx}
.fitness-overview{display:flex;align-items:center;gap:20rpx;background:#f4f4f7;border:1rpx solid #e7e8ee}
.fitness-overview-icon{width:80rpx;height:80rpx;border-radius:28rpx;background:#eaf0f9;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.fitness-overview-icon image{width:46rpx;height:46rpx}
.fitness-overview-title{font-size:28rpx;font-weight:600;color:#1d1d1f}
.fitness-overview-note{font-size:22rpx;color:#737783;margin-top:8rpx}
.fitness-overview-total{white-space:nowrap;color:#0071e3}
.fitness-overview-number{font-size:44rpx;font-weight:700;line-height:1.2}
.fitness-overview-unit{font-size:23rpx;margin-left:8rpx}
.fitness-editor{padding:0;overflow:hidden}
.fitness-editor-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:24rpx;background:#fff;border-radius:28rpx;color:#1d1d1f}
.fitness-editor-label{display:flex;align-items:center;gap:18rpx}
.fitness-add{width:60rpx;height:60rpx;line-height:56rpx;text-align:center;border-radius:26rpx;background:#f4f4f7;color:#0071e3;font-size:40rpx;font-weight:400;flex-shrink:0}
.fitness-editor-title{font-size:28rpx;font-weight:600}
.fitness-editor-note{font-size:22rpx;color:#737783;margin-top:5rpx;font-weight:400}
.fitness-toggle-text{font-size:23rpx;color:#0071e3;flex-shrink:0;margin-left:16rpx}
.fitness-form{padding:24rpx;border-top:1rpx solid #e7e8ee}
.fitness-form .row{align-items:flex-start}
.fitness-record-count{font-size:23rpx;color:#737783}
.fitness-record{padding:24rpx}
.fitness-record-head{display:flex;align-items:center;gap:20rpx}
.fitness-project-icon{width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:28rpx;flex-shrink:0}
.fitness-project-icon image{width:48rpx;height:48rpx}
.fitness-tone-green{background:#e5f8ef}
.fitness-tone-blue{background:#f4f4f7}
.fitness-tone-orange{background:#fff1df}
.fitness-tone-purple{background:#f1edff}
.fitness-project-name{font-size:30rpx;font-weight:600;line-height:1.4;word-break:break-all;color:#1d1d1f}
.fitness-record-person{font-size:22rpx;color:#737783;margin-top:6rpx}
.fitness-measures{display:flex;margin-top:18rpx;background:#fafafd;border-radius:28rpx;padding:20rpx 0}
.fitness-measure{flex:1;min-width:0;text-align:center}
.fitness-measure+.fitness-measure{border-left:1rpx solid #e7e8ee}
.fitness-measure-value{font-size:42rpx;font-weight:650;line-height:1.25;color:#1d1d1f}
.fitness-measure-unit{font-size:23rpx;color:#737783;margin-left:8rpx}
.fitness-measure-label{font-size:22rpx;color:#737783;margin-top:8rpx}

.title { font-size: 34rpx; }
