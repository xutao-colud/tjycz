.fitness-date{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.fitness-date-value{display:flex;align-items:center;gap:16rpx}
.fitness-overview{display:flex;align-items:center;gap:24rpx;background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df)}
.fitness-overview-icon{width:80rpx;height:80rpx;border-radius:32rpx;background:var(--subtle, #eef1ef);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.fitness-overview-icon image{width:46rpx;height:46rpx}
.fitness-overview-title{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}
.fitness-overview-note{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.fitness-overview-total{white-space:nowrap;color:var(--accent, #176b91)}
.fitness-overview-number{font-size:44rpx;font-weight:600;line-height:1.2}
.fitness-overview-unit{font-size:24rpx;margin-left:8rpx}
.fitness-editor{padding:0;overflow:hidden}
.fitness-editor-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:24rpx;background:var(--surface, #ffffff);border-radius:32rpx;color:var(--ink, #263238)}
.fitness-editor-label{display:flex;align-items:center;gap:16rpx}
.fitness-add{width:60rpx;height:60rpx;line-height:56rpx;text-align:center;border-radius:24rpx;background:var(--subtle, #eef1ef);color:var(--accent, #176b91);font-size:40rpx;font-weight:400;flex-shrink:0}
.fitness-editor-title{font-size:28rpx;font-weight:600}
.fitness-editor-note{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx;font-weight:400}
.fitness-toggle-text{font-size:24rpx;color:var(--accent, #176b91);flex-shrink:0;margin-left:16rpx}
.fitness-form{padding:24rpx;border-top:1rpx solid var(--line, #dce2df)}
.fitness-form .row{align-items:flex-start}
.fitness-record-count{font-size:24rpx;color:var(--secondary, #536168)}
.fitness-record{padding:24rpx}
.fitness-record-head{display:flex;align-items:center;gap:24rpx}
.fitness-project-icon{width:84rpx;height:84rpx;display:flex;align-items:center;justify-content:center;border-radius:32rpx;flex-shrink:0}
.fitness-project-icon image{width:48rpx;height:48rpx}
.fitness-tone-green{background:var(--subtle, #eef1ef)}
.fitness-tone-blue{background:var(--subtle, #eef1ef)}
.fitness-tone-orange{background:var(--warning-soft, #fbf3e5)}
.fitness-tone-purple{background:var(--subtle, #eef1ef)}
.fitness-project-name{font-size:32rpx;font-weight:600;line-height:1.4;word-break:break-all;color:var(--ink, #263238)}
.fitness-record-person{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.fitness-measures{display:flex;margin-top:16rpx;background:var(--subtle, #eef1ef);border-radius:32rpx;padding:24rpx 0}
.fitness-measure{flex:1;min-width:0;text-align:center}
.fitness-measure+.fitness-measure{border-left:1rpx solid var(--line, #dce2df)}
.fitness-measure-value{font-size:44rpx;font-weight:600;line-height:1.25;color:var(--ink, #263238)}
.fitness-measure-unit{font-size:24rpx;color:var(--secondary, #536168);margin-left:8rpx}
.fitness-measure-label{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}

.title { font-size: 36rpx; }
