page {
  background: var(--subtle, #eef1ef);
  color: var(--ink, #263238);
}

.mistake-detail .detail-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.hero-icon image {
  width: 48rpx;
  height: 48rpx;
}

.mistake-detail .detail-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line, #dce2df);
  border-radius:32rpx;
  background: var(--surface, #ffffff);
  box-shadow: none;
}

.summary-top,
.detail-section-head,
.section-heading,
.question-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.summary-top,
.detail-section-head {
  justify-content: space-between;
  align-items: flex-start;
}

.subject-tag,
.teacher-tag,
.plan-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius:16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.subject-tag {
  max-width: 60%;
  background: var(--subtle, #eef1ef);
  color: var(--success, #23734e);
  font-weight: 600;
  word-break: break-word;
}

.mistake-detail .status-tag {
  max-width: 45%;
  white-space: normal;
  text-align: center;
}

.question-heading {
  margin-top: 24rpx;
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 16rpx;
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.step-caption {
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.question-title {
  margin-top: 16rpx;
  color: var(--ink, #263238);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.student-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line, #dce2df);
}

.student-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  background: var(--subtle, #eef1ef);
  border-radius:32rpx;
}

.student-avatar image {
  width: 42rpx;
  height: 42rpx;
}

.student-name {
  color: var(--ink, #263238);
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.student-caption,
.date-caption {
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.6;
}

.student-caption {
  margin-top: 3rpx;
}

.record-date {
  max-width: 44%;
  text-align: right;
}

.date-value {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  word-break: break-word;
}

.attachment-caption {
  margin-top: 24rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.section-heading {
  min-width: 0;
  flex: 1;
}

.detail-section-title {
  color: var(--ink, #263238);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.section-caption,
.record-count {
  padding-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: right;
}

.section-caption {
  max-width: 40%;
}

.knowledge-panel {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius:24rpx;
  background: var(--subtle, #eef1ef);
}

.content-label {
  margin-bottom: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.detail-text {
  color: var(--ink, #263238);
  font-size: 28rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.knowledge-text {
  color: var(--secondary, #536168);
  font-size: 28rpx;
}

.reason-panel {
  padding-top: 24rpx;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
}

.timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 18rpx;
}

.timeline-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 8rpx;
  border: 4rpx solid var(--line, #dce2df);
  box-sizing: content-box;
  border-radius: 50%;
  background: var(--accent, #176b91);
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 30rpx;
  background: var(--subtle, #eef1ef);
}

.timeline-content {
  flex: 1;
  min-width: 0;
  padding-bottom: 32rpx;
}

.timeline-item:last-child .timeline-content {
  padding-bottom: 0;
}

.record-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.record-title {
  color: var(--ink, #263238);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.record-time {
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.9;
}

.correction-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.empty-panel {
  padding: 32rpx 0 16rpx;
  text-align: center;
}

.empty-panel image {
  width: 98rpx;
  height: 98rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.empty-description {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.8;
}

.teacher-feedback {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.feedback-label {
  color: var(--accent, #176b91);
  font-size: 24rpx;
  font-weight: 600;
}

.feedback-text {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 28rpx;
}

.section-description {
  margin-top: 16rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.8;
  word-break: break-word;
}

.correction-field,
.review-field {
  margin-top: 24rpx;
}

.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.mistake-detail .label {
  color: var(--ink, #263238);
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.required {
  color: var(--accent, #176b91);
}

.field-hint {
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.7;
}

.mistake-detail .detail-textarea {
  width: 100%;
  min-height: 230rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line, #dce2df);
  border-radius:24rpx;
  background: var(--subtle, #eef1ef);
  color: var(--ink, #263238);
  font-size: 28rpx;
  line-height: 1.8;
}

.detail-placeholder {
  color: var(--muted, #68767c);
  font-size: 24rpx;
}

.upload-panel {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--line, #dce2df);
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.upload-caption {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.upload-caption image {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
}

.optional-caption {
  margin-left: auto;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.upload-hint {
  margin-top: 16rpx;
  color: var(--accent, #176b91);
  font-size: 24rpx;
}

.mistake-detail .primary {
  background: var(--accent, #176b91);
  color: var(--surface, #ffffff);
}

.mistake-detail .secondary {
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
}

.mistake-detail .submit-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius:24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.teacher-tag {
  flex-shrink: 0;
  background: var(--subtle, #eef1ef);
  color: var(--secondary, #536168);
}

.mistake-detail .detail-actions {
  gap: 16rpx;
  margin-top: 16rpx;
}

.mistake-detail .detail-actions button {
  flex: 1;
  min-width: 0;
  padding: 24rpx 16rpx;
  border-radius:24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: normal;
}

.pending-panel {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius:32rpx;
  background: var(--warning-soft, #fbf3e5);
}

.pending-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border: 8rpx solid var(--line, #dce2df);
  box-sizing: content-box;
  border-radius: 50%;
  background: var(--warning, #885c18);
}

.pending-title {
  color: var(--warning, #885c18);
  font-size: 28rpx;
  font-weight: 600;
}

.pending-description {
  margin-top: 8rpx;
  color: var(--warning, #885c18);
  font-size: 24rpx;
  line-height: 1.8;
}

.plan-tag {
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
}

.review-rhythm {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.rhythm-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.rhythm-day {
  color: var(--accent, #176b91);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.rhythm-label {
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.rhythm-connector {
  flex: 1;
  height: 2rpx;
  background: var(--subtle, #eef1ef);
}

.review-date {
  color: var(--ink, #263238);
  font-size: 28rpx;
  font-weight: 600;
}

.review-timeline .timeline-dot {
  border-color: var(--line, #dce2df);
  background: var(--muted, #68767c);
}

.review-timeline .timeline-done .timeline-dot {
  border-color: var(--line, #dce2df);
  background: var(--success, #23734e);
}

.review-content {
  padding-bottom: 32rpx;
}

.review-hint {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.8;
  word-break: break-word;
}

.mistake-detail .review-button {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius:24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: normal;
}

.plan-empty {
  padding: 24rpx 8rpx 8rpx;
  text-align: center;
}

.plan-empty-title {
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.title { font-size: 36rpx; }
