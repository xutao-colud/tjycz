page {
  background: #fafafd;
  color: #1d1d1f;
}

.mistake-detail .detail-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius:28rpx;
  background: #f4f4f7;
}

.hero-icon image {
  width: 48rpx;
  height: 48rpx;
}

.mistake-detail .detail-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e7e8ee;
  border-radius:28rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(37, 50, 70, 0.025);
}

.summary-top,
.detail-section-head,
.section-heading,
.question-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-top,
.detail-section-head {
  justify-content: space-between;
  align-items: flex-start;
}

.subject-tag,
.teacher-tag,
.plan-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius:14rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.subject-tag {
  max-width: 60%;
  background: #e8f8f2;
  color: #1b9a77;
  font-weight: 600;
  word-break: break-word;
}

.mistake-detail .status-tag {
  max-width: 45%;
  white-space: normal;
  text-align: center;
}

.question-heading {
  margin-top: 24rpx;
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 13rpx;
  background: #f4f4f7;
  color: #0071e3;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1;
}

.step-caption {
  color: #737783;
  font-size: 24rpx;
}

.question-title {
  margin-top: 18rpx;
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.student-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e7e8ee;
}

.student-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 66rpx;
  height: 66rpx;
  background: #f4f4f7;
  border-radius:28rpx;
}

.student-avatar image {
  width: 42rpx;
  height: 42rpx;
}

.student-name {
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 600;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.student-caption,
.date-caption {
  color: #737783;
  font-size: 22rpx;
  line-height: 1.6;
}

.student-caption {
  margin-top: 3rpx;
}

.record-date {
  max-width: 44%;
  text-align: right;
}

.date-value {
  margin-top: 4rpx;
  color: #737783;
  font-size: 22rpx;
  word-break: break-word;
}

.attachment-caption {
  margin-top: 24rpx;
  color: #737783;
  font-size: 23rpx;
}

.section-heading {
  min-width: 0;
  flex: 1;
}

.detail-section-title {
  color: #1d1d1f;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.section-caption,
.record-count {
  padding-top: 6rpx;
  color: #737783;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: right;
}

.section-caption {
  max-width: 40%;
}

.knowledge-panel {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius:26rpx;
  background: #fafafd;
}

.content-label {
  margin-bottom: 10rpx;
  color: #737783;
  font-size: 23rpx;
}

.detail-text {
  color: #50535d;
  font-size: 27rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.knowledge-text {
  color: #737783;
  font-size: 26rpx;
}

.reason-panel {
  padding-top: 24rpx;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 18rpx;
}

.timeline-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border: 4rpx solid #e7e8ee;
  box-sizing: content-box;
  border-radius: 50%;
  background: #0071e3;
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 30rpx;
  background: #f4f4f7;
}

.timeline-content {
  flex: 1;
  min-width: 0;
  padding-bottom: 30rpx;
}

.timeline-item:last-child .timeline-content {
  padding-bottom: 0;
}

.record-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
}

.record-title {
  color: #1d1d1f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.6;
}

.record-time {
  color: #737783;
  font-size: 21rpx;
  line-height: 1.9;
}

.correction-text {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.empty-panel {
  padding: 32rpx 0 16rpx;
  text-align: center;
}

.empty-panel image {
  width: 98rpx;
  height: 98rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  color: #737783;
  font-size: 25rpx;
}

.empty-description {
  margin-top: 8rpx;
  color: #737783;
  font-size: 23rpx;
  line-height: 1.8;
}

.teacher-feedback {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius:28rpx;
  background: #f4f4f7;
}

.feedback-label {
  color: #0071e3;
  font-size: 24rpx;
  font-weight: 600;
}

.feedback-text {
  margin-top: 10rpx;
  color: #737783;
  font-size: 26rpx;
}

.section-description {
  margin-top: 12rpx;
  color: #737783;
  font-size: 24rpx;
  line-height: 1.8;
  word-break: break-word;
}

.correction-field,
.review-field {
  margin-top: 24rpx;
}

.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.mistake-detail .label {
  color: #50535d;
  font-size: 25rpx;
  margin-bottom: 14rpx;
}

.required {
  color: #0071e3;
}

.field-hint {
  color: #737783;
  font-size: 22rpx;
  line-height: 1.7;
}

.mistake-detail .detail-textarea {
  width: 100%;
  min-height: 230rpx;
  padding: 22rpx;
  border: 1rpx solid #e7e8ee;
  border-radius:26rpx;
  background: #fafafd;
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 1.8;
}

.detail-placeholder {
  color: #9295a0;
  font-size: 25rpx;
}

.upload-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx dashed #e7e8ee;
  border-radius:28rpx;
  background: #fafafd;
}

.upload-caption {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
  color: #737783;
  font-size: 24rpx;
}

.upload-caption image {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
}

.optional-caption {
  margin-left: auto;
  color: #737783;
  font-size: 22rpx;
}

.upload-hint {
  margin-top: 14rpx;
  color: #0071e3;
  font-size: 23rpx;
}

.mistake-detail .primary {
  background: linear-gradient(120deg, #0071e3, #0071e3);
  color: #fff;
}

.mistake-detail .secondary {
  background: #f4f4f7;
  color: #0071e3;
}

.mistake-detail .submit-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 20rpx;
  border-radius:26rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.teacher-tag {
  flex-shrink: 0;
  background: #f4f4f7;
  color: #737783;
}

.mistake-detail .detail-actions {
  gap: 16rpx;
  margin-top: 18rpx;
}

.mistake-detail .detail-actions button {
  flex: 1;
  min-width: 0;
  padding: 22rpx 14rpx;
  border-radius:26rpx;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: normal;
}

.pending-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius:28rpx;
  background: #fff4df;
}

.pending-dot {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border: 8rpx solid #ffebc7;
  box-sizing: content-box;
  border-radius: 50%;
  background: #d99b40;
}

.pending-title {
  color: #b2823c;
  font-size: 26rpx;
  font-weight: 600;
}

.pending-description {
  margin-top: 5rpx;
  color: #ab9370;
  font-size: 23rpx;
  line-height: 1.8;
}

.plan-tag {
  background: #f4f4f7;
  color: #0071e3;
}

.review-rhythm {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: 18rpx;
  border-radius:28rpx;
  background: #fafafd;
}

.rhythm-item {
  display: flex;
  align-items: baseline;
  gap: 7rpx;
  flex-shrink: 0;
}

.rhythm-day {
  color: #0071e3;
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.3;
}

.rhythm-label {
  color: #737783;
  font-size: 21rpx;
}

.rhythm-connector {
  flex: 1;
  height: 2rpx;
  background: #eaf0f9;
}

.review-date {
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 600;
}

.review-timeline .timeline-dot {
  border-color: #e7e8ee;
  background: #a5b1c0;
}

.review-timeline .timeline-done .timeline-dot {
  border-color: #d7f2e7;
  background: #25bb91;
}

.review-content {
  padding-bottom: 32rpx;
}

.review-hint {
  margin-top: 10rpx;
  color: #737783;
  font-size: 23rpx;
  line-height: 1.8;
  word-break: break-word;
}

.mistake-detail .review-button {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius:22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: normal;
}

.plan-empty {
  padding: 26rpx 8rpx 6rpx;
  text-align: center;
}

.plan-empty-title {
  color: #737783;
  font-size: 25rpx;
}

.title { font-size: 34rpx; }
