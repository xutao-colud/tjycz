.mistakes-hero{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.mistakes-filter{display:flex;gap:24rpx;padding:24rpx}
.filter-column{flex:1;min-width:0}
.filter-column + .filter-column{padding-left:24rpx;border-left:1rpx solid #e7e8ee}
.filter-column .filter-label{display:block;font-size:22rpx;color:#737783;margin-bottom:8rpx}
.filter-choice{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#1d1d1f;font-size:26rpx;font-weight:500;min-height:42rpx}
.filter-choice > text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.create-entry{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:24rpx;border:1rpx solid #e7e8ee}
.create-entry-main{display:flex;align-items:center;gap:18rpx;min-width:0}
.create-icon{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#f4f4f7;border-radius:28rpx}
.create-icon image{width:44rpx;height:44rpx}
.create-entry-title{font-size:28rpx;font-weight:600;color:#1d1d1f}
.create-entry-subtitle{font-size:22rpx;color:#737783;margin-top:4rpx}
.create-toggle{color:#0071e3;font-size:24rpx;white-space:nowrap}
.create-arrow{font-size:32rpx;margin-left:10rpx;vertical-align:-2rpx}
.form-heading{margin-bottom:18rpx}
.form-heading .hint{margin-top:0}
.create-form textarea{min-height:170rpx}
.required{color:#0071e3;margin-left:4rpx}
.optional{font-size:21rpx;color:#9295a0;margin-left:12rpx;font-weight:400}
.mistake-list-head{margin:24rpx 2rpx 18rpx}
.mistake-list-head .hint{margin-top:0}
.mistake-card{padding:24rpx}
.mistake-top{display:flex;align-items:center;gap:18rpx}
.subject-icon{width:78rpx;height:78rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:33rpx;font-weight:600;line-height:1;flex-shrink:0}
.subject-chinese{color:#e79b45;background:#fff1dc}
.subject-math{color:#0071e3;background:#f4f4f7}
.subject-english{color:#9f7cde;background:#f1ebff;font-size:29rpx}
.subject-other{color:#25ad85;background:#e5f8ef}
.mistake-subject{flex:1;min-width:0}
.subject-name{font-size:28rpx;font-weight:600;color:#1d1d1f}
.student-name{font-size:22rpx;color:#737783;margin-top:3rpx}
.mistake-status{display:inline-block;border-radius:14rpx;padding:6rpx 15rpx;font-size:22rpx;line-height:1.5;white-space:nowrap}
.status-mastered{background:#e7f8f0;color:#25ae85}
.status-review{background:#f4f4f7;color:#0071e3}
.status-uncorrected{background:#fff1e5;color:#e5a052}
.mistake-title{font-size:29rpx;font-weight:600;line-height:1.7;color:#1d1d1f;margin-top:18rpx;word-break:break-all;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.knowledge-line{display:flex;align-items:flex-start;gap:14rpx;margin-top:16rpx;font-size:23rpx;line-height:1.7}
.knowledge-label{background:#f4f4f7;color:#737783;padding:1rpx 11rpx;border-radius:8rpx;flex-shrink:0}
.knowledge-value{color:#737783;word-break:break-all;min-width:0}
.review-strip{display:flex;align-items:center;gap:22rpx;background:#fafafd;border-radius:26rpx;margin-top:18rpx;padding:18rpx 22rpx}
.review-item{display:flex;align-items:baseline;gap:10rpx}
.review-number{font-size:31rpx;font-weight:600;color:#e7a24e;line-height:1.3}
.review-completed{color:#25b48a}
.review-caption{font-size:22rpx;color:#737783}
.review-divider{height:26rpx;width:1rpx;background:#eaf0f9}
.review-arrow{margin-left:auto;font-size:31rpx;color:#9295a0;line-height:1}
.mistake-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:22rpx;color:#9295a0;margin-top:20rpx}
.mistake-link{color:#0071e3;font-size:23rpx}

.title { font-size: 34rpx; }
