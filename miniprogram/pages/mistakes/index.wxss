.mistakes-hero{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.mistakes-filter{display:flex;gap:24rpx;padding:24rpx}
.filter-column{flex:1;min-width:0}
.filter-column + .filter-column{padding-left:24rpx;border-left:1rpx solid var(--line, #dce2df)}
.filter-column .filter-label{display:block;font-size:24rpx;color:var(--secondary, #536168);margin-bottom:8rpx}
.filter-choice{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:var(--ink, #263238);font-size:28rpx;font-weight:500;min-height:42rpx}
.filter-choice > text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.create-entry{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx;border:1rpx solid var(--line, #dce2df)}
.create-entry-main{display:flex;align-items:center;gap:16rpx;min-width:0}
.create-icon{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--subtle, #eef1ef);border-radius:32rpx}
.create-icon image{width:44rpx;height:44rpx}
.create-entry-title{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}
.create-entry-subtitle{font-size:24rpx;color:var(--secondary, #536168);margin-top:8rpx}
.create-toggle{color:var(--accent, #176b91);font-size:24rpx;white-space:nowrap}
.create-arrow{font-size:32rpx;margin-left:8rpx;vertical-align:-2rpx}
.form-heading{margin-bottom:16rpx}
.form-heading .hint{margin-top:0}
.create-form textarea{min-height:170rpx}
.required{color:var(--accent, #176b91);margin-left:8rpx}
.optional{font-size:24rpx;color:var(--muted, #68767c);margin-left:16rpx;font-weight:400}
.mistake-list-head{margin:24rpx 2rpx 16rpx}
.mistake-list-head .hint{margin-top:0}
.mistake-card{padding:24rpx}
.mistake-top{display:flex;align-items:center;gap:16rpx}
.subject-icon{width:78rpx;height:78rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:600;line-height:1;flex-shrink:0}
.subject-chinese{color:var(--warning, #885c18);background:var(--warning-soft, #fbf3e5)}
.subject-math{color:var(--accent, #176b91);background:var(--subtle, #eef1ef)}
.subject-english{color:var(--muted, #68767c);background:var(--subtle, #eef1ef);font-size:28rpx}
.subject-other{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}
.mistake-subject{flex:1;min-width:0}
.subject-name{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}
.student-name{font-size:24rpx;color:var(--secondary, #536168);margin-top:3rpx}
.mistake-status{display:inline-block;border-radius:16rpx;padding:8rpx 16rpx;font-size:24rpx;line-height:1.5;white-space:nowrap}
.status-mastered{background:var(--subtle, #eef1ef);color:var(--success, #23734e)}
.status-review{background:var(--subtle, #eef1ef);color:var(--accent, #176b91)}
.status-uncorrected{background:var(--danger-soft, #fceff0);color:var(--warning, #885c18)}
.mistake-title{font-size:28rpx;font-weight:600;line-height:1.7;color:var(--ink, #263238);margin-top:16rpx;word-break:break-all;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.knowledge-line{display:flex;align-items:flex-start;gap:16rpx;margin-top:16rpx;font-size:24rpx;line-height:1.7}
.knowledge-label{background:var(--subtle, #eef1ef);color:var(--secondary, #536168);padding:1rpx 8rpx;border-radius:8rpx;flex-shrink:0}
.knowledge-value{color:var(--secondary, #536168);word-break:break-all;min-width:0}
.review-strip{display:flex;align-items:center;gap:24rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;margin-top:16rpx;padding:16rpx 24rpx}
.review-item{display:flex;align-items:baseline;gap:8rpx}
.review-number{font-size:32rpx;font-weight:600;color:var(--warning, #885c18);line-height:1.3}
.review-completed{color:var(--success, #23734e)}
.review-caption{font-size:24rpx;color:var(--secondary, #536168)}
.review-divider{height:26rpx;width:1rpx;background:var(--subtle, #eef1ef)}
.review-arrow{margin-left:auto;font-size:32rpx;color:var(--muted, #68767c);line-height:1}
.mistake-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:24rpx;color:var(--muted, #68767c);margin-top:24rpx}
.mistake-link{color:var(--accent, #176b91);font-size:24rpx}

.title { font-size: 36rpx; }
