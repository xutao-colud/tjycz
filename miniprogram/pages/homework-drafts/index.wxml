<app-nav /><view class="page"><view class="hero"><view class="title">拍照作业草稿</view><view class="subtitle">识别内容先校对，确认后再分配。</view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
<block wx:if="{{!loading && !error}}">
  <block wx:if="{{!draft}}"><button class="primary gap" bindtap="scan">拍照自动录入</button><button wx:for="{{drafts}}" wx:key="id" class="card draft-row" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="card-title col">{{item.subject}} · {{item.studentName}}</text><text class="badge">{{item.statusText}}</text></view><view class="hint">{{item.date}} · {{item.createdText}}</view></button><state-view empty="{{!drafts.length}}" empty-text="暂无拍照作业草稿，拍照识题后勾选题目即可生成" /></block>
  <block wx:if="{{draft}}"><view class="row gap"><button class="text-button" bindtap="back" disabled="{{busy}}">‹ 草稿列表</button><button class="text-button" bindtap="source">核对原图与题框 ›</button></view><view wx:if="{{draft.status === 'ASSIGNED'}}" class="notice">已分配 {{draft.taskIds.length}} 道作业，重复提交不会重复创建。<button class="text-button" bindtap="homework">查看作业 ›</button></view>
    <view class="card"><view class="field"><text class="label">科目</text><select-picker range="{{subjects}}" value="{{subjectIndex}}" bindchange="subject" disabled="{{busy || draft.status !== 'DRAFT' || !draft.canManage}}" label="作业科目"><view class="form-pick">{{subjects[subjectIndex]}}</view></select-picker></view><view class="field"><text class="label">作业日期</text><date-picker value="{{taskDate}}" bindchange="datePick" disabled="{{busy || draft.status !== 'DRAFT' || !draft.canManage}}" label="作业日期"><view class="form-pick">{{taskDate}}</view></date-picker></view></view>
    <view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><view class="card-title col">第 {{item.displayNumber}} 题</view><button wx:if="{{draft.status === 'DRAFT' && draft.canManage}}" class="text-button" data-id="{{item.id}}" bindtap="remove" disabled="{{busy || items.length < 2}}">移除</button></view><view class="field gap"><text class="label">作业标题</text><input value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="edit" maxlength="200" disabled="{{busy || draft.status !== 'DRAFT' || !draft.canManage}}" /></view><view class="field"><text class="label">印刷题干 · 可校对</text><textarea value="{{item.questionText}}" data-index="{{index}}" data-field="questionText" bindinput="edit" maxlength="10000" disabled="{{busy || draft.status !== 'DRAFT' || !draft.canManage}}" placeholder="可对照原图补充，图表和公式保留裁图" /></view></view>
    <view wx:if="{{draft.status === 'DRAFT' && draft.canManage}}" class="card"><view class="field"><text class="label">按班级选择</text><select-picker range="{{classNames}}" value="{{classIndex}}" bindchange="classPick" disabled="{{busy}}" label="接收班级"><view class="form-pick">{{classNames[classIndex]}}</view></select-picker></view><student-picker students="{{students}}" selected="{{studentIds}}" multiple title="接收学生" bindchange="pickStudents" /><view class="hint gap">仅可分配到同校区内有权限的学生，原图不直接发给家长；每道题裁图分别关联到对应孩子。</view><view class="actions"><button class="secondary" bindtap="save" disabled="{{busy}}">保存草稿</button><button class="primary" bindtap="assign" loading="{{busy}}" disabled="{{busy || !studentIds.length}}">确认分配 · {{studentIds.length}} 人</button></view></view>
  </block><view wx:if="{{actionError}}" class="error">{{actionError}}<button class="text-button" bindtap="retry" disabled="{{busy}}">重新载入草稿</button></view>
</block></view>
