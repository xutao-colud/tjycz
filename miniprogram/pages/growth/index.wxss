@import "../../styles/growth.wxss";
.growth-heading { display:flex; align-items:center; justify-content:space-between; margin:6rpx 4rpx 20rpx; }
.date-strip { display:flex; align-items:center; gap:10rpx; margin-bottom:22rpx; }
.day { flex:1; min-width:0; padding:12rpx 5rpx; border-radius: 22rpx; color:#737783; background: #eeeef3; font-size:23rpx; line-height:1.6; }
.day text { display:block; }.day.selected { color:#fff; background: #0071e3;  box-shadow: 0 6rpx 16rpx rgba(0,113,227,.12);}.calendar-icon { width:42rpx; height:42rpx; margin:0 6rpx; }
.student-card { display:flex; align-items:center; gap:18rpx; padding: 28rpx 24rpx; border-radius: 32rpx; background: linear-gradient(120deg,#edf1f8,#f7f8fb); }
.profile-icon { width:94rpx; height:94rpx; }.student-name { font-size:32rpx; font-weight:650; color:#1d1d1f; }.child-switch { color:#0071e3; font-size:22rpx; margin-left:14rpx; }.student-meta { margin-top:8rpx; font-size:25rpx; color:#737783; }
.growth-banner { width:100%; display:flex; gap:18rpx; align-items:center; padding:20rpx; margin:18rpx 0; border-radius:22rpx; text-align:left; line-height:1.6; }.growth-banner image { width:50rpx; height:50rpx; flex-shrink:0; }.positive { background:#eafaf1; color:#246947; }.attention { background:#fff0f0; color:#c82439; }.banner-title { font-size:26rpx; font-weight:600; word-break:break-word; }.banner-copy { font-size:22rpx; color:#737783; margin-top:4rpx; }
.growth-metrics { display:flex; gap:12rpx; margin:20rpx 0 24rpx; }.growth-metric { flex:1; min-width:0; border:2rpx solid transparent; border-radius: 28rpx; padding:24rpx 6rpx 18rpx; text-align:center; }.growth-metric image { width:52rpx; height:52rpx; margin-bottom:12rpx; }.growth-metric text { display:block; }.metric-name { font-size:25rpx; color:#50535d; }.metric-number { font-size:36rpx; color:#1d1d1f; font-weight:650; margin:10rpx 0 5rpx; line-height:1.4; }.metric-note { font-size:21rpx; color:#737783; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.metric-selected { border-color:#c9cdd7; }
.timeline { padding:8rpx 2rpx 0 10rpx; }.timeline-entry { display:flex; gap:18rpx; position:relative; padding-bottom:30rpx; }.timeline-entry:before { content:""; position:absolute; width:2rpx; background:#eaf0f9; top:40rpx; bottom:0; left:23rpx; }.timeline-entry:last-child:before { display:none; }.event-symbol { z-index:1; flex-shrink:0; display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; }.event-symbol image { width:36rpx; height:36rpx; }.event-body { flex:1; min-width:0; }.event-top { display:flex; align-items:center; gap:12rpx; min-height:48rpx;  flex-wrap: wrap;}.event-time { font-size:27rpx; color:#1d1d1f; font-weight:600; flex-shrink:0; }.event-title { font-size: 28rpx; font-weight:600; color:#1d1d1f; }.event-content { margin-top:8rpx; }.event-content .body-text { font-size:26rpx; line-height:1.7; }.event-link { padding:4rpx 0; text-align:left; font-size:22rpx; }.contact-button { width:100%; padding:24rpx; margin-top:14rpx; border-radius: 26rpx; }.contact-hint { text-align:center; }

.growth-page .section-title { font-size:32rpx; }.student-card select-picker { padding:0 20rpx 0 0; border:0; background:transparent; }.student-card select-picker::after { display:none; }.growth-page .section-head select-picker { padding:0; border:0; background:transparent; }.growth-page .section-head select-picker::after { display:none; }

/* Pickup surfaces follow the supplied blue and pastel growth reference. */
.pickup-status { width:100%; display:flex; align-items:center; gap:18rpx; padding:22rpx 24rpx; margin:18rpx 0; border:1rpx solid #dff1e9; border-radius:26rpx; background:#f0faf6; text-align:left; }
.pickup-status image { width:56rpx;height:56rpx;flex-shrink:0; }.pickup-status-title { color:#11934d;font-size:29rpx;font-weight:600; }.pickup-status-note { color:#78869b;font-size:22rpx;line-height:1.7;margin-top:6rpx; }.pickup-open { font-size:22rpx;color:#1677ff;flex-shrink:0; }.pickup-attention { background:#fff1f1;border-color:#ffe1e4; }.pickup-attention .pickup-status-title { color:#d6384a; }
.growth-applications { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14rpx;margin:24rpx 0; }.growth-application { background:transparent;padding:12rpx 4rpx;border:2rpx solid transparent;border-radius:26rpx; }.growth-application image { display:block;width:72rpx;height:72rpx;margin:0 auto 14rpx; }.growth-application text { font-size:23rpx;color:#4c5d7c; }.pickup-app-active { border-color:#c9e0ff;background:#f3f8ff; }
.pickup-info-card { border:1rpx solid #edf2fa;border-radius:28rpx;background:#fff;padding:20rpx 24rpx;margin:22rpx 0;box-shadow:0 8rpx 28rpx rgba(40,76,132,.035); }.pickup-info-row { display:flex;align-items:center;gap:20rpx;width:100%;text-align:left;background:transparent;padding:16rpx 0 2rpx; }.pickup-info-row image { width:78rpx;height:78rpx; }.pickup-info-label { font-size:22rpx;color:#8491a8; }.pickup-info-name { font-size:26rpx;color:#263653;margin-top:8rpx; }
.growth-metric.blue { background:#eff6ff; }.growth-metric.orange { background:#fff8ee; }.growth-metric.green { background:#eefbf5; }.growth-metric.purple { background:#f5f0ff; }.student-card { background:#eff6ff; }.timeline-entry:before { background:#dce9ff; }.event-symbol.blue { background:#e9f2ff; }.event-title { color:#172647; }.event-time { font-variant-numeric:tabular-nums; }

/* Override style v2's button:not([size=mini]) fixed width within growth cards. */
.growth-page .pickup-status, .growth-page .pickup-info-row, .growth-page .growth-banner, .growth-page .detail-row, .growth-page .contact-button { width:100%; margin-left:0; margin-right:0; }
.growth-applications .growth-application { width:100%; min-width:0; margin:0; }
.growth-page .text-button { width:auto; margin-left:0; margin-right:0; }

.focus-homework { margin-top:22rpx; }.homework-title { color:#333842; font-size:27rpx; }.focus-homework .detail-row { width:100%; margin:0; }.focus-homework .list-description { margin-top:8rpx; }
.growth-page .card-head .text-button { margin:0; padding:0; font-size:23rpx; }.attendance-clocks { display:flex; gap:20rpx; }.attendance-clocks>view { flex:1; min-width:0; padding:10rpx 0; }.attendance-clocks>view+view { border-left:1rpx solid #eeeef3; padding-left:30rpx; }.attendance-clocks text { font-size:23rpx; color:#9295a0; }.attendance-clocks view view { margin-top:10rpx; color:#333842; font-size:33rpx; font-weight:600; }.attendance-record-link { padding:16rpx 0 0; font-size:23rpx; }
.growth-page .contact-button { font-size:25rpx; padding:18rpx; margin-top:22rpx; }.balance-reminder { background:transparent; color:#a17636; font-size:24rpx; padding:8rpx 0 18rpx; width:100%; margin:0; text-align:left; }.home-secondary { display:flex; justify-content:space-between; gap:16rpx; }.home-secondary .text-button { font-size:24rpx; }

.learning-progress { font-size: 30rpx; font-weight: 600; }
.correction-note { color: #a33d22; font-size: 24rpx; }
.growth-page .card-head .text-button { min-height: 80rpx; }
.growth-page .detail-row .col { min-width: 0; overflow-wrap: anywhere; }
.pickup-line { padding: 14rpx 18rpx; background: transparent; }
.work-compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 12rpx; }
