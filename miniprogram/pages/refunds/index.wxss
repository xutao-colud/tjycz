@import "../../styles/growth.wxss";
.refund-compose { margin-top:24rpx; }
.refund-card { width:100%; margin-top:24rpx; text-align:left; line-height:1.6; }
.refund-card .card-title { overflow-wrap:anywhere; }
.refund-amount { font-size:48rpx; font-weight:600; color:var(--ink, #263238); margin-top:24rpx; font-variant-numeric:tabular-nums; }
.source-summary { padding:24rpx; border-radius:24rpx; background:var(--subtle, #eef1ef); color:var(--ink, #263238); font-size:24rpx; line-height:1.8; word-break:break-word; }
.log-name { color:var(--ink, #263238); font-size:28rpx; font-weight:600; }
.refunds-page .row { flex-wrap:wrap; }
.refunds-page textarea { min-height:160rpx; }
