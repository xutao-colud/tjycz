<app-nav />
<view class="{{user.role === 'PARENT' ? 'parent-view' : ''}} {{reducedMotion ? 'reduce-motion' : ''}} {{!loading ? 'parent-ready' : ''}} page refunds-page">
  <view class="hero"><view class="title">{{id ? '退款详情' : '退款与记录'}}</view><view class="subtitle">申请有进展，账目有依据</view></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <view hidden="{{loading || error}}">
    <block wx:if="{{!id}}">
      <view class="filter-bar"><select-picker class="filter-item" plain="{{true}}" range="{{childNames}}" value="{{childIndex}}" bindchange="child" label="选择学生或孩子" disabled="{{busy}}"><view class="filter-value">{{childNames[childIndex] || '暂无学生'}} ⌄</view></select-picker><select-picker plain="{{true}}" range="{{stateNames}}" value="{{stateIndex}}" bindchange="filter" label="筛选退款状态" disabled="{{busy}}"><view class="filter-pill">{{stateNames[stateIndex]}} ⌄</view></select-picker></view>
      <view class="notice">审核通过后预留课时，机构完成线下退款并确认后扣减。这里不会自动转账。</view>
      <button class="secondary" bindtap="toggleCompose" disabled="{{busy || !sources.length}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">{{compose ? '收起填写区' : admin ? '登记退款申请' : '申请退款'}}</button>
      <view wx:if="{{!sources.length}}" class="hint">暂无可退的已确认续费单。待审核申请也会占用原单可退额度。</view>
      <view wx:if="{{compose}}" class="card refund-compose">
        <view class="card-title">选择原单，填写拟退内容</view>
        <view class="field gap"><text class="label">原续费单 *</text><select-picker range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="source" label="选择原续费单" disabled="{{busy}}"><view>{{sourceNames[sourceIndex] || '暂无可退原单'}}</view></select-picker></view>
        <view wx:if="{{selectedSource}}" class="source-summary"><view>原单剩余可退 ¥{{selectedSource.refundableText}}</view><view>购买 {{selectedSource.refundableLessons}} / 赠送 {{selectedSource.refundableGiftLessons}} 课时</view><view class="hint">账户当前可用 {{selectedSource.availableBalance}} 课时，审核时会再次核对。</view></view>
        <view class="field gap"><text class="label">拟退金额（元）*</text><input type="digit" aria-label="拟退金额元" value="{{amountYuan}}" data-field="amountYuan" bindinput="field" disabled="{{busy}}" placeholder="例如 100.00" maxlength="20" /></view>
        <view class="form-grid"><view class="field"><text class="label">退回购买课时</text><input type="digit" aria-label="退回购买课时" value="{{lessons}}" data-field="lessons" bindinput="field" disabled="{{busy}}" placeholder="0" maxlength="12" /></view><view class="field"><text class="label">退回赠送课时</text><input type="digit" aria-label="退回赠送课时" value="{{giftLessons}}" data-field="giftLessons" bindinput="field" disabled="{{busy}}" placeholder="0" maxlength="12" /></view></view>
        <view class="field"><text class="label">申请原因 *</text><textarea aria-label="退款申请原因" value="{{reason}}" data-field="reason" bindinput="field" disabled="{{busy}}" maxlength="1000" placeholder="请说明退款原因" /></view>
        <button class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy || !selectedSource}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">提交审核</button>
      </view>
      <button wx:for="{{rows}}" wx:key="id" class="card refund-card" data-id="{{item.id}}" bindtap="open" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}"><view class="row"><view class="col card-title">{{item.studentName}} · {{item.courseName}}</view><text class="status {{item.tone}}">{{item.statusText}}</text></view><view class="refund-amount">¥{{item.moneyText}}</view><view class="section-note">原单 #{{item.renewalId}} · 购买 {{item.lessons}} / 赠送 {{item.giftLessons}} {{item.unit}}</view><view class="body-text">{{item.reason}}</view><view class="row hint"><text>{{item.createdText}}</text><text>查看记录 ›</text></view></button>
      <view wx:if="{{!rows.length}}" class="card empty-inline">当前条件下暂无退款记录</view>
    </block>
    <block wx:if="{{detail}}">
      <button class="text-button" bindtap="list" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">‹ 返回退款列表</button>
      <view class="card"><view class="row"><view class="card-title col">{{detail.studentName}} · {{detail.courseName}}</view><text class="status {{detail.tone}}">{{detail.statusText}}</text></view><view class="refund-amount">¥{{detail.moneyText}}</view><view class="section-note">原续费单 #{{detail.renewalId}} · 退款单 #{{detail.id}}</view><view class="source-summary">退回购买 {{detail.lessons}} / 赠送 {{detail.giftLessons}} {{detail.unit}}</view><view class="body-text gap">{{detail.reason}}</view><view class="hint">{{detail.applicantName}} · {{detail.createdText}}</view><view wx:if="{{detail.reviewNote}}" class="reason-box">审核意见：{{detail.reviewNote}}</view><view wx:if="{{detail.status === 'CONFIRMED'}}" class="source-summary gap"><view>已退款：{{detail.confirmedText}}</view><view>凭证：{{detail.paymentReference}}</view><view>说明：{{detail.confirmationNote}}</view><view class="hint">退款课时流水 #{{detail.ledgerId}}，记录不可编辑。</view></view></view>
      <view wx:if="{{detail.canReview || detail.canCancel || detail.canConfirm}}" class="card">
        <view class="card-title">{{detail.canConfirm ? '登记实际线下退款' : detail.canReview ? '审核与处理' : '申请处理'}}</view>
        <block wx:if="{{detail.canConfirm}}"><view class="field gap"><text class="label">实际退款方式 *</text><select-picker range="{{paymentNames}}" value="{{paymentIndex}}" bindchange="payment" label="实际退款方式" disabled="{{busy}}"><view>{{paymentNames[paymentIndex]}}</view></select-picker></view><view class="field"><text class="label">退款流水号 / 签收凭证 *</text><input aria-label="退款流水号或签收凭证" value="{{paymentReference}}" data-field="paymentReference" bindinput="field" disabled="{{busy}}" maxlength="200" placeholder="现金退款填写签收记录编号" /></view></block>
        <view class="field gap"><text class="label">{{detail.canConfirm ? '确认说明 / 取消原因 *' : detail.canReview ? '审核意见 / 取消原因 *' : '取消原因 *'}}</text><textarea aria-label="退款处理说明" value="{{processNote}}" data-field="processNote" bindinput="field" maxlength="1000" disabled="{{busy}}" placeholder="填写具体意见或原因" /></view>
        <view class="actions"><button wx:if="{{detail.canReview}}" class="primary" data-approved="1" bindtap="review" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">通过并预留课时</button><button wx:if="{{detail.canReview}}" class="secondary" data-approved="0" bindtap="review" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">驳回</button><button wx:if="{{detail.canConfirm}}" class="primary" bindtap="confirmRefund" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">已实际退款，确认登记</button><button wx:if="{{detail.canCancel}}" class="secondary" bindtap="cancel" disabled="{{busy}}" hover-class="{{user.role === 'PARENT' ? 'parent-pressed' : 'button-hover'}}" hover-stay-time="{{user.role === 'PARENT' ? 80 : 400}}">取消申请</button></view>
      </view>
      <view class="section-head"><view class="section-title">申请与处理记录</view></view>
      <view wx:for="{{detail.logs}}" wx:key="id" class="card"><view class="row"><view class="log-name">{{item.actorName}} · {{item.statusText}}</view><text class="hint">{{item.createdText}}</text></view><view class="body-text small-gap">{{item.text}}</view></view>
    </block>
    <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
  </view>
</view>
