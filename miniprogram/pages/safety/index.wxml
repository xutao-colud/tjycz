<app-nav />
<view class="page safety-page">
  <view class="hero safety-heading"><view><view class="title">{{revokeSuccess ? '已撤销授权' : tab === 'leaves' ? '整日请假' : '接送管理'}}</view><view class="subtitle">每一次交接，都多一份安心</view></view><button wx:if="{{!revokeSuccess}}" class="safety-small-link" data-tab="{{tab === 'leaves' ? 'pickups' : 'leaves'}}" bindtap="tab" disabled="{{busy}}">{{tab === 'leaves' ? '接送管理' : '整日请假'}}</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bindretry="retry" />
  <block wx:if="{{!loading && !error}}">
    <block wx:if="{{revokeSuccess}}"><view class="revoked-success"><image src="/assets/icons/attendance.png" mode="aspectFit" /><view>接送授权已撤销</view><text>接送人已无法凭这份授权接走孩子。老师可查看更新后的安排。</text></view><view class="card revoked-person"><image src="/assets/icons/user.png" mode="aspectFit" /><view><view class="contact-name">{{revokeSuccess.pickupName}}</view><view class="hint">{{revokeSuccess.datesText}} · {{revokeSuccess.windowText}}</view></view><text class="badge dim">已撤销</text></view><button class="primary gap" bindtap="closeRevokeSuccess">返回接送管理</button></block>
    <block wx:else>
      <view class="filter-bar safety-filters"><select-picker class="safety-child-picker" range="{{childNames}}" value="{{childIndex}}" bindchange="changeChild" label="选择学生或孩子" disabled="{{busy}}"><view>{{childNames[childIndex]}}</view></select-picker><date-picker value="{{date}}" bindchange="changeDate" label="选择安排日期" disabled="{{busy}}"><view>{{date}}</view></date-picker></view>
      <view wx:if="{{issuedCode}}" class="card code-card"><view class="label">本次接送码 · 仅显示一次</view><view class="pickup-code">{{issuedCode}}</view><view class="hint">请私下交给接送人；切换页面后不再显示。</view><button class="secondary gap" bindtap="clearCode">已妥善保存</button></view>
      <block wx:if="{{tab === 'leaves'}}">
        <view class="notice">整日请假经另一位校长或老板批准后不签到、不消课。临时返校前请先撤销请假。</view>
        <button class="secondary" data-kind="leave" bindtap="compose" disabled="{{busy}}">{{compose ? '收起填写区' : '申请整日请假'}}</button>
        <view wx:if="{{compose === 'leave'}}" class="card gap"><view class="field"><text class="label">请假原因 *</text><textarea value="{{reason}}" data-field="reason" bindinput="field" maxlength="1000" disabled="{{busy}}" aria-label="请假原因" placeholder="请说明整日请假原因" /></view><button class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}">提交请假审核</button></view>
        <view class="field gap"><text class="label">处理说明</text><textarea value="{{note}}" data-field="note" bindinput="field" maxlength="1000" disabled="{{busy}}" aria-label="审核意见或撤销请假原因" placeholder="审核或撤销请假时，请填写具体意见或原因" /></view>
        <view wx:for="{{leaves}}" wx:key="id" class="card"><view class="row"><view class="col card-title">{{item.studentName}} · {{item.leaveDate}}</view><text class="badge">{{item.statusText}}</text></view><view class="body-text gap">{{item.reason}}</view><view class="hint">申请人 {{item.createdByName}}</view><view wx:if="{{item.reviewComment}}" class="notice">{{item.reviewedByName}}：{{item.reviewComment}}</view><view class="actions"><button wx:if="{{item.canReview}}" class="primary" data-id="{{item.id}}" data-action="approve" bindtap="processLeave" disabled="{{busy}}">批准</button><button wx:if="{{item.canReview}}" class="secondary" data-id="{{item.id}}" data-action="reject" bindtap="processLeave" disabled="{{busy}}">驳回</button><button wx:if="{{item.canCancel}}" class="secondary" data-id="{{item.id}}" data-action="cancel" bindtap="processLeave" disabled="{{busy}}">撤销请假</button></view><view wx:for="{{item.logs}}" wx:for-item="log" wx:key="id" class="safety-log">{{log.createdText}} · {{log.actorName}}<view>{{log.detail}}</view></view></view><view wx:if="{{!leaves.length}}" class="card empty-inline">当日暂无请假安排</view>
      </block>
      <block wx:else>
        <view wx:if="{{!teacher || !alertOpenCount}}" class="safety-banner"><image src="/assets/icons/attendance.png" mode="aspectFit" /><view><view>守护孩子的安全接送</view><text>老师现场拍照记录到校和离校，家长可查看打卡照片</text></view></view>
        <block wx:if="{{teacher}}">
          <view class="pickup-alert-head"><view class="section-title">异常接送提醒<text wx:if="{{alertOpenCount}}">{{alertOpenCount}}</text></view><button class="safety-small-link" bindtap="toggleAlert" disabled="{{busy}}">{{alertCompose ? '收起' : '登记异常'}}</button></view>
          <view wx:if="{{alertCompose}}" class="card alert-form"><view class="hint">登记现场异常后，孩子应继续留在校区，等待监护人确认。</view><view class="field"><text class="label">来接人姓名 *</text><input value="{{alertName}}" data-field="alertName" bindinput="field" maxlength="80" placeholder="现场来接人姓名" aria-label="异常来接人姓名" /></view><view class="field"><text class="label">电话后四位（可选）</text><input value="{{alertLast4}}" data-field="alertLast4" bindinput="field" type="number" maxlength="4" placeholder="不清楚可留空" aria-label="异常来接人电话后四位" /></view><view class="field"><text class="label">异常原因 *</text><textarea value="{{alertReason}}" data-field="alertReason" bindinput="field" maxlength="1000" placeholder="例如不在授权名单、身份信息不符" aria-label="异常接送原因" /></view><button class="primary" bindtap="reportAlert" loading="{{busy}}" disabled="{{busy}}">登记异常并暂不离校</button></view>
          <view wx:for="{{alerts}}" wx:key="id" class="pickup-alert {{item.status === 'RESOLVED' ? 'alert-resolved' : ''}}"><view class="row"><view class="col"><view class="pickup-alert-title">{{item.studentName}} · 异常接送</view><view class="hint">{{item.createdText}}</view></view><text class="badge {{item.status === 'RESOLVED' ? 'dim' : 'alert-badge'}}">{{item.statusText}}</text></view><view class="pickup-alert-person">来接人：{{item.pickupName}}<text>电话后四位 {{item.phoneLast4}}</text></view><view class="pickup-alert-reason">{{item.reason}}</view><view class="actions"><button wx:if="{{item.parentPhone}}" class="primary" data-id="{{item.id}}" bindtap="contactParent">联系家长</button><button wx:if="{{item.canHandle}}" class="alert-hold-button" data-id="{{item.id}}" data-action="HOLD" bindtap="handleAlert" disabled="{{busy}}">暂不离校</button></view><view wx:if="{{item.canHandle}}" class="field"><text class="label">联系情况与核对说明</text><textarea value="{{alertNote}}" data-field="alertNote" bindinput="field" maxlength="1000" placeholder="解除异常前，请记录与监护人的核对结果" aria-label="异常接送处理说明" /></view><button wx:if="{{item.canHandle}}" class="secondary" data-id="{{item.id}}" data-action="RESOLVED" bindtap="handleAlert" disabled="{{busy}}">已与家长核对</button><view class="hint gap">核对完成后，仍须凭有效授权完成现场核验，再确认离校。</view><view wx:for="{{item.logs}}" wx:for-item="log" wx:key="id" class="safety-log">{{log.createdText}} · {{log.actorName}}<view>{{log.note || log.detail}}</view></view></view>
        </block>
        <view wx:if="{{!legacyPickup && photoRecord}}" class="card">
          <view class="row"><view class="card-title">{{photoRecord.studentName}}</view><text class="badge">{{photoRecord.statusText}}</text></view>
          <view class="detail-row"><text>到校签到</text><text>{{photoRecord.checkInTime ? photoRecord.arrival : '暂无记录'}}</text></view>
          <file-list files="{{photoRecord.checkInPhotos}}" />
          <view class="detail-row"><text>离校签退</text><text>{{photoRecord.checkOutTime ? photoRecord.departure : '暂无记录'}}</text></view>
          <file-list files="{{photoRecord.checkOutPhotos}}" />
          <button wx:if="{{teacher && date === today && (photoRecord.status === 'NOT_ARRIVED' || photoRecord.status === 'PRESENT')}}" class="primary gap" bindtap="photoMark" loading="{{busy}}" disabled="{{busy || (photoRecord.status === 'PRESENT' && alertOpenCount)}}">{{photoRecord.status === 'PRESENT' ? '拍照签退' : '拍照签到'}}</button>
        </view>
        <view wx:if="{{!legacyPickup && !photoRecord}}" class="empty-inline">选择学生后查看打卡记录</view>
        <block wx:if="{{legacyPickup}}">
        <view class="pickup-tabs"><button class="{{viewTab === 'contacts' ? 'pickup-tab-active' : ''}}" data-view="contacts" bindtap="view" aria-pressed="{{viewTab === 'contacts'}}">常用接送人 <text>{{contacts.length}}</text></button><button class="{{viewTab === 'pickups' ? 'pickup-tab-active' : ''}}" data-view="pickups" bindtap="view" aria-pressed="{{viewTab === 'pickups'}}">临时授权 <text>{{activeCount}}</text></button></view>
        <block wx:if="{{viewTab === 'contacts'}}">
          <view class="card contacts-card"><view wx:for="{{contacts}}" wx:key="id" class="contact-row"><image class="contact-avatar {{item.hasAvatar ? 'contact-avatar-photo' : ''}}" src="{{item.avatarUrl}}" mode="aspectFill" /><view class="col"><view class="contact-name">{{item.name}}<text wx:if="{{item.isDefault}}" class="contact-default">默认</text></view><view class="contact-description">{{item.relationship}} · {{item.displayPhone}}</view><view wx:if="{{item.canManage && contactDetailId === item.id}}" class="contact-actions"><button data-id="{{item.id}}" bindtap="editContact" disabled="{{busy}}">编辑</button><button wx:if="{{!item.isDefault}}" data-id="{{item.id}}" bindtap="setDefault" disabled="{{busy}}">设为默认</button><button data-id="{{item.id}}" bindtap="authorize" disabled="{{busy}}">授权接送</button><button class="contact-remove" data-id="{{item.id}}" bindtap="removeContact" disabled="{{busy}}">删除</button></view></view><button wx:if="{{item.canManage}}" class="contact-manage" data-id="{{item.id}}" bindtap="contactDetails">{{contactDetailId === item.id ? '收起' : '管理'}}</button></view><view wx:if="{{!contacts.length}}" class="empty-inline">{{studentId ? '暂未登记常用接送人' : '请先选择一位学生或孩子'}}</view></view>
          <view wx:if="{{contacts.length}}" class="contact-list-hint">常用名单便于快速安排接送，交接时仍须有效授权与现场核验。</view><button wx:if="{{!teacher}}" class="add-contact-button" bindtap="editContact" disabled="{{busy}}">添加常用接送人</button>
          <view wx:if="{{contactForm}}" class="card contact-edit"><view class="section-title">{{contactId ? '编辑常用接送人' : '添加常用接送人'}}</view><view class="field"><text class="label">姓名 *</text><input value="{{contactName}}" data-field="contactName" bindinput="field" maxlength="80" placeholder="真实姓名" aria-label="常用接送人姓名" /></view><view class="field"><text class="label">与孩子关系 *</text><input value="{{contactRelationship}}" data-field="contactRelationship" bindinput="field" maxlength="40" placeholder="例如妈妈、爸爸、奶奶" aria-label="常用接送人与孩子关系" /></view><view class="field"><text class="label">联系电话 *</text><input value="{{contactPhone}}" data-field="contactPhone" bindinput="field" type="number" maxlength="20" placeholder="联系电话" aria-label="常用接送人联系电话" /></view><button class="contact-check" bindtap="contactDefault" role="checkbox" aria-checked="{{contactDefault}}"><checkbox checked="{{contactDefault}}" /><text>设为默认接送人</text></button><view class="hint">修改或删除接送人时，关联的有效授权会撤销，请重新核对安排。</view><view class="actions"><button class="secondary" bindtap="cancelContact" disabled="{{busy}}">取消</button><button class="primary" bindtap="saveContact" loading="{{busy}}" disabled="{{busy}}">保存接送人</button></view></view>
          <view wx:if="{{!teacher}}" class="temporary-intro"><view class="section-title">临时接送授权</view><view class="hint">需要亲友临时代接？设置接送时间，完成安排后交由老师现场核验。</view></view>
        </block>
        <block wx:else>
          <view wx:for="{{pickupGroups}}" wx:for-item="group" wx:key="key" class="authorization-group"><view class="authorization-group-title {{group.key === 'active' ? 'current-group' : ''}}">{{group.title}}</view><view wx:for="{{group.items}}" wx:key="id" class="card authorization-card"><view class="authorization-card-person"><view class="contact-asset"><image src="/assets/icons/user.png" mode="aspectFit" /></view><view class="col"><view class="contact-name">{{item.pickupName}}<text class="contact-relation">{{item.relationship}}</text></view><view class="contact-description">{{item.studentName}} · {{item.phoneMasked}}</view><view class="authorization-window">{{item.datesText}}<text>{{item.windowText}}</text></view></view><text class="badge {{item.tone}}">{{item.statusText}}</text></view><view class="authorization-card-actions"><text>{{item.modeText}}{{item.usedToday ? ' · 今日已使用' : ''}}</text><button class="secondary" data-id="{{item.id}}" bindtap="detail">{{detailId === item.id ? '收起' : '查看'}}</button><button wx:if="{{item.canRevoke}}" class="revoke-outline" data-id="{{item.id}}" bindtap="openRevoke" disabled="{{busy}}">撤销授权</button></view>
            <view wx:if="{{detailId === item.id}}" class="authorization-detail"><view class="hint">授权监护人 {{item.guardianName}}</view><view wx:if="{{item.note}}" class="body-text gap">{{item.note}}</view><view class="hint gap">{{item.verificationText}}</view><button wx:if="{{item.canRevoke}}" class="secondary gap" data-id="{{item.id}}" data-action="rotate-code" bindtap="processPickup" disabled="{{busy}}">重置接送码</button><view wx:for="{{item.logs}}" wx:for-item="log" wx:key="id" class="safety-log">{{log.createdText}} · {{log.actorName}}<view>{{log.detail}}</view></view></view>
            <view class="actions"><button wx:if="{{item.canVerify}}" class="secondary" data-id="{{item.id}}" bindtap="openVerify" disabled="{{busy}}">现场核验</button><button wx:if="{{item.canCheckout}}" class="primary" data-id="{{item.id}}" bindtap="checkout" disabled="{{busy}}">确认实际离校</button></view>
            <view wx:if="{{verifyId === item.id}}" class="verify-form"><view class="field"><text class="label">现场确认的姓名 *</text><input value="{{pickupName}}" data-field="pickupName" bindinput="field" maxlength="80" disabled="{{busy}}" aria-label="现场确认的接送人姓名" /></view><view class="field"><text class="label">电话后四位 *</text><input value="{{phoneLast4}}" data-field="phoneLast4" bindinput="field" maxlength="4" type="number" disabled="{{busy}}" aria-label="电话后四位" /></view><view class="field"><text class="label">六位接送码 *</text><input value="{{code}}" data-field="code" bindinput="field" maxlength="6" type="number" disabled="{{busy}}" aria-label="六位接送码" /></view><button class="text-button" bindtap="identity" role="checkbox" aria-checked="{{identityChecked}}" disabled="{{busy}}"><checkbox checked="{{identityChecked}}" disabled="{{busy}}" />已当面核对身份与授权信息</button><button class="primary gap" bindtap="verify" disabled="{{busy}}" loading="{{busy}}">确认核验</button></view>
          </view><view wx:if="{{!group.items.length}}" class="authorization-empty">{{group.key === 'active' ? '暂无有效授权，请监护人提前安排接送' : '暂无历史授权'}}</view></view>
        </block>
        <view wx:if="{{!teacher && tab !== 'leaves' && !revokeSuccess}}" class="pickup-bottom-action"><button class="primary" bindtap="authorize" disabled="{{busy}}">申请临时接送授权</button></view>
        </block>
      </block>
      <view wx:if="{{actionError}}" class="error">{{actionError}}</view>
    </block>
  </block>
</view>
<view wx:if="{{revokeRow}}" class="pickup-modal" catchtouchmove="swallow"><view class="pickup-modal-mask" bindtap="cancelRevoke"></view><view class="pickup-modal-panel" role="dialog" aria-modal="true" aria-label="确认撤销授权"><view class="pickup-modal-title">确认撤销授权？</view><view class="pickup-modal-explain">撤销后，接送人无法再凭此授权接走孩子。旧接送码与旧核验都会失效。</view><view class="pickup-modal-person"><image src="/assets/icons/user.png" mode="aspectFit" /><view><view>{{revokeRow.pickupName}} · {{revokeRow.relationship}}</view><text>{{revokeRow.datesText}} {{revokeRow.windowText}}</text></view></view><view class="field"><text class="label">撤销原因 *</text><textarea value="{{revokeReason}}" data-field="revokeReason" bindinput="field" maxlength="1000" disabled="{{busy}}" placeholder="例如接送安排有变，改由妈妈接走" aria-label="撤销授权原因" /></view><view class="actions"><button class="secondary" bindtap="cancelRevoke" disabled="{{busy}}">取消</button><button class="revoke-confirm" bindtap="confirmRevoke" loading="{{busy}}" disabled="{{busy}}">确认撤销</button></view></view></view>
