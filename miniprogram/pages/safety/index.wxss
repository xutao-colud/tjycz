.authorization-group{margin-top:25rpx}.authorization-group-title{font-size:24rpx;font-weight:600;padding:16rpx 22rpx;background:#edf4fc;border-radius:18rpx 18rpx 0 0;color:#627b9c}.authorization-group-title.current-group{color:#3d916d;background:#ecf9f2}.authorization-card{padding:24rpx;margin-top:0;border-radius:0 0 24rpx 24rpx}.authorization-card-person{display:flex;gap:16rpx;align-items:flex-start}.contact-asset{display:flex;align-items:center;justify-content:center;width:75rpx;height:75rpx;flex-shrink:0;background:#edf5ff;border-radius:24rpx}.contact-asset image{width:43rpx;height:43rpx}.authorization-card-person .badge{font-size:20rpx;padding:6rpx 12rpx;margin-top:5rpx}.authorization-window{font-size:21rpx;color:#8797ad;line-height:1.8}.authorization-window text{display:block}.authorization-card-actions{display:flex;gap:13rpx;align-items:center;justify-content:flex-end;padding-top:22rpx}.authorization-card-actions>text{margin-right:auto;font-size:21rpx;color:#8d9caf}.authorization-card-actions button{min-width:95rpx;margin:0;padding:10rpx 18rpx;border-radius:13rpx;font-size:22rpx;line-height:1.6;font-weight:400}.revoke-outline{color:#de6666;background:#fff;border:1rpx solid #ffc7c7}.authorization-detail{margin-top:23rpx;padding-top:20rpx;border-top:1rpx solid #eaf0f6}.authorization-empty{padding:36rpx 22rpx;background:#fff;border:1rpx solid #edf1f7;border-top:0;border-radius:0 0 20rpx 20rpx;font-size:23rpx;text-align:center;color:#a1adbd}.pickup-bottom-action{position:fixed;bottom:0;left:0;right:0;z-index:100;max-width:750rpx;margin:0 auto;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #edf1f8}.pickup-bottom-action button{width:100%;border-radius:19rpx;font-size:26rpx}
.code-card{background:#eef5ff;text-align:center}.pickup-code{color:#007aff;font-size:64rpx;font-weight:650;letter-spacing:12rpx;padding:20rpx 0}.safety-log{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #e9eef5;font-size:22rpx;color:#8a96a9;line-height:1.8;overflow-wrap:anywhere}.verify-form{margin-top:28rpx;padding:24rpx;border-radius:24rpx;background:#f4f8fe}.safety-page .actions{flex-wrap:wrap}.authorization-card>.actions:empty{display:none}
