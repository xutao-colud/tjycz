.safety-page{padding-bottom:208rpx}.safety-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.safety-heading .title{font-size:36rpx}.safety-small-link{padding:16rpx 0;margin:0;flex-shrink:0;background:transparent;color:var(--accent, #176b91);font-size:24rpx;font-weight:500;line-height:1.7}.safety-filters{display:flex;gap:16rpx;align-items:center;padding:16rpx;margin-bottom:24rpx;background:var(--surface, #ffffff);border:1rpx solid var(--line, #dce2df);border-radius:24rpx}.safety-child-picker{flex:1;min-width:0}.safety-filters date-picker{width:230rpx;flex-shrink:0}.safety-banner{display:flex;align-items:center;gap:24rpx;padding:32rpx 24rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;margin:24rpx 0}.safety-banner image{width:68rpx;height:68rpx;flex-shrink:0}.safety-banner view>view{font-size:28rpx;color:var(--accent, #176b91);font-weight:600}.safety-banner text{display:block;margin-top:8rpx;font-size:24rpx;color:var(--muted, #68767c);line-height:1.7}
.pickup-tabs{display:flex;border-bottom:1rpx solid var(--line, #dce2df);margin:24rpx 0}.pickup-tabs button{flex:1;margin:0;padding:24rpx 8rpx;border-radius:0;background:transparent;font-size:24rpx;line-height:1.7;font-weight:500;color:var(--muted, #68767c);position:relative}.pickup-tabs .pickup-tab-active{color:var(--accent, #176b91);font-weight:600}.pickup-tab-active:before{content:"";position:absolute;bottom:0;left:16%;right:16%;height:4rpx;background:var(--accent, #176b91);border-radius:8rpx}.pickup-tabs text{margin-left:8rpx}
.contacts-card{padding:0 24rpx;overflow:hidden}.contact-row{display:flex;align-items:flex-start;gap:24rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line, #dce2df)}.contact-row:last-child{border:0}.contact-avatar{width:84rpx;height:84rpx;flex-shrink:0;object-fit:cover;border-radius:24rpx;background:var(--subtle, #eef1ef);padding:16rpx}.contact-name{font-size:28rpx;font-weight:600;color:var(--ink, #263238);line-height:1.6;overflow-wrap:anywhere}.contact-default,.contact-relation{font-size:24rpx;font-weight:400;margin-left:16rpx;color:var(--accent, #176b91);padding:8rpx 8rpx;background:var(--subtle, #eef1ef);border-radius:8rpx}.contact-default{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}.contact-description{margin:8rpx 0;font-size:24rpx;color:var(--muted, #68767c);line-height:1.7}.contact-actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.contact-actions button{padding:8rpx 0;margin:0;font-size:24rpx;color:var(--muted, #68767c);background:transparent;line-height:1.7;font-weight:400}.contact-actions .contact-remove{color:var(--muted, #68767c)}.add-contact-button{margin:24rpx 0 0;padding:24rpx;border:1rpx solid var(--line, #dce2df);border-radius:16rpx;background:var(--surface, #ffffff);color:var(--accent, #176b91);font-size:24rpx;font-weight:500}.contact-edit{margin-top:24rpx}.contact-edit .section-title{margin-bottom:24rpx}.contact-edit input{background:var(--subtle, #eef1ef);border:1rpx solid var(--line, #dce2df)}.contact-check{display:flex;align-items:center;gap:8rpx;text-align:left;padding:16rpx 0;font-size:24rpx;color:var(--muted, #68767c);font-weight:400;background:transparent}.contact-check checkbox{transform:scale(.85)}.temporary-intro{padding:40rpx 2rpx 24rpx}.temporary-intro .hint{margin-top:16rpx;line-height:1.9}
.authorization-group{margin-top:24rpx}.authorization-group-title{font-size:24rpx;font-weight:600;padding:16rpx 24rpx;background:var(--subtle, #eef1ef);border-radius:16rpx 16rpx 0 0;color:var(--muted, #68767c)}.authorization-group-title.current-group{color:var(--success, #23734e);background:var(--subtle, #eef1ef)}.authorization-card{padding:24rpx;margin-top:0;border-radius:0 0 24rpx 24rpx}.authorization-card-person{display:flex;gap:16rpx;align-items:flex-start}.contact-asset{display:flex;align-items:center;justify-content:center;width:75rpx;height:75rpx;flex-shrink:0;background:var(--subtle, #eef1ef);border-radius:24rpx}.contact-asset image{width:43rpx;height:43rpx}.authorization-card-person .badge{font-size:24rpx;padding:8rpx 16rpx;margin-top:8rpx}.authorization-window{font-size:24rpx;color:var(--muted, #68767c);line-height:1.8}.authorization-window text{display:block}.authorization-card-actions{display:flex;gap:16rpx;align-items:center;justify-content:flex-end;padding-top:24rpx}.authorization-card-actions>text{margin-right:auto;font-size:24rpx;color:var(--muted, #68767c)}.authorization-card-actions button{min-width:95rpx;margin:0;padding:8rpx 16rpx;border-radius:16rpx;font-size:24rpx;line-height:1.6;font-weight:400}.revoke-outline{color:var(--danger, #b33740);background:var(--surface, #ffffff);border:1rpx solid var(--line, #dce2df)}.authorization-detail{margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid var(--line, #dce2df)}.authorization-empty{padding:40rpx 24rpx;background:var(--surface, #ffffff);border:1rpx solid var(--line, #dce2df);border-top:0;border-radius:0 0 24rpx 24rpx;font-size:24rpx;text-align:center;color:var(--muted, #68767c)}.pickup-bottom-action{position:fixed;bottom:0;left:0;right:0;z-index:100;max-width:750rpx;margin:0 auto;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid var(--line, #dce2df)}.pickup-bottom-action button{width:100%;border-radius:16rpx;font-size:28rpx}
.code-card{background:var(--subtle, #eef1ef);text-align:center}.pickup-code{color:var(--accent, #176b91);font-size:64rpx;font-weight:600;letter-spacing:0;padding:24rpx 0}.safety-log{margin-top:24rpx;padding-top:16rpx;border-top:1rpx solid var(--line, #dce2df);font-size:24rpx;color:var(--muted, #68767c);line-height:1.8;overflow-wrap:anywhere}.verify-form{margin-top:32rpx;padding:24rpx;border-radius:24rpx;background:var(--subtle, #eef1ef)}.safety-page .actions{flex-wrap:wrap}.authorization-card>.actions:empty{display:none}
.pickup-modal{position:fixed;inset:0;z-index:180;display:flex;align-items:center;justify-content:center;padding:32rpx}.pickup-modal-mask{position:absolute;inset:0;background:rgba(26,37,55,.36)}.pickup-modal-panel{position:relative;width:100%;max-width:640rpx;max-height:85vh;overflow:auto;padding:32rpx 32rpx;background:var(--surface, #ffffff);border-radius:32rpx;box-shadow:none}.pickup-modal-title{font-size:32rpx;font-weight:600;text-align:center;color:var(--ink, #263238)}.pickup-modal-explain{font-size:24rpx;color:var(--muted, #68767c);line-height:1.9;margin:24rpx 0 24rpx;text-align:center}.pickup-modal-person{display:flex;align-items:center;gap:16rpx;background:var(--subtle, #eef1ef);border-radius:24rpx;padding:24rpx;color:var(--secondary, #536168);font-size:24rpx}.pickup-modal-person image{width:60rpx;height:60rpx}.pickup-modal-person text{display:block;margin-top:8rpx;color:var(--muted, #68767c);font-size:24rpx}.pickup-modal-panel .field{margin-top:24rpx}.pickup-modal-panel textarea{height:148rpx;min-height:148rpx;background:var(--subtle, #eef1ef)}.revoke-confirm{color:var(--surface, #ffffff);background:var(--danger, #b33740)}.revoked-success{display:flex;align-items:center;flex-direction:column;padding:48rpx 16rpx 32rpx;text-align:center}.revoked-success image{width:100rpx;height:100rpx;margin-bottom:32rpx}.revoked-success>view{font-size:32rpx;font-weight:600;color:var(--ink, #263238)}.revoked-success>text{font-size:24rpx;color:var(--muted, #68767c);line-height:1.9;margin-top:24rpx}.revoked-person{display:flex;align-items:center;gap:24rpx}.revoked-person image{width:70rpx;height:70rpx}.revoked-person .badge{margin-left:auto}
.pickup-alert-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:32rpx}.pickup-alert-head .section-title{font-size:28rpx}.pickup-alert-head .section-title text{display:inline-block;font-size:24rpx;background:var(--subtle, #eef1ef);color:var(--danger, #b33740);padding:2rpx 8rpx;margin-left:16rpx;border-radius:24rpx}.pickup-alert{margin:24rpx 0 32rpx;padding:24rpx;border:1rpx solid var(--line, #dce2df);border-radius:24rpx;background:var(--subtle, #eef1ef)}.pickup-alert-title{font-size:28rpx;font-weight:600;color:var(--danger, #b33740)}.pickup-alert-person{font-size:28rpx;font-weight:600;color:var(--secondary, #536168);margin-top:24rpx}.pickup-alert-person text{display:block;font-size:24rpx;font-weight:400;color:var(--muted, #68767c);margin-top:8rpx}.pickup-alert-reason{margin-top:16rpx;padding:16rpx 24rpx;background:var(--subtle, #eef1ef);border-radius:16rpx;color:var(--danger, #b33740);font-size:24rpx;line-height:1.8}.pickup-alert .field{margin-top:24rpx}.pickup-alert textarea{background:var(--surface, #ffffff);min-height:135rpx;height:135rpx;border:1rpx solid var(--line, #dce2df)}.alert-badge{color:var(--danger, #b33740);background:var(--danger-soft, #fceff0)}.alert-hold-button{color:var(--danger, #b33740);background:var(--surface, #ffffff);border:1rpx solid var(--line, #dce2df)}.pickup-alert .actions button{min-width:170rpx;font-size:24rpx;padding:16rpx 16rpx}.alert-resolved{border-color:var(--line, #dce2df);background:var(--subtle, #eef1ef)}.alert-resolved .pickup-alert-title{color:var(--success, #23734e)}.alert-resolved .pickup-alert-reason{background:var(--subtle, #eef1ef);color:var(--success, #23734e)}.alert-form{margin-top:16rpx}.alert-form .field{margin-top:24rpx}

