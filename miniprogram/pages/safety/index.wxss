.safety-page{padding-bottom:210rpx}.safety-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.safety-heading .title{font-size:36rpx}.safety-small-link{padding:12rpx 0;margin:0;flex-shrink:0;background:transparent;color:#0071e3;font-size:23rpx;font-weight:500;line-height:1.7}.safety-filters{display:flex;gap:18rpx;align-items:center;padding:18rpx;margin-bottom:24rpx;background:#fff;border:1rpx solid #edf1f7;border-radius:24rpx}.safety-child-picker{flex:1;min-width:0}.safety-filters date-picker{width:230rpx;flex-shrink:0}.safety-banner{display:flex;align-items:center;gap:20rpx;padding:28rpx 24rpx;background:#eaf4ff;border-radius:24rpx;margin:20rpx 0}.safety-banner image{width:68rpx;height:68rpx;flex-shrink:0}.safety-banner view>view{font-size:28rpx;color:#2b67ad;font-weight:650}.safety-banner text{display:block;margin-top:9rpx;font-size:22rpx;color:#8092aa;line-height:1.7}
