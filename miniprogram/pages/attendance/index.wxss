.attendance-hero{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.hero-icon{width:84rpx;height:84rpx;flex-shrink:0}
.attendance-filter{padding:24rpx}
.filter-columns{display:flex;gap:24rpx}
.filter-column{flex:1;min-width:0}
.filter-column + .filter-column{border-left:1rpx solid #e7e8ee;padding-left:24rpx}
.filter-column .filter-label{display:block;font-size:22rpx;color:#737783;margin-bottom:8rpx}
.filter-choice{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#1d1d1f;font-size:26rpx;font-weight:500;min-height:44rpx}
.filter-choice > text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.attendance-stats{display:flex;gap:16rpx;margin:0 0 18rpx}
.attendance-stat{flex:1;text-align:center;background:#fff;border-radius:28rpx;padding:20rpx 10rpx;border:1rpx solid #e7e8ee}
.stat-number{font-size:40rpx;font-weight:650;color:#1d1d1f;line-height:1.3}
.stat-green{color:#25bb91}
.stat-blue{color:#0071e3}
.stat-caption{font-size:22rpx;color:#737783;margin-top:7rpx}
.batch-heading{margin-bottom:22rpx}
.selected-count{background:#f4f4f7;color:#0071e3;border-radius:14rpx;padding:6rpx 14rpx;font-size:22rpx}
.attendance-actions{display:flex;gap:18rpx}
.attendance-actions button{flex:1;border-radius:26rpx;padding:23rpx 18rpx}
.batch-hint{font-size:22rpx;line-height:1.6;color:#737783;margin-top:18rpx}
.result-card{border:1rpx solid #dff2eb}
.result-heading{margin-bottom:20rpx}
.result-summary{font-size:22rpx;color:#737783}
.result-row{padding:19rpx 0;border-top:1rpx solid #e7e8ee}
.result-row:last-child{padding-bottom:0}
.result-name{display:flex;align-items:center;gap:12rpx;font-size:27rpx;font-weight:500;color:#1d1d1f}
.result-dot{display:inline-block;width:12rpx;height:12rpx;border-radius:50%;background:#25bb91;flex-shrink:0}
.result-dot-fail{background:#ef9a61}
.result-label{font-size:23rpx}
.result-message{font-size:23rpx;color:#737783;margin-top:8rpx;padding-left:24rpx;line-height:1.6;word-break:break-all}
.attendance-list-head{margin:24rpx 2rpx 18rpx}
.attendance-list-head .hint{margin-top:0}
.attendance-record{padding:24rpx}
.record-head{display:flex;align-items:center;gap:18rpx}
.record-avatar{width:74rpx;height:74rpx;flex-shrink:0;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:600}
.record-tone-0{color:#9295a0;background:#f4f4f7}
.record-tone-1{color:#daa044;background:#fff3df}
.record-tone-2{color:#a47ce1;background:#f3edff}
.record-student{flex:1;min-width:0}
.record-name{font-size:29rpx;font-weight:600;color:#1d1d1f}
.record-student .list-description{font-size:23rpx;margin-top:3rpx}
.record-left{background:#f4f4f7;color:#737783}
.time-columns{display:flex;background:#fafafd;border-radius:26rpx;padding:22rpx 0;margin-top:18rpx}
.time-cell{flex:1;min-width:0;padding:0 24rpx}
.time-cell + .time-cell{border-left:1rpx solid #e7e8ee}
.time-caption{font-size:22rpx;color:#737783}
.time-dot{display:inline-block;width:9rpx;height:9rpx;background:#25bb91;border-radius:50%;margin-right:10rpx;vertical-align:middle}
.out-dot{background:#7aa7eb}
.time-value{color:#1d1d1f;font-size:32rpx;font-weight:600;line-height:1.3;margin-top:8rpx}
.record-source{font-size:21rpx;color:#9295a0;text-align:right;margin-top:14rpx}

.title { font-size: 34rpx; }
