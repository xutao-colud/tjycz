.row date-picker { flex: 1; min-width: 0; }
.row select-picker { padding:0; flex:1; min-width:0; font-size: 24rpx; }
.check-time { display: flex; justify-content: space-between; gap: 24rpx; margin: 24rpx 0; color: var(--secondary, #536168); font-size: 24rpx; }
.check-time text { color: var(--ink, #263238); }
