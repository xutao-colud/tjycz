.campus-stats { display: flex; flex-wrap: wrap; gap: 16rpx 32rpx; margin-top: 24rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.small { flex-shrink: 0; padding: 16rpx 24rpx; font-size: 24rpx; }
.campus-access { margin-top: 16rpx; color: var(--secondary, #536168); font-size: 24rpx; }
.access-editor { border-color: var(--line, #dce2df); }
.campus-choices { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }
.campus-choice { padding: 16rpx 24rpx; border: 1rpx solid var(--line, #dce2df); background: var(--subtle, #eef1ef); color: var(--secondary, #536168); font-size: 24rpx; }
.campus-choice.chosen { color: var(--accent, #176b91); background: var(--subtle, #eef1ef); border-color: var(--line, #dce2df); }
.access-editor .row button { flex: 1; }
