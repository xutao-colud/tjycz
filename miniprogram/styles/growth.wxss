.blue { background:var(--subtle, #eef1ef); color:var(--accent, #176b91); }.green { background:var(--subtle, #eef1ef); color:var(--success, #23734e); }.orange { background:var(--warning-soft, #fbf3e5); color:var(--warning, #885c18); }.purple { background:var(--subtle, #eef1ef); color:var(--muted, #68767c); }.red { background:var(--subtle, #eef1ef); color:var(--danger, #b33740); }
.status { display:inline-block; flex-shrink:0; max-width:180rpx; padding:8rpx 16rpx; border-radius:16rpx; font-size:24rpx; line-height:1.5; }
.detail-row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; width:100%; text-align:left; padding:16rpx 0; border-bottom:1rpx solid var(--line, #dce2df); background:transparent; color:var(--secondary, #536168); font-size:24rpx; line-height:1.65; }.detail-row:last-child { border:0; }
.reason-box { padding:24rpx; margin-top:16rpx; background:var(--subtle, #eef1ef); color:var(--danger, #b33740); border-radius:24rpx; font-size:24rpx; line-height:1.8; white-space:pre-wrap; word-break:break-word; }
.filter-pill { padding:8rpx 24rpx; border:1rpx solid var(--line, #dce2df); border-radius:32rpx; color:var(--secondary, #536168); background:var(--surface, #ffffff); font-size:24rpx; }
.subheading { color:var(--ink, #263238); font-size:28rpx; font-weight:600; margin:24rpx 0 16rpx; }.form-grid { display:flex; gap:16rpx; }.form-grid .field { flex:1; min-width:0; }.form-pick { min-height:0; padding:0; color:inherit; background:transparent; font-size:28rpx; }
.switch-row { display:flex; align-items:center; justify-content:space-between; margin:24rpx 0; font-size:24rpx; color:var(--secondary, #536168); }.required { color:var(--danger, #b33740); }.pre-line { white-space:pre-wrap; word-break:break-word; }.section-note { color:var(--secondary, #536168); font-size:24rpx; line-height:1.8; margin:8rpx 0; }
.card-title,.event-title { overflow-wrap:anywhere; word-break:break-word; }
