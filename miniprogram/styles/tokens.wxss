/* 天健悦成长：校区蓝、纸白与语义状态色。组件隔离模式也加载同一组变量。 */
page, :host {
  --paper: #f5f6f4;
  --surface: #ffffff;
  --subtle: #eef1ef;
  --ink: #263238;
  --secondary: #536168;
  --muted: #68767c;
  --line: #dce2df;
  --accent: #176b91;
  --accent-soft: #eaf2f6;
  --success: #23734e;
  --success-soft: #edf6ef;
  --warning: #885c18;
  --warning-soft: #fbf3e5;
  --danger: #b33740;
  --danger-soft: #fceff0;
  --page-inset: 20px;
  --content-inset: 16px;
  --section-gap: 24px;
  --text-title: 23px;
  --text-section: 18px;
  --text-body: 15px;
  --text-note: 13px;
  --text-number: 30px;
  --tap-size: 44px;
  --space: 8rpx;
  --control-radius: 16rpx;
  --card-radius: 24rpx;
}
