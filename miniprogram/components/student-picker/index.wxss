@import "../../styles/tokens.wxss";
:host {
  display: block;
}

.picker {
  box-sizing: border-box;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line, #dce2df);
  border-radius: 14px;
  background: var(--surface, #ffffff);
  color: var(--ink, #263238);
  font-size: var(--text-body);
  line-height: 1.5;
 box-shadow: none;}

.head {
  display: flex;
  align-items: center;
}

.head-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.students-icon {
  width: 38rpx;
  height: 38rpx;
}

.head-copy {
  flex: 1;
  min-width: 0;
}

.title {
  color: var(--ink, #263238);
  font-size: var(--text-body);
  font-weight: 600;
  word-break: break-all;
}

.count {
  margin-top: 2rpx;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
}

.count-number {
  color: var(--accent, #176b91);
  font-weight: 600;
}

.expand-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 16rpx 0 16rpx 16rpx;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
}

.chevron {
  width: 10rpx;
  height: 10rpx;
  margin: -8rpx 8rpx 0 16rpx;
  border-right: 3rpx solid var(--line, #dce2df);
  border-bottom: 3rpx solid var(--line, #dce2df);
  transform: rotate(45deg);
}

.chevron-up {
  margin-top: 8rpx;
  transform: rotate(225deg);
}

.selection {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  margin-bottom: -8rpx;
}

.selected-name,
.selected-more {
  box-sizing: border-box;
  max-width: 100%;
  padding: 8rpx 16rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius:32rpx;
  font-size: var(--text-note);
  word-break: break-all;
}

.selected-name {
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
}

.selected-more {
  background: var(--subtle, #eef1ef);
  color: var(--secondary, #536168);
}

.selection-placeholder {
  padding-top: 16rpx;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
}

.panel {
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line, #dce2df);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-size);
  margin-bottom: 16rpx;
}

.panel-hint {
  color: var(--secondary, #536168);
  font-size: var(--text-note);
}

.all {
  padding: 16rpx 24rpx;
  margin: 0;
  border: 0;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
  font-size: var(--text-note);
  font-weight: 500;
  line-height: 1.4;
}

.all::after {
  border: 0;
}

.student-scroll {
  max-height: 448rpx;
}

.student {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  min-height: 56px;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid transparent;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.student-selected {
  border-color: transparent;
  background: var(--subtle, #eef1ef);
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius:32rpx;
  background: var(--surface, #ffffff);
  color: var(--accent, #176b91);
  font-size: var(--text-body);
  font-weight: 600;
}

.student-copy {
  flex: 1;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: var(--ink, #263238);
  font-size: var(--text-body);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-name {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkbox {
  display: flex;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-left: 16rpx;
  border: 2rpx solid var(--line, #dce2df);
  border-radius:16rpx;
  background: var(--surface, #ffffff);
}

.checkbox-checked {
  border-color: var(--line, #dce2df);
  background: var(--accent, #176b91);
}

.checkmark {
  width: 9rpx;
  height: 17rpx;
  margin-top: 0rpx;
  border-right: 3rpx solid var(--surface, #ffffff);
  border-bottom: 3rpx solid var(--surface, #ffffff);
  transform: rotate(45deg);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
  color: var(--secondary, #536168);
  font-size: var(--text-note);
  text-align: center;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}
