:host {
  display: block;
}

.picker {
  box-sizing: border-box;
  padding: 22rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #fff;
  border-radius: 30rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 1.5;
 box-shadow: 0 8rpx 32rpx rgba(29,29,31,.035);}

.head {
  display: flex;
  align-items: center;
}

.head-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius:28rpx;
  background: #f0f2f7;
}

.students-icon {
  width: 38rpx;
  height: 38rpx;
}

.head-copy {
  flex: 1;
  min-width: 0;
}

.title {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-all;
}

.count {
  margin-top: 2rpx;
  color: #737783;
  font-size: 22rpx;
}

.count-number {
  color: #0071e3;
  font-weight: 600;
}

.expand-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 12rpx 0 12rpx 16rpx;
  color: #737783;
  font-size: 22rpx;
}

.chevron {
  width: 10rpx;
  height: 10rpx;
  margin: -6rpx 4rpx 0 12rpx;
  border-right: 3rpx solid #c9cdd7;
  border-bottom: 3rpx solid #c9cdd7;
  transform: rotate(45deg);
}

.chevron-up {
  margin-top: 6rpx;
  transform: rotate(225deg);
}

.selection {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 18rpx;
  margin-bottom: -8rpx;
}

.selected-name,
.selected-more {
  box-sizing: border-box;
  max-width: 100%;
  padding: 6rpx 16rpx;
  margin: 0 10rpx 8rpx 0;
  border-radius:28rpx;
  font-size: 23rpx;
  word-break: break-all;
}

.selected-name {
  background: #f4f4f7;
  color: #0071e3;
}

.selected-more {
  background: #fafafd;
  color: #737783;
}

.selection-placeholder {
  padding-top: 16rpx;
  color: #737783;
  font-size: 23rpx;
}

.panel {
  padding-top: 18rpx;
  margin-top: 18rpx;
  border-top: 1rpx solid #e7e8ee;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  margin-bottom: 12rpx;
}

.panel-hint {
  color: #737783;
  font-size: 22rpx;
}

.all {
  padding: 12rpx 20rpx;
  margin: 0;
  border: 0;
  border-radius:28rpx;
  background: #f4f4f7;
  color: #0071e3;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.4;
}

.all::after {
  border: 0;
}

.student-scroll {
  max-height: 448rpx;
}

.student {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  height: 104rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid transparent;
  border-radius:28rpx;
  background: #f5f5f7;
}

.student-selected {
  border-color: transparent;
  background: #eaf2ff;
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius:28rpx;
  background: #fff;
  color: #0071e3;
  font-size: 27rpx;
  font-weight: 600;
}

.student-copy {
  flex: 1;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-name {
  overflow: hidden;
  margin-top: 2rpx;
  color: #737783;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkbox {
  display: flex;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-left: 18rpx;
  border: 2rpx solid #e7e8ee;
  border-radius:14rpx;
  background: #fff;
}

.checkbox-checked {
  border-color: #c9cdd7;
  background: #0071e3;
}

.checkmark {
  width: 9rpx;
  height: 17rpx;
  margin-top: -4rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius:28rpx;
  background: #fafafd;
  color: #737783;
  font-size: 23rpx;
  text-align: center;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}
