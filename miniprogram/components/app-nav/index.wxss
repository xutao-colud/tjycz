:host { display: block; }
.campus-bar { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 20rpx 28rpx 0; padding: 14rpx 24rpx; border: 0; border-radius: 24rpx; background: rgba(255,255,255,.8); color: #737783; font-size: 22rpx; }
.campus-bar select-picker { flex: 1; min-width: 0; padding: 8rpx 0; color: #0071e3; text-align: right; }
.campus-name { color: #50535d; }
.campus-arrow { margin-left: 14rpx; }
.bottom-nav { position: fixed; z-index: 90; left: 0; right: 0; bottom: 0; display: flex; height: calc(100rpx + env(safe-area-inset-bottom)); padding: 8rpx 14rpx calc(8rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(60,60,67,.07); background: rgba(251,251,253,.94); box-sizing: border-box; box-shadow: 0 -4rpx 28rpx rgba(29,29,31,.025);  backdrop-filter: blur(24px);}
.tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #737783; font-size: 20rpx; line-height: 1.5; }
.tab.selected { color: #0071e3; font-weight: 500; }
.tab image { width: 44rpx; height: 44rpx; }
.task-symbol { display: flex; flex-direction: column; justify-content: center; gap: 4rpx; width: 29rpx; height: 33rpx; margin: 5rpx 0 6rpx; border: 3rpx solid #c9cdd7; border-radius: 4rpx; padding: 0 5rpx; box-sizing: border-box; }
.task-symbol view { height: 2rpx; background: #8e9eb8; border-radius: 2rpx; }
.task-symbol.symbol-selected { border-color: #c9cdd7; }
.task-symbol.symbol-selected view { background: #0071e3; }
.book-symbol { display: flex; width: 37rpx; height: 32rpx; margin: 7rpx 0 5rpx; }
.book-symbol view { flex: 1; border: 3rpx solid #c9cdd7; border-radius: 4rpx 4rpx 2rpx 2rpx; transform: skewY(8deg); }
.book-symbol view + view { margin-left: -1rpx; transform: skewY(-8deg); }
.book-symbol.symbol-selected view { border-color: #c9cdd7; }
.nav-overlay { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: rgba(26,27,33,.28); }
.nav-sheet { width: 100%; padding: 14rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; background: #fbfbfd; box-sizing: border-box; }
.sheet-handle { width: 56rpx; height: 6rpx; margin: 0 auto 18rpx; border-radius: 6rpx; background: #eaf0f9; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sheet-title { color: #1d1d1f; font-size: 32rpx; font-weight: 650; }
.sheet-close { width: 52rpx; height: 52rpx; border-radius: 50%; color: #737783; background: #fafafd; text-align: center; font-size: 37rpx; line-height: 47rpx; }
.app-group + .app-group { padding-top: 18rpx; border-top: 1rpx solid #e7e8ee; margin-top: 18rpx; }
.group-title { color: #737783; font-size: 22rpx; margin-bottom: 10rpx; }
.app-grid { display: flex; flex-wrap: wrap; }
.app-entry { display: flex; width: 25%; align-items: center; flex-direction: column; gap: 10rpx; padding: 16rpx 0; color: #50535d; font-size: 22rpx; }
.app-icon { width: 66rpx; height: 66rpx; }
.sheet-account { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding: 20rpx; border: 0; border-radius:22rpx; background: #eeeef3; }
.account-avatar { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; background: #f4f4f7; color: #0071e3; font-size: 27rpx; }
.account-copy { flex: 1; color: #50535d; font-size: 25rpx; }
.role { padding-left: 14rpx; font-size: 20rpx; color: #9295a0; }
.account-tip { margin-top: 4rpx; color: #9295a0; font-size: 20rpx; }
.account-arrow { color: #9295a0; font-size: 34rpx; }

.app-list-scroll { height: 55vh; margin-top: 20rpx; }
.app-list .app-entry { width: 100%; box-sizing: border-box; display:flex; flex-direction:row; align-items:center; gap:16rpx; min-height:82rpx; text-align:left; padding:14rpx 4rpx; border-bottom:1rpx solid #e7e8ee; background:transparent; }
.app-list .app-icon { flex-shrink:0; width:40rpx; height:40rpx; margin:0; }
.app-list .entry-arrow { margin-left:auto; }
