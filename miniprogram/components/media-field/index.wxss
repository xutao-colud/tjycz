@import "../../styles/tokens.wxss";
:host {
  display: block;
}

.media {
  color: var(--ink, #263238);
  font-size: 28rpx;
  line-height: 1.5;
}

.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.media-title {
  font-size: 28rpx;
  font-weight: 600;
}

.media-count {
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.upload-area {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  padding: 24rpx;
  margin: 0;
  border: 2rpx dashed var(--line, #dce2df);
  border-radius: 24rpx;
  background: var(--subtle, #eef1ef);
  color: var(--ink, #263238);
  text-align: left;
  line-height: 1.5;
}

.upload-area::after,
.record-button::after,
.stop-button::after,
.remove::after,
.settings-button::after {
  border: 0;
}

.upload-area[disabled] {
  border-color: var(--line, #dce2df);
  background: var(--subtle, #eef1ef);
  opacity: .65;
}

.upload-icon-wrap {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius:32rpx;
  background: var(--surface, #ffffff);
}

.upload-icon {
  width: 40rpx;
  height: 40rpx;
}

.upload-copy {
  flex: 1;
  min-width: 0;
}

.upload-title {
  color: var(--accent, #176b91);
  font-size: 28rpx;
  font-weight: 600;
}

.upload-description {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.upload-plus {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--accent, #176b91);
  font-size: 40rpx;
  font-weight: 300;
}

.record-button {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  padding: 24rpx 24rpx;
  margin: 16rpx 0 0;
  border: 1rpx solid transparent;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
  color: var(--ink, #263238);
  font-size: 24rpx;
  line-height: 1.5;
}

.record-button[disabled] {
  background: var(--subtle, #eef1ef);
  color: var(--secondary, #536168);
  opacity: .65;
}

.mic-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
}

.record-title {
  flex: 1;
  text-align: left;
}

.record-limit {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.recording-panel {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid var(--line, #dce2df);
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.recording-copy {
  flex: 1;
  min-width: 0;
}

.recording-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  color: var(--ink, #263238);
  font-size: 24rpx;
  font-weight: 500;
}

.recording-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--danger, #b33740);
  animation: pulse 1s ease-in-out infinite alternate;
}

.recording-time {
  margin-left: 16rpx;
  color: var(--danger, #b33740);
  font-size: 24rpx;
  font-weight: 400;
}

.recording-hint {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.stop-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 16rpx 16rpx;
  margin: 0 0 0 16rpx;
  border: 0;
  border-radius:24rpx;
  background: var(--surface, #ffffff);
  color: var(--danger, #b33740);
  font-size: 24rpx;
  line-height: 1.5;
}

.stop-mark {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
  background: var(--danger, #b33740);
}

.hint {
  margin-top: 16rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.uploaded-files {
  margin-top: 16rpx;
}

.file {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-top: 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.file-thumbnail,
.file-symbol {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius:32rpx;
  background: var(--surface, #ffffff);
}

.file-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-symbol-audio {
  background: var(--subtle, #eef1ef);
}

.file-symbol-video {
  background: var(--subtle, #eef1ef);
}

.type-icon {
  width: 38rpx;
  height: 38rpx;
}

.video-mark {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 21rpx solid var(--line, #dce2df);
}

.file-copy {
  flex: 1;
  min-width: 0;
}

.file-name {
  overflow: hidden;
  color: var(--ink, #263238);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.remove {
  flex-shrink: 0;
  padding: 16rpx 8rpx 16rpx 16rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.5;
}

.remove[disabled] {
  background: transparent;
  color: var(--muted, #68767c);
}

.error {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-top: 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
  color: var(--danger, #b33740);
  font-size: 24rpx;
}

.error-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin: 3rpx 16rpx 0 0;
  border: 1rpx solid var(--line, #dce2df);
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
}

.error-copy {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.settings-button {
  padding: 16rpx 24rpx;
  margin: 16rpx 0 0;
  border: 1rpx solid var(--line, #dce2df);
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
  color: var(--accent, #176b91);
  font-size: 24rpx;
  line-height: 1.5;
}

@keyframes pulse {
  from { opacity: .4; }
  to { opacity: 1; }
}
