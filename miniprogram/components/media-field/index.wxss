:host {
  display: block;
}

.media {
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 1.5;
}

.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.media-title {
  font-size: 26rpx;
  font-weight: 600;
}

.media-count {
  color: #737783;
  font-size: 22rpx;
}

.upload-area {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  padding: 20rpx;
  margin: 0;
  border: 2rpx dashed #d7dae3;
  border-radius: 26rpx;
  background: #f5f5f8;
  color: #1d1d1f;
  text-align: left;
  line-height: 1.5;
}

.upload-area::after,
.record-button::after,
.stop-button::after,
.remove::after,
.settings-button::after {
  border: 0;
}

.upload-area[disabled] {
  border-color: #e7e8ee;
  background: #fafafd;
  opacity: .65;
}

.upload-icon-wrap {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius:28rpx;
  background: #fff;
}

.upload-icon {
  width: 40rpx;
  height: 40rpx;
}

.upload-copy {
  flex: 1;
  min-width: 0;
}

.upload-title {
  color: #0071e3;
  font-size: 27rpx;
  font-weight: 600;
}

.upload-description {
  margin-top: 5rpx;
  color: #737783;
  font-size: 22rpx;
}

.upload-plus {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #0071e3;
  font-size: 40rpx;
  font-weight: 300;
}

.record-button {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: 100%;
  padding: 20rpx 24rpx;
  margin: 18rpx 0 0;
  border: 1rpx solid transparent;
  border-radius:28rpx;
  background: #f5f5f8;
  color: #1d1d1f;
  font-size: 25rpx;
  line-height: 1.5;
}

.record-button[disabled] {
  background: #fafafd;
  color: #737783;
  opacity: .65;
}

.mic-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
}

.record-title {
  flex: 1;
  text-align: left;
}

.record-limit {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #737783;
  font-size: 22rpx;
}

.recording-panel {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-top: 18rpx;
  border: 1rpx solid #f5dcd6;
  border-radius:28rpx;
  background: #fff8f6;
}

.recording-copy {
  flex: 1;
  min-width: 0;
}

.recording-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  color: #1d1d1f;
  font-size: 25rpx;
  font-weight: 500;
}

.recording-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #e57563;
  animation: pulse 1s ease-in-out infinite alternate;
}

.recording-time {
  margin-left: 14rpx;
  color: #b77b6e;
  font-size: 22rpx;
  font-weight: 400;
}

.recording-hint {
  margin-top: 6rpx;
  color: #737783;
  font-size: 20rpx;
}

.stop-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 14rpx 16rpx;
  margin: 0 0 0 14rpx;
  border: 0;
  border-radius:24rpx;
  background: #fff;
  color: #c36f5d;
  font-size: 22rpx;
  line-height: 1.5;
}

.stop-mark {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 3rpx;
  background: #e57563;
}

.hint {
  margin-top: 12rpx;
  color: #737783;
  font-size: 21rpx;
}

.uploaded-files {
  margin-top: 18rpx;
}

.file {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-top: 18rpx;
  border-radius:28rpx;
  background: #fafafd;
}

.file-thumbnail,
.file-symbol {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius:28rpx;
  background: #fff;
}

.file-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-symbol-audio {
  background: #e6f7f0;
}

.file-symbol-video {
  background: #f4f4f7;
}

.type-icon {
  width: 38rpx;
  height: 38rpx;
}

.video-mark {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 21rpx solid #c9cdd7;
}

.file-copy {
  flex: 1;
  min-width: 0;
}

.file-name {
  overflow: hidden;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  margin-top: 5rpx;
  color: #737783;
  font-size: 21rpx;
}

.remove {
  flex-shrink: 0;
  padding: 14rpx 4rpx 14rpx 16rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: #737783;
  font-size: 22rpx;
  line-height: 1.5;
}

.remove[disabled] {
  background: transparent;
  color: #9295a0;
}

.error {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-top: 18rpx;
  border-radius:28rpx;
  background: #fff4f0;
  color: #be745f;
  font-size: 23rpx;
}

.error-mark {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin: 3rpx 12rpx 0 0;
  border: 1rpx solid #dfac9d;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 600;
}

.error-copy {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.settings-button {
  padding: 16rpx 20rpx;
  margin: 18rpx 0 0;
  border: 1rpx solid #e7e8ee;
  border-radius:28rpx;
  background: #f4f4f7;
  color: #0071e3;
  font-size: 23rpx;
  line-height: 1.5;
}

@keyframes pulse {
  from { opacity: .4; }
  to { opacity: 1; }
}
