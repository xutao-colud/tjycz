:host {
  display: block;
}

.state {
  box-sizing: border-box;
  padding: 36rpx 24rpx;
  margin: 18rpx 0;
  border: 0;
  border-radius: 30rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
 box-shadow: 0 8rpx 32rpx rgba(29,29,31,.025);}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 18rpx;
  border-radius:28rpx;
  background: #fafafd;
}

.loading-icon {
  background: #f4f4f7;
}

.spinner {
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #e7e8ee;
  border-top-color: #c9cdd7;
  border-radius: 50%;
  animation: spin .85s linear infinite;
}

.state-title {
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 500;
}

.state-description {
  margin-top: 8rpx;
  color: #737783;
  font-size: 23rpx;
}

.error-icon {
  background: #fff4f0;
}

.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d48a75;
  border-radius: 50%;
  color: #d48a75;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.error-description {
  max-width: 560rpx;
  margin: 10rpx auto 0;
  word-break: break-all;
}

.retry-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 30rpx;
  margin: 18rpx 0 0;
  border: 0;
  border-radius:28rpx;
  background: #0071e3;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.retry-button::after {
  border: 0;
}

.retry-icon {
  margin-right: 12rpx;
  font-size: 31rpx;
  line-height: 1;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
}

.empty-title {
  max-width: 560rpx;
  margin: 0 auto;
  color: #737783;
  font-size: 25rpx;
  font-weight: 400;
  word-break: break-all;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
