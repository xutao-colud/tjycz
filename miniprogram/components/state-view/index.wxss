@import "../../styles/tokens.wxss";
:host {
  display: block;
}

.state {
  box-sizing: border-box;
  padding: 40rpx 24rpx;
  margin: 16rpx 0;
  border: 0;
  border-radius: 14px;
  background: var(--surface, #ffffff);
  color: var(--ink, #263238);
  font-size: var(--text-body);
  line-height: 1.6;
  text-align: center;
 box-shadow: none;}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 16rpx;
  border-radius:32rpx;
  background: var(--subtle, #eef1ef);
}

.loading-icon {
  background: var(--subtle, #eef1ef);
}

.spinner {
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid var(--line, #dce2df);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin .85s linear infinite;
}

.state-title {
  color: var(--ink, #263238);
  font-size: var(--text-body);
  font-weight: 500;
}

.state-description {
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
}

.error-icon {
  background: var(--subtle, #eef1ef);
}

.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--line, #dce2df);
  border-radius: 50%;
  color: var(--danger, #b33740);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.error-description {
  max-width: 560rpx;
  margin: 8rpx auto 0;
  word-break: break-all;
}

.retry-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-size);
  padding: 10px 16px;
  margin: 16rpx 0 0;
  border: 0;
  border-radius:32rpx;
  background: var(--accent, #176b91);
  color: var(--surface, #ffffff);
  font-size: var(--text-note);
  font-weight: 500;
  line-height: 1.5;
}

.retry-button::after {
  border: 0;
}

.retry-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
  line-height: 1;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
}

.empty-title {
  max-width: 560rpx;
  margin: 0 auto;
  color: var(--secondary, #536168);
  font-size: var(--text-note);
  font-weight: 400;
  word-break: break-all;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.spinner { animation-play-state:var(--parent-motion-state,running); }
