@import "../../styles/tokens.wxss";
:host{display:block}.trend-card{background:var(--surface, #ffffff);border:1rpx solid var(--line, #dce2df);border-top:4rpx solid var(--line, #dce2df);box-shadow:none;padding:32rpx;border-radius:32rpx;margin:24rpx 0}.trend-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.trend-title{font-size:28rpx;font-weight:600;color:var(--ink, #263238)}.trend-periods{display:flex;gap:8rpx;flex-shrink:0}.trend-periods button{width:auto;min-width:0;margin:0;padding:8rpx 16rpx;font-size:24rpx;line-height:1.5;background:var(--subtle, #eef1ef);color:var(--secondary, #536168);border-radius:16rpx}.trend-periods button::after{border:0}.trend-periods .active{background:var(--accent, #176b91);color:var(--surface, #ffffff)}.trend-legend{display:flex;gap:32rpx;font-size:24rpx;margin:24rpx 0}.correct{color:var(--accent, #176b91)}.incorrect{color:var(--danger, #b33740)}.trend-canvas{width:100%;height:200px}.trend-note{font-size:24rpx;line-height:1.7;color:var(--secondary, #536168);white-space:normal;text-align:left}.trend-details-toggle{width:auto;margin:16rpx 0 0;padding:8rpx 0;background:transparent;text-align:left;color:var(--accent, #176b91);font-size:24rpx;line-height:1.5}.trend-details-toggle::after{border:0}.trend-day{display:flex;justify-content:space-between;gap:16rpx;padding:16rpx 0;border-top:1rpx solid var(--line, #dce2df);font-size:24rpx;color:var(--secondary, #536168)}
