@import "../../styles/tokens.wxss";
:host { display:block; min-width:0; }
.select-trigger { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:var(--tap-size); padding:24rpx 24rpx; border:1rpx solid transparent; border-radius:24rpx; background:var(--subtle, #eef1ef); color:var(--ink, #263238); font-size:var(--text-body); line-height:1.55; }
.select-caption { flex:1; min-width:0; overflow-wrap:anywhere; }
.select-plain { min-height:var(--tap-size); padding:8rpx 0; border:0; border-radius:0; background:transparent; color:inherit; }
.select-disabled { opacity:.48; }
.select-pressed { opacity:.7; }
.select-chevron { width:11rpx; height:11rpx; flex-shrink:0; border-right:2rpx solid var(--muted, #68767c); border-bottom:2rpx solid var(--muted, #68767c); transform:rotate(45deg); margin:-8rpx 3rpx 0 0; }
.select-modal { position:fixed; z-index:170; inset:0; text-align:left; color:var(--ink, #263238); font-size:var(--text-body); font-weight:400; }
.select-mask { position:absolute; inset:0; background:rgba(26,27,33,.28); animation:select-fade .18s ease-out; }
.select-sheet { box-sizing:border-box; position:absolute; bottom:0; left:0; right:0; width:100%; max-width:960rpx; max-height:85vh; margin:0 auto; padding:16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:var(--subtle, #eef1ef); box-shadow:none; animation:select-rise .2s ease-out; }
.select-handle { width:64rpx; height:8rpx; border-radius:8rpx; background:var(--subtle, #eef1ef); margin:0 auto 24rpx; }
.select-header { display:flex; align-items:center; justify-content:space-between; gap:24rpx; padding:0 8rpx 24rpx 16rpx; font-size:var(--text-section); font-weight:600; }
.select-close { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:56rpx; height:56rpx; margin:0; padding:0; border:0; border-radius:50%; background:var(--subtle, #eef1ef); color:var(--secondary, #536168); font-size:40rpx; line-height:1; }
.select-close::after,.select-option::after,.select-cancel::after { border:0; }
.select-options { box-sizing:border-box; max-height:calc(70vh - 180rpx); padding:8rpx 0; }
.select-option { box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; gap:24rpx; width:100%; min-height:48px; margin:8rpx 0; padding:24rpx 24rpx; border:0; border-radius:24rpx; color:var(--ink, #263238); background:transparent; font-size:var(--text-body); font-weight:400; text-align:left; line-height:1.6; }
.select-option text { min-width:0; word-break:break-word; }
.select-option-selected { background:var(--subtle, #eef1ef); color:var(--accent, #176b91); font-weight:600; }
.select-option-pressed { background:var(--subtle, #eef1ef); }
.select-check { flex-shrink:0; width:12rpx; height:24rpx; margin:-8rpx 8rpx 0; border-right:3rpx solid var(--muted, #68767c); border-bottom:3rpx solid var(--muted, #68767c); transform:rotate(45deg); }
.select-cancel { display:flex; align-items:center; justify-content:center; width:100%; min-height:var(--tap-size); margin:24rpx 0 0; padding:16rpx; border:0; border-radius:24rpx; background:var(--subtle, #eef1ef); color:var(--ink, #263238); font-size:var(--text-body); font-weight:500; line-height:1.6; }
@keyframes select-fade { from { opacity:0; } to { opacity:1; } }
@keyframes select-rise { from { transform:translateY(40rpx); opacity:.5; } to { transform:translateY(0); opacity:1; } }
.select-close { width:var(--tap-size);height:var(--tap-size); }
.select-option-selected { color:var(--accent);background:var(--accent-soft); }

.select-mask { animation-duration:var(--parent-panel-duration,.18s); }
.select-sheet { animation-duration:var(--parent-panel-duration,.2s); }
