@import "../../styles/tokens.wxss";
:host {
  display: block;
}

.files {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin: 16rpx -8rpx 0;
  color: var(--ink, #263238);
  font-size: 24rpx;
  line-height: 1.5;
}

.file {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: calc(100% - 18rpx);
  padding: 16rpx;
  margin: 0 8rpx 16rpx;
  border: 1rpx solid var(--line, #dce2df);
  border-radius: 24rpx;
  background: var(--surface, #ffffff);
}

.file-image {
  display: block;
  overflow: hidden;
  width: calc(33.333333% - 18rpx);
  padding: 0;
}

.image-wrap {
  position: relative;
  height: 168rpx;
  background: var(--subtle, #eef1ef);
}

.thumbnail {
  display: block;
  width: 100%;
  height: 100%;
}

.image-badge {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  padding: 3rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(37, 50, 70, .56);
  color: var(--surface, #ffffff);
  font-size: 24rpx;
}

.image-name {
  overflow: hidden;
  padding: 8rpx 16rpx;
  color: var(--ink, #263238);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 16rpx;
  border-radius:32rpx;
  background: var(--surface, #ffffff);
}

.file-icon-audio {
  background: var(--subtle, #eef1ef);
}

.file-icon-video {
  background: var(--subtle, #eef1ef);
}

.type-icon {
  width: 38rpx;
  height: 38rpx;
}

.video-mark {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid var(--line, #dce2df);
}

.file-copy {
  flex: 1;
  min-width: 0;
}

.file-name {
  overflow: hidden;
  color: var(--ink, #263238);
  font-size: 24rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-description {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
  color: var(--secondary, #536168);
  font-size: 24rpx;
}

.kind-label {
  padding-right: 16rpx;
  margin-right: 16rpx;
  border-right: 1rpx solid var(--line, #dce2df);
  color: var(--secondary, #536168);
  line-height: 1.2;
}

.play-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--subtle, #eef1ef);
}

.play-mark {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 15rpx solid var(--line, #dce2df);
}

.file-playing {
  border-color: var(--line, #dce2df);
  background: var(--subtle, #eef1ef);
}

.play-action-active {
  background: var(--accent, #176b91);
}

.sound-wave {
  display: flex;
  align-items: center;
  height: 26rpx;
}

.wave-bar {
  width: 4rpx;
  margin: 0 3rpx;
  border-radius: 4rpx;
  background: var(--surface, #ffffff);
  animation: wave .8s ease-in-out infinite alternate;
}

.wave-first {
  height: 14rpx;
}

.wave-middle {
  height: 26rpx;
  animation-delay: .2s;
}

.wave-last {
  height: 18rpx;
  animation-delay: .4s;
}

.file-chevron {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin: 0 8rpx 0 24rpx;
  border-top: 3rpx solid var(--line, #dce2df);
  border-right: 3rpx solid var(--line, #dce2df);
  transform: rotate(45deg);
}

.files-removable .file-image {
  display: flex;
  flex-wrap: wrap;
}

.files-removable .image-wrap {
  width: 100%;
}

.files-removable .image-name {
  box-sizing: border-box;
  width: 100%;
}

.remove {
  flex-shrink: 0;
  padding: 16rpx 8rpx 16rpx 16rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--secondary, #536168);
  font-size: 24rpx;
  line-height: 1.5;
}

.remove::after {
  border: 0;
}

.remove[disabled] {
  background: transparent;
  color: var(--muted, #68767c);
}

.files-removable .file-image .remove {
  width: 100%;
  padding: 8rpx;
}

@keyframes wave {
  from { transform: scaleY(.45); }
  to { transform: scaleY(1); }
}
.playback-error { margin: 16rpx 0; padding: 16rpx 24rpx; border-radius: 16rpx; background: var(--subtle, #eef1ef); color: var(--danger, #b33740); font-size: 24rpx; line-height: 1.6; word-break: break-word; }
